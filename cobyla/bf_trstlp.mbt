            resmax = T::max(resmax, temp)
            k = k + 1
            cnt33 = cnt33 - 1
          }
        }
        k = nact
        pc2 = 9
        continue tb1~
      }
      9 => {
        zdotw = T::from_double(0.0)
        zdwabs = T::from_double(0.0)
        let mut cnt35 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt35 > 0 {
          temp = T::mul(z[z_off + ((i - 1) + n * (k - 1))], dxnew[dxnew_off + (i - 1)])
          zdotw = T::add(zdotw, temp)
          zdwabs = T::add(zdwabs, T::abs(temp))
          i = i + 1
          cnt35 = cnt35 - 1
        }
        acca = T::add(zdwabs, T::mul(T::from_double(0.1), T::abs(zdotw)))
        accb = T::add(zdwabs, T::mul(T::from_double(0.2), T::abs(zdotw)))
        if (T::ge(zdwabs, acca)) || (T::ge(acca, accb)) {
          zdotw = T::from_double(0.0)
        }
        vmultd[vmultd_off + (k - 1)] = T::div(zdotw, zdota[zdota_off + (k - 1)])
        if k >= 2 {
          kk = iact[k - 1]
          let mut cnt36 = i_max(0, (n - 1 + 1) / 1)
          i = 1
          while cnt36 > 0 {
            dxnew[dxnew_off + (i - 1)] = T::sub(dxnew[dxnew_off + (i - 1)], T::mul(vmultd[vmultd_off + (k - 1)], a[a_off + ((i - 1) + n * (kk - 1))]))
            i = i + 1
            cnt36 = cnt36 - 1
          }
          k = k - 1
          pc2 = 9
          continue tb1~
        }
        if mcon > m {
          vmultd[vmultd_off + (nact - 1)] = T::max(T::from_double(0.0), vmultd[vmultd_off + (nact - 1)])
        }
        let mut cnt37 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt37 > 0 {
          dxnew[dxnew_off + (i - 1)] = T::add(dx[dx_off + (i - 1)], T::mul(step_, sdirn[sdirn_off + (i - 1)]))
          i = i + 1
          cnt37 = cnt37 - 1
        }
        if mcon > nact {
          kl = nact + 1
          let mut cnt38 = i_max(0, (mcon - kl + 1) / 1)
          k = kl
          while cnt38 > 0 {
            kk = iact[k - 1]
            sum = T::sub(resmax, b[b_off + (kk - 1)])
            sumabs = T::add(resmax, T::abs(b[b_off + (kk - 1)]))
            let mut cnt39 = i_max(0, (n - 1 + 1) / 1)
            i = 1
            while cnt39 > 0 {
              temp = T::mul(a[a_off + ((i - 1) + n * (kk - 1))], dxnew[dxnew_off + (i - 1)])
              sum = T::add(sum, temp)
              sumabs = T::add(sumabs, T::abs(temp))
              i = i + 1
              cnt39 = cnt39 - 1
            }
            acca = T::add(sumabs, T::mul(T::from_double((Float::from_double(0.1)).to_double()), T::abs(sum)))
            accb = T::add(sumabs, T::mul(T::from_double((Float::from_double(0.2)).to_double()), T::abs(sum)))
            if (T::ge(sumabs, acca)) || (T::ge(acca, accb)) {
              sum = T::coerce_bigfloat(T::from_double((Float::from_double(0.0)).to_double()))
            }
            vmultd[vmultd_off + (k - 1)] = sum
            k = k + 1
            cnt38 = cnt38 - 1
          }
        }
        ratio = T::from_double(1.0)
        icon = 0
        let mut cnt40 = i_max(0, (mcon - 1 + 1) / 1)
        k = 1
        while cnt40 > 0 {
          if T::lt(vmultd[vmultd_off + (k - 1)], T::from_double(0.0)) {
            temp = T::div(vmultc[vmultc_off + (k - 1)], T::sub(vmultc[vmultc_off + (k - 1)], vmultd[vmultd_off + (k - 1)]))
            if T::lt(temp, ratio) {
              ratio = temp
              icon = k
            }
          }
          k = k + 1
          cnt40 = cnt40 - 1
        }
        temp = T::sub(T::from_double(1.0), ratio)
        let mut cnt41 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt41 > 0 {
          dx[dx_off + (i - 1)] = T::add(T::mul(temp, dx[dx_off + (i - 1)]), T::mul(ratio, dxnew[dxnew_off + (i - 1)]))
          i = i + 1
          cnt41 = cnt41 - 1
        }
        let mut cnt42 = i_max(0, (mcon - 1 + 1) / 1)
        k = 1
        while cnt42 > 0 {
          vmultc[vmultc_off + (k - 1)] = T::max(T::from_double(0.0), T::add(T::mul(temp, vmultc[vmultc_off + (k - 1)]), T::mul(ratio, vmultd[vmultd_off + (k - 1)])))
          k = k + 1
          cnt42 = cnt42 - 1
        }
        if mcon == m {
          resmax = T::add(resold, T::mul(ratio, T::sub(resmax, resold)))
        }
        if icon > 0 {
          pc2 = 2
          continue tb1~
        }
        if T::eq(step_, stpful) {
          pc2 = 12
          continue tb1~
        }
        pc2 = 10
        continue tb1~
      }
      10 => {
        mcon = m + 1
        icon = mcon
        iact[mcon - 1] = mcon
        vmultc[vmultc_off + (mcon - 1)] = T::from_double(0.0)
        pc2 = 1
        continue tb1~
        pc2 = 11
        continue tb1~
      }
      11 => {
        if mcon == m {
          pc2 = 10
          continue tb1~
        }
        ifull = 0
        pc2 = 12
        continue tb1~
      }
      12 => {
        return ifull
      }
      13 => {
        return ifull
      }
      _ => panic()
    }
  }
  panic()
}
