            acca = sumabs + (((Float::from_double(0.1)).to_double()) * (d_abs(sum)))
            accb = sumabs + (((Float::from_double(0.2)).to_double()) * (d_abs(sum)))
            if (sumabs >= acca) || (acca >= accb) {
              sum = (Float::from_double(0.0)).to_double()
            }
            vmultd[vmultd_off + (k - 1)] = sum
            k = k + 1
            cnt38 = cnt38 - 1
          }
        }
        ratio = 1.0
        icon = 0
        let mut cnt40 = i_max(0, (mcon - 1 + 1) / 1)
        k = 1
        while cnt40 > 0 {
          if vmultd[vmultd_off + (k - 1)] < 0.0 {
            temp = vmultc[vmultc_off + (k - 1)] / (vmultc[vmultc_off + (k - 1)] - vmultd[vmultd_off + (k - 1)])
            if temp < ratio {
              ratio = temp
              icon = k
            }
          }
          k = k + 1
          cnt40 = cnt40 - 1
        }
        temp = 1.0 - ratio
        let mut cnt41 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt41 > 0 {
          dx[dx_off + (i - 1)] = (temp * dx[dx_off + (i - 1)]) + (ratio * dxnew[dxnew_off + (i - 1)])
          i = i + 1
          cnt41 = cnt41 - 1
        }
        let mut cnt42 = i_max(0, (mcon - 1 + 1) / 1)
        k = 1
        while cnt42 > 0 {
          vmultc[vmultc_off + (k - 1)] = d_max(0.0, ((temp * vmultc[vmultc_off + (k - 1)]) + (ratio * vmultd[vmultd_off + (k - 1)])))
          k = k + 1
          cnt42 = cnt42 - 1
        }
        if mcon == m {
          resmax = resold + (ratio * (resmax - resold))
        }
        if icon > 0 {
          pc2 = 2
          continue tb1~
        }
        if step_ == stpful {
          pc2 = 12
          continue tb1~
        }
        pc2 = 10
        continue tb1~
      }
      10 => {
        mcon = m + 1
        icon = mcon
        iact[mcon - 1] = mcon
        vmultc[vmultc_off + (mcon - 1)] = 0.0
        pc2 = 1
        continue tb1~
        pc2 = 11
        continue tb1~
      }
      11 => {
        if mcon == m {
          pc2 = 10
          continue tb1~
        }
        ifull = 0
        pc2 = 12
        continue tb1~
      }
      12 => {
        return ifull
      }
      13 => {
        return ifull
      }
      _ => panic()
    }
  }
  panic()
}
