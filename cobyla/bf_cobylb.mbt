        if T::lt(parmu, T::mul(T::from_double(1.5), barmu)) {
          parmu = T::mul(T::from_double(2.0), barmu)
          if iprint >= 2 {
            let fa50 : Array[FArg] = []
            let fv51 = parmu
            fa50.push(AFn(fn(d) { T::format_directive(fv51, d) }))
            fformat(-1, [Lit("~%"), Lit("~3@T"), Lit("Increase in PARMU to"), Rep(1, [Dir("~13,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~%")], fa50)
          }
          phi = T::add(datmat[datmat_off + ((mp - 1) + mpp * (np - 1))], T::mul(parmu, datmat[datmat_off + ((mpp - 1) + mpp * (np - 1))]))
          let mut cnt52 = i_max(0, (n - 1 + 1) / 1)
          j = 1
          while cnt52 > 0 {
            temp = T::add(datmat[datmat_off + ((mp - 1) + mpp * (j - 1))], T::mul(parmu, datmat[datmat_off + ((mpp - 1) + mpp * (j - 1))]))
            if T::lt(temp, phi) {
              pc2 = 3
              continue tb1~
            }
            if (T::eq(temp, phi)) && (T::eq(parmu, T::from_double((Float::from_double(0.0)).to_double()))) {
              if T::lt(datmat[datmat_off + ((mpp - 1) + mpp * (j - 1))], datmat[datmat_off + ((mpp - 1) + mpp * (np - 1))]) {
                pc2 = 3
                continue tb1~
              }
            }
            j = j + 1
            cnt52 = cnt52 - 1
          }
        }
        prerem = T::sub(T::mul(parmu, prerec), sum)
        let mut cnt53 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt53 > 0 {
          x[i - 1] = T::add(sim[sim_off + ((i - 1) + n * (np - 1))], dx[dx_off + (i - 1)])
          i = i + 1
          cnt53 = cnt53 - 1
        }
        ibrnch = 1
        pc2 = 1
        continue tb1~
      }
      5 => {
        vmold = T::add(datmat[datmat_off + ((mp - 1) + mpp * (np - 1))], T::mul(parmu, datmat[datmat_off + ((mpp - 1) + mpp * (np - 1))]))
        vmnew = T::add(f, T::mul(parmu, resmax))
        trured = T::sub(vmold, vmnew)
        if (T::eq(parmu, T::from_double(0.0))) && (T::eq(f, datmat[datmat_off + ((mp - 1) + mpp * (np - 1))])) {
          prerem = prerec
          trured = T::sub(datmat[datmat_off + ((mpp - 1) + mpp * (np - 1))], resmax)
        }
        ratio = T::from_double(0.0)
        if T::le(trured, T::from_double((Float::from_double(0.0)).to_double())) {
          ratio = T::coerce_bigfloat(T::from_double((Float::from_double(1.0)).to_double()))
        }
        jdrop = 0
        let mut cnt54 = i_max(0, (n - 1 + 1) / 1)
        j = 1
        while cnt54 > 0 {
          temp = T::from_double(0.0)
          let mut cnt55 = i_max(0, (n - 1 + 1) / 1)
          i = 1
          while cnt55 > 0 {
            temp = T::add(temp, T::mul(simi[simi_off + ((j - 1) + n * (i - 1))], dx[dx_off + (i - 1)]))
            i = i + 1
            cnt55 = cnt55 - 1
          }
          temp = T::abs(temp)
          if T::gt(temp, ratio) {
            jdrop = j
            ratio = temp
          }
          sigbar[sigbar_off + (j - 1)] = T::mul(temp, vsig[vsig_off + (j - 1)])
          j = j + 1
          cnt54 = cnt54 - 1
        }
        edgmax = T::mul(delta, rho)
        l = 0
        let mut cnt56 = i_max(0, (n - 1 + 1) / 1)
        j = 1
        while cnt56 > 0 {
          if (T::ge(sigbar[sigbar_off + (j - 1)], parsig)) || (T::ge(sigbar[sigbar_off + (j - 1)], vsig[vsig_off + (j - 1)])) {
            temp = veta[veta_off + (j - 1)]
            if T::gt(trured, T::from_double(0.0)) {
              temp = T::from_double(0.0)
              let mut cnt57 = i_max(0, (n - 1 + 1) / 1)
              i = 1
              while cnt57 > 0 {
                temp = T::add(temp, T::expt(T::sub(dx[dx_off + (i - 1)], sim[sim_off + ((i - 1) + n * (j - 1))]), T::from_int(2)))
                i = i + 1
                cnt57 = cnt57 - 1
              }
              temp = T::sqrt(temp)
            }
            if T::gt(temp, edgmax) {
              l = j
              edgmax = temp
            }
          }
          j = j + 1
          cnt56 = cnt56 - 1
        }
        if l > 0 {
          jdrop = l
        }
        if jdrop == 0 {
          pc2 = 6
          continue tb1~
        }
        temp = T::from_double(0.0)
        let mut cnt58 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt58 > 0 {
          sim[sim_off + ((i - 1) + n * (jdrop - 1))] = dx[dx_off + (i - 1)]
          temp = T::add(temp, T::mul(simi[simi_off + ((jdrop - 1) + n * (i - 1))], dx[dx_off + (i - 1)]))
          i = i + 1
          cnt58 = cnt58 - 1
        }
        let mut cnt59 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt59 > 0 {
          simi[simi_off + ((jdrop - 1) + n * (i - 1))] = T::div(simi[simi_off + ((jdrop - 1) + n * (i - 1))], temp)
          i = i + 1
          cnt59 = cnt59 - 1
        }
        let mut cnt60 = i_max(0, (n - 1 + 1) / 1)
        j = 1
        while cnt60 > 0 {
          if j != jdrop {
            temp = T::from_double(0.0)
            let mut cnt61 = i_max(0, (n - 1 + 1) / 1)
            i = 1
            while cnt61 > 0 {
              temp = T::add(temp, T::mul(simi[simi_off + ((j - 1) + n * (i - 1))], dx[dx_off + (i - 1)]))
              i = i + 1
              cnt61 = cnt61 - 1
            }
            let mut cnt62 = i_max(0, (n - 1 + 1) / 1)
            i = 1
            while cnt62 > 0 {
              simi[simi_off + ((j - 1) + n * (i - 1))] = T::sub(simi[simi_off + ((j - 1) + n * (i - 1))], T::mul(temp, simi[simi_off + ((jdrop - 1) + n * (i - 1))]))
              i = i + 1
              cnt62 = cnt62 - 1
            }
          }
          j = j + 1
          cnt60 = cnt60 - 1
        }
        let mut cnt63 = i_max(0, (mpp - 1 + 1) / 1)
        k = 1
        while cnt63 > 0 {
          datmat[datmat_off + ((k - 1) + mpp * (jdrop - 1))] = con[con_off + (k - 1)]
          k = k + 1
          cnt63 = cnt63 - 1
        }
        if (T::gt(trured, T::from_double(0.0))) && (T::ge(trured, T::mul(T::from_double(0.1), prerem))) {
          pc2 = 3
          continue tb1~
        }
        pc2 = 6
        continue tb1~
      }
      6 => {
        if iflag == 0 {
          ibrnch = 0
          pc2 = 3
          continue tb1~
        }
        if T::gt(rho, rhoend) {
          rho = T::mul(T::from_double(0.5), rho)
          if T::le(rho, T::mul(T::from_double(1.5), rhoend)) {
            rho = rhoend
          }
          if T::gt(parmu, T::from_double(0.0)) {
            denom = T::from_double(0.0)
            let mut cnt64 = i_max(0, (mp - 1 + 1) / 1)
            k = 1
            while cnt64 > 0 {
              cmin = datmat[datmat_off + ((k - 1) + mpp * (np - 1))]
              cmax = cmin
              let mut cnt65 = i_max(0, (n - 1 + 1) / 1)
              i = 1
              while cnt65 > 0 {
                cmin = T::min(cmin, datmat[datmat_off + ((k - 1) + mpp * (i - 1))])
                cmax = T::max(cmax, datmat[datmat_off + ((k - 1) + mpp * (i - 1))])
                i = i + 1
                cnt65 = cnt65 - 1
              }
              if (k <= m) && (T::lt(cmin, T::mul(T::from_double(0.5), cmax))) {
                temp = T::sub(T::max(cmax, T::from_double(0.0)), cmin)
                if T::le(denom, T::from_double(0.0)) {
                  denom = temp
                } else {
                  denom = T::min(denom, temp)
                }
              }
              k = k + 1
              cnt64 = cnt64 - 1
            }
            if T::eq(denom, T::from_double(0.0)) {
              parmu = T::from_double(0.0)
            } else if T::lt(T::add(cmax, T::neg(cmin)), T::mul(parmu, denom)) {
              parmu = T::div(T::sub(cmax, cmin), denom)
            }
          }
          if iprint >= 2 {
            let fa66 : Array[FArg] = []
            let fv67 = rho
            fa66.push(AFn(fn(d) { T::format_directive(fv67, d) }))
            let fv68 = parmu
            fa66.push(AFn(fn(d) { T::format_directive(fv68, d) }))
            fformat(-1, [Lit("~%"), Lit("~3@T"), Lit("Reduction in RHO to"), Rep(1, [Dir("~13,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("  and PARMU ="), Rep(1, [Dir("~13,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~%")], fa66)
          }
          if iprint == 2 {
            let fa69 : Array[FArg] = []
            fa69.push(AI(nfvals))
            let fv70 = datmat[datmat_off + ((mp - 1) + mpp * (np - 1))]
            fa69.push(AFn(fn(d) { T::format_directive(fv70, d) }))
            let fv71 = datmat[datmat_off + ((mpp - 1) + mpp * (np - 1))]
            fa69.push(AFn(fn(d) { T::format_directive(fv71, d) }))
            let mut di72 = 1
            while di72 <= iptem {
            let fv73 = sim[sim_off + ((di72 - 1) + n * (np - 1))]
              fa69.push(AFn(fn(d) { T::format_directive(fv73, d) }))
              di72 = di72 + 1
            }
            fformat(-1, [Lit("~%"), Lit("~3@T"), Lit("NFVALS ="), Rep(1, [Dir("~5D")]), Lit("~3@T"), Lit("F ="), Rep(1, [Dir("~13,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~4@T"), Lit("MAXCV ="), Rep(1, [Dir("~13,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~%"), Lit("~3@T"), Lit("X ="), Rep(1, [Dir("~13,6,2,1,'*,,'E/bigfloat:format-e/")]), Rep(4, [Dir("~15,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~%")], fa69)
            if iptem < n {
              let fa74 : Array[FArg] = []
              let mut di75 = iptemp
              while di75 <= n {
              let fv76 = x[di75 - 1]
                fa74.push(AFn(fn(d) { T::format_directive(fv76, d) }))
                di75 = di75 + 1
              }
              fformat(-1, [Rep(1, [Dir("~19,6,2,1,'*,,'E/bigfloat:format-e/")]), Rep(4, [Dir("~15,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~%")], fa74)
            }
          }
          pc2 = 3
          continue tb1~
        }
        if iprint >= 1 {
          let fa77 : Array[FArg] = []
          fformat(-1, [Lit("~%"), Lit("~3@T"), Lit("Normal return from subroutine COBYLA"), Lit("~%")], fa77)
        }
        if ifull == 1 {
          pc2 = 8
          continue tb1~
        }
        pc2 = 7
        continue tb1~
      }
      7 => {
        let mut cnt78 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt78 > 0 {
          x[i - 1] = sim[sim_off + ((i - 1) + n * (np - 1))]
          i = i + 1
          cnt78 = cnt78 - 1
        }
        f = datmat[datmat_off + ((mp - 1) + mpp * (np - 1))]
        resmax = datmat[datmat_off + ((mpp - 1) + mpp * (np - 1))]
        pc2 = 8
        continue tb1~
      }
      8 => {
        if iprint >= 1 {
          let fa79 : Array[FArg] = []
          fa79.push(AI(nfvals))
          let fv80 = f
          fa79.push(AFn(fn(d) { T::format_directive(fv80, d) }))
          let fv81 = resmax
          fa79.push(AFn(fn(d) { T::format_directive(fv81, d) }))
          let mut di82 = 1
          while di82 <= iptem {
          let fv83 = x[di82 - 1]
            fa79.push(AFn(fn(d) { T::format_directive(fv83, d) }))
            di82 = di82 + 1
          }
          fformat(-1, [Lit("~%"), Lit("~3@T"), Lit("NFVALS ="), Rep(1, [Dir("~5D")]), Lit("~3@T"), Lit("F ="), Rep(1, [Dir("~13,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~4@T"), Lit("MAXCV ="), Rep(1, [Dir("~13,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~%"), Lit("~3@T"), Lit("X ="), Rep(1, [Dir("~13,6,2,1,'*,,'E/bigfloat:format-e/")]), Rep(4, [Dir("~15,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~%")], fa79)
          if iptem < n {
            let fa84 : Array[FArg] = []
            let mut di85 = iptemp
            while di85 <= n {
            let fv86 = x[di85 - 1]
              fa84.push(AFn(fn(d) { T::format_directive(fv86, d) }))
              di85 = di85 + 1
            }
            fformat(-1, [Rep(1, [Dir("~19,6,2,1,'*,,'E/bigfloat:format-e/")]), Rep(4, [Dir("~15,6,2,1,'*,,'E/bigfloat:format-e/")]), Lit("~%")], fa84)
          }
        }
        maxfun = nfvals
        return (maxfun, ierr)
      }
      9 => {
        return (maxfun, ierr)
      }
      _ => panic()
    }
  }
  panic()
}
