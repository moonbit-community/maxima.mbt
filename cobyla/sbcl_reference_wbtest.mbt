///|
test "sbcl reference 24: cobyla rosen-suzuki rhobeg=0.5 rhoend=1e-06 iprint=1 maxfun=12" {
  let r = ref_case(s => {
    t_cobyla(s, "rosen-suzuki", 3, [1.0, 1.0, 1.0, 1.0], 0.5, 1.0e-06, 1, 12)
  })
  assert_eq(r, " i12 i1 i12 | d4597650353429521836 d4607051479973112654 d4612767712933114090 d-4630177337832596396 |h140:5465954273955539531 | i3 i4 i1 i2 s\"\\n   Return from subroutine COBYLA because the MAXFUN limit has been reached.\\n\\n   NFVALS =   12   F =-4.567585E+01    MAXCV = 1.838006E+00\\n   X = 2.354320E-01   9.854629E-01   2.480369E+00  -1.183814E-01\\n\"")
}

