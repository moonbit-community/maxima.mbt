// Generated by tools/f2cl2mbt.py --lib=cobyla --reference-test; do not edit.
// Differential test against the f2cl Lisp of Maxima's share/cobyla/lisp run under
// SBCL 2.6.9: each case runs the same calls in Lisp and in MoonBit and
// renders every result as IEEE bit patterns, plus the text printed on
// Fortran unit 6.

///|
fn rd(s : StringBuilder, x : Double) -> Unit {
  s.write_string(" d" + x.reinterpret_as_int64().to_string())
}

///|
fn ri(s : StringBuilder, n : Int) -> Unit {
  s.write_string(" i" + n.to_string())
}

///|
fn rb(s : StringBuilder, b : Bool) -> Unit {
  s.write_string(if b { " bT" } else { " bF" })
}

///|
fn rc(s : StringBuilder, z : Complex) -> Unit {
  s.write_string(
    " c" + z.re.reinterpret_as_int64().to_string() + "," +
    z.im.reinterpret_as_int64().to_string(),
  )
}

///|
fn mix(h : UInt64, w : Int64) -> UInt64 {
  (h ^ w.reinterpret_as_uint64()) * 1099511628211UL
}

///|
/// Arrays of more than 64 elements are rendered as an FNV-1a hash of their
/// bit patterns.
fn rhash(s : StringBuilder, n : Int, h : UInt64) -> Unit {
  s.write_string(" |h" + n.to_string() + ":" + h.to_string())
}

///|
fn rad(s : StringBuilder, a : FixedArray[Double]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(h, x.reinterpret_as_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    rd(s, x)
  }
}

///|
fn rai(s : StringBuilder, a : FixedArray[Int]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(h, x.to_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    ri(s, x)
  }
}

///|
fn rac(s : StringBuilder, a : FixedArray[Complex]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(mix(h, x.re.reinterpret_as_int64()), x.im.reinterpret_as_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    rc(s, x)
  }
}

///|
fn quote_text(t : String) -> String {
  let sb = StringBuilder()
  for c in t {
    match c {
      '\n' => sb.write_string("\\n")
      '"' => sb.write_string("\\\"")
      '\\' => sb.write_string("\\\\")
      _ => sb.write_char(c)
    }
  }
  sb.to_string()
}

///|
/// Run `body`, capturing what the routines print.
fn ref_case(body : (StringBuilder) -> Unit raise) -> String raise {
  let s = StringBuilder()
  let text = StringBuilder()
  let saved = @f2cl.output_hook.val
  @f2cl.output_hook.val = t => text.write_string(t)
  body(s) catch {
    e => {
      @f2cl.output_hook.val = saved
      raise e
    }
  }
  @f2cl.output_hook.val = saved
  s.write_string(" s\"" + quote_text(text.to_string()) + "\"")
  s.to_string()
}

///|
fn dvec(xs : Array[Double]) -> FixedArray[Double] {
  FixedArray::from_array(xs)
}

///|
fn cvec(xs : Array[(Double, Double)]) -> FixedArray[Complex] {
  FixedArray::from_array(xs.map(p => cplx(p.0, p.1)))
}


///|
fn prob_fc(p : String, x : FixedArray[Double], c : FixedArray[Double], co : Int) -> Double {
  match p {
    "quad" => 10.0 * ((x[0] + 1.0) * (x[0] + 1.0)) + x[1] * x[1]
    "circle" => {
      c[co + 0] = 1.0 - x[0] * x[0] - x[1] * x[1]
      x[0] * x[1]
    }
    "ellipsoid" => {
      c[co + 0] = 1.0 - x[0] * x[0] - 2.0 * (x[1] * x[1]) - 3.0 * (x[2] * x[2])
      x[0] * x[1] * x[2]
    }
    "parab" => {
      c[co + 0] = x[1] - x[0] * x[0]
      c[co + 1] = 1.0 - x[0] * x[0] - x[1] * x[1]
      -x[0] - x[1]
    }
    "rosen-suzuki" => {
      let x1 = x[0]
      let x2 = x[1]
      let x3 = x[2]
      let x4 = x[3]
      c[co + 0] = 8.0 - x1 * x1 - x2 * x2 - x3 * x3 - x4 * x4 - x1 + x2 - x3 + x4
      c[co + 1] = 10.0 - x1 * x1 - 2.0 * (x2 * x2) - x3 * x3 - 2.0 * (x4 * x4) + x1 + x4
      c[co + 2] = 5.0 - 2.0 * (x1 * x1) - x2 * x2 - x3 * x3 - 2.0 * x1 + x2 + x4
      x1 * x1 + x2 * x2 + 2.0 * (x3 * x3) + x4 * x4 - 5.0 * x1 - 5.0 * x2 - 21.0 * x3 +
      7.0 * x4
    }
    _ => abort(p)
  }
}

///|
let calls : Ref[Int] = { val: 0 }

///|
fn t_cobyla(
  s : StringBuilder,
  p : String,
  m : Int,
  x0 : Array[Double],
  rhobeg : Double,
  rhoend : Double,
  iprint : Int,
  maxfun : Int,
) -> Unit raise {
  let n = x0.length()
  let x = dvec(x0)
  let w = FixedArray::make(n * (3 * n + 2 * m + 11) + 4 * m + 6 + 6, 0.0)
  let iact = FixedArray::make(m + 1, 0)
  calls.val = 0
  calcfc_hook.val = fn(_n, _m, x, _f, con, co) {
    calls.val = calls.val + 1
    prob_fc(p, x, con, co)
  }
  let (r0, r1) = cobyla(n, m, x, rhobeg, rhoend, iprint, maxfun, w, iact, 0)
  ri(s, r0)
  ri(s, r1)
  ri(s, calls.val)
  rad(s, x)
  rad(s, w)
  rai(s, iact)
}

///|
test "sbcl reference 0: cobyla quad rhobeg=0.5 rhoend=1e-06 iprint=0 maxfun=2000" {
