        while cnt48 > 0 {
          temp = 0.0
          let mut cnt49 = i_max(0, (n - 1 + 1) / 1)
          i = 1
          while cnt49 > 0 {
            temp = temp + (simi[simi_off + ((j - 1) + n * (i - 1))] * dx[dx_off + (i - 1)])
            i = i + 1
            cnt49 = cnt49 - 1
          }
          temp = d_abs(temp)
          if temp > ratio {
            jdrop = j
            ratio = temp
          }
          sigbar[sigbar_off + (j - 1)] = temp * vsig[vsig_off + (j - 1)]
          j = j + 1
          cnt48 = cnt48 - 1
        }
        edgmax = delta * rho
        l = 0
        let mut cnt50 = i_max(0, (n - 1 + 1) / 1)
        j = 1
        while cnt50 > 0 {
          if (sigbar[sigbar_off + (j - 1)] >= parsig) || (sigbar[sigbar_off + (j - 1)] >= vsig[vsig_off + (j - 1)]) {
            temp = veta[veta_off + (j - 1)]
            if trured > 0.0 {
              temp = 0.0
              let mut cnt51 = i_max(0, (n - 1 + 1) / 1)
              i = 1
              while cnt51 > 0 {
                temp = temp + (d_sq(dx[dx_off + (i - 1)] - sim[sim_off + ((i - 1) + n * (j - 1))]))
                i = i + 1
                cnt51 = cnt51 - 1
              }
              temp = f_sqrt(temp)
            }
            if temp > edgmax {
              l = j
              edgmax = temp
            }
          }
          j = j + 1
          cnt50 = cnt50 - 1
        }
        if l > 0 {
          jdrop = l
        }
        if jdrop == 0 {
          pc2 = 6
          continue tb1~
        }
        temp = 0.0
        let mut cnt52 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt52 > 0 {
          sim[sim_off + ((i - 1) + n * (jdrop - 1))] = dx[dx_off + (i - 1)]
          temp = temp + (simi[simi_off + ((jdrop - 1) + n * (i - 1))] * dx[dx_off + (i - 1)])
          i = i + 1
          cnt52 = cnt52 - 1
        }
        let mut cnt53 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt53 > 0 {
          simi[simi_off + ((jdrop - 1) + n * (i - 1))] = simi[simi_off + ((jdrop - 1) + n * (i - 1))] / temp
          i = i + 1
          cnt53 = cnt53 - 1
        }
        let mut cnt54 = i_max(0, (n - 1 + 1) / 1)
        j = 1
        while cnt54 > 0 {
          if j != jdrop {
            temp = 0.0
            let mut cnt55 = i_max(0, (n - 1 + 1) / 1)
            i = 1
            while cnt55 > 0 {
              temp = temp + (simi[simi_off + ((j - 1) + n * (i - 1))] * dx[dx_off + (i - 1)])
              i = i + 1
              cnt55 = cnt55 - 1
            }
            let mut cnt56 = i_max(0, (n - 1 + 1) / 1)
            i = 1
            while cnt56 > 0 {
              simi[simi_off + ((j - 1) + n * (i - 1))] = simi[simi_off + ((j - 1) + n * (i - 1))] - (temp * simi[simi_off + ((jdrop - 1) + n * (i - 1))])
              i = i + 1
              cnt56 = cnt56 - 1
            }
          }
          j = j + 1
          cnt54 = cnt54 - 1
        }
        let mut cnt57 = i_max(0, (mpp - 1 + 1) / 1)
        k = 1
        while cnt57 > 0 {
          datmat[datmat_off + ((k - 1) + mpp * (jdrop - 1))] = con[con_off + (k - 1)]
          k = k + 1
          cnt57 = cnt57 - 1
        }
        if (trured > 0.0) && (trured >= (0.1 * prerem)) {
          pc2 = 3
          continue tb1~
        }
        pc2 = 6
        continue tb1~
      }
      6 => {
        if iflag == 0 {
          ibrnch = 0
          pc2 = 3
          continue tb1~
        }
        if rho > rhoend {
          rho = 0.5 * rho
          if rho <= (1.5 * rhoend) {
            rho = rhoend
          }
          if parmu > 0.0 {
            denom = 0.0
            let mut cnt58 = i_max(0, (mp - 1 + 1) / 1)
            k = 1
            while cnt58 > 0 {
              cmin = datmat[datmat_off + ((k - 1) + mpp * (np - 1))]
              cmax = cmin
              let mut cnt59 = i_max(0, (n - 1 + 1) / 1)
              i = 1
              while cnt59 > 0 {
                cmin = d_min(cmin, datmat[datmat_off + ((k - 1) + mpp * (i - 1))])
                cmax = d_max(cmax, datmat[datmat_off + ((k - 1) + mpp * (i - 1))])
                i = i + 1
                cnt59 = cnt59 - 1
              }
              if (k <= m) && (cmin < (0.5 * cmax)) {
                temp = (d_max(cmax, 0.0)) - cmin
                if denom <= 0.0 {
                  denom = temp
                } else {
                  denom = d_min(denom, temp)
                }
              }
              k = k + 1
              cnt58 = cnt58 - 1
            }
            if denom == 0.0 {
              parmu = 0.0
            } else if (cmax + (-cmin)) < (parmu * denom) {
              parmu = (cmax - cmin) / denom
            }
          }
          if iprint >= 2 {
            let fa60 : Array[FArg] = []
            fa60.push(AD(rho))
            fa60.push(AD(parmu))
            fformat(-1, [Lit("~%"), Lit("~3@T"), Lit("Reduction in RHO to"), Rep(1, [Dir("~13,6,2,1,'*,,'EE")]), Lit("  and PARMU ="), Rep(1, [Dir("~13,6,2,1,'*,,'EE")]), Lit("~%")], fa60)
          }
          if iprint == 2 {
            let fa61 : Array[FArg] = []
            fa61.push(AI(nfvals))
            fa61.push(AD(datmat[datmat_off + ((mp - 1) + mpp * (np - 1))]))
            fa61.push(AD(datmat[datmat_off + ((mpp - 1) + mpp * (np - 1))]))
            let mut di62 = 1
            while di62 <= iptem {
              fa61.push(AD(sim[sim_off + ((di62 - 1) + n * (np - 1))]))
              di62 = di62 + 1
            }
            fformat(-1, [Lit("~%"), Lit("~3@T"), Lit("NFVALS ="), Rep(1, [Dir("~5D")]), Lit("~3@T"), Lit("F ="), Rep(1, [Dir("~13,6,2,1,'*,,'EE")]), Lit("~4@T"), Lit("MAXCV ="), Rep(1, [Dir("~13,6,2,1,'*,,'EE")]), Lit("~%"), Lit("~3@T"), Lit("X ="), Rep(1, [Dir("~13,6,2,1,'*,,'EE")]), Rep(4, [Dir("~15,6,2,1,'*,,'EE")]), Lit("~%")], fa61)
            if iptem < n {
              let fa63 : Array[FArg] = []
              let mut di64 = iptemp
              while di64 <= n {
                fa63.push(AD(x[di64 - 1]))
                di64 = di64 + 1
              }
              fformat(-1, [Rep(1, [Dir("~19,6,2,1,'*,,'EE")]), Rep(4, [Dir("~15,6,2,1,'*,,'EE")]), Lit("~%")], fa63)
            }
          }
          pc2 = 3
          continue tb1~
        }
        if iprint >= 1 {
          let fa65 : Array[FArg] = []
          fformat(-1, [Lit("~%"), Lit("~3@T"), Lit("Normal return from subroutine COBYLA"), Lit("~%")], fa65)
        }
        if ifull == 1 {
          pc2 = 8
          continue tb1~
        }
        pc2 = 7
        continue tb1~
      }
      7 => {
        let mut cnt66 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt66 > 0 {
          x[i - 1] = sim[sim_off + ((i - 1) + n * (np - 1))]
          i = i + 1
          cnt66 = cnt66 - 1
        }
        f = datmat[datmat_off + ((mp - 1) + mpp * (np - 1))]
        resmax = datmat[datmat_off + ((mpp - 1) + mpp * (np - 1))]
        pc2 = 8
        continue tb1~
      }
      8 => {
        if iprint >= 1 {
          let fa67 : Array[FArg] = []
          fa67.push(AI(nfvals))
          fa67.push(AD(f))
          fa67.push(AD(resmax))
          let mut di68 = 1
          while di68 <= iptem {
            fa67.push(AD(x[di68 - 1]))
            di68 = di68 + 1
          }
          fformat(-1, [Lit("~%"), Lit("~3@T"), Lit("NFVALS ="), Rep(1, [Dir("~5D")]), Lit("~3@T"), Lit("F ="), Rep(1, [Dir("~13,6,2,1,'*,,'EE")]), Lit("~4@T"), Lit("MAXCV ="), Rep(1, [Dir("~13,6,2,1,'*,,'EE")]), Lit("~%"), Lit("~3@T"), Lit("X ="), Rep(1, [Dir("~13,6,2,1,'*,,'EE")]), Rep(4, [Dir("~15,6,2,1,'*,,'EE")]), Lit("~%")], fa67)
          if iptem < n {
            let fa69 : Array[FArg] = []
            let mut di70 = iptemp
            while di70 <= n {
              fa69.push(AD(x[di70 - 1]))
              di70 = di70 + 1
            }
            fformat(-1, [Rep(1, [Dir("~19,6,2,1,'*,,'EE")]), Rep(4, [Dir("~15,6,2,1,'*,,'EE")]), Lit("~%")], fa69)
          }
        }
        maxfun = nfvals
        return (maxfun, ierr)
      }
      9 => {
        return (maxfun, ierr)
      }
      _ => panic()
    }
  }
  panic()
}
