                          continue tb4~
                        }
                        break tb12~
                      }
                      _ => panic()
                    }
                  }
                  lr = lr + 2
                  cnt11 = cnt11 - 1
                }
                pc5 = 8
                continue tb4~
              }
              8 => {
                tb = wk[5 - 1]
                if wk[1 - 1] > 0.0 {
                  tb = -tb
                }
                bsum = bsum / tb
                pc5 = 9
                continue tb4~
              }
              9 => {
                let (mv17, mv18, mv19, mv20) = funjy(wk[6 - 1], wk[5 - 1], wk[4 - 1], fi, dfi)
                wk[5 - 1] = mv17
                wk[4 - 1] = mv18
                fi = mv19
                dfi = mv20
                ta = 1.0 / tol
                tb = ((d1mach(1)) * ta) * 1000.0
                if (d_abs(fi)) > tb {
                  pc5 = 10
                  continue tb4~
                }
                fi = fi * ta
                dfi = dfi * ta
                phi = phi * tol
                pc5 = 10
                continue tb4~
              }
              10 => {
                y[y_off + (jn - 1)] = ((flgjy * phi) * ((fi * asum) + (dfi * bsum))) / wk[7 - 1]
                fn_ = fn_ - flgjy
                break tb4~
              }
              _ => panic()
            }
          }
          jn = jn + 1
          cnt3 = cnt3 - 1
        }
        return iflw
      }
      3 => {
        return iflw
      }
      _ => panic()
    }
  }
  panic()
}
