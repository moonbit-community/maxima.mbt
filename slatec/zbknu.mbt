            cki = cki + rzi
            p2r = s2r * p1r
            p2i = s2i * p1r
            yr[i - 1] = p2r
            yi[i - 1] = p2i
            if kflag >= 3 {
              break tb54~
            }
            str = d_abs(p2r)
            sti = d_abs(p2i)
            p2m = d_max(str, sti)
            if p2m <= ascle {
              break tb54~
            }
            kflag = kflag + 1
            ascle = bry[kflag - 1]
            s1r = s1r * p1r
            s1i = s1i * p1r
            s2r = p2r
            s2i = p2i
            str = cssr[kflag - 1]
            s1r = s1r * str
            s1i = s1i * str
            s2r = s2r * str
            s2i = s2i * str
            p1r = csrr[kflag - 1]
            break tb54~
          }
          i = i + 1
          cnt53 = cnt53 - 1
        }
        return nz
      }
      24 => {
        helim = 0.5 * elim
        elm = f_exp(-elim)
        celmr = elm
        ascle = bry[1 - 1]
        zdr = zr
        zdi = zi
        ic = -1
        j = 2
        let mut cnt55 = i_max(0, (inu - 1 + 1) / 1)
        i = 1
        while cnt55 > 0 {
          let mut pc57 = 0
          tb56~: while true {
            match pc57 {
              0 => {
                str = s2r
                sti = s2i
                s2r = ((str * ckr) - (sti * cki)) + s1r
                s2i = ((sti * ckr) + (str * cki)) + s1i
                s1r = str
                s1i = sti
                ckr = ckr + rzr
                cki = cki + rzi
                as_ = zabs(s2r, s2i)
                alas = f_log(as_)
                p2r = alas - zdr
                if p2r < (-elim) {
                  pc57 = 1
                  continue tb56~
                }
                let (mv58, mv59, mv60) = zlog(s2r, s2i, str, sti, idum)
                str = mv58
                sti = mv59
                idum = mv60
                p2r = str - zdr
                p2i = sti - zdi
                p2m = (f_exp(p2r)) / tol
                p1r = p2m * (f_cos(p2i))
                p1i = p2m * (f_sin(p2i))
                let mv61 = zuchk(p1r, p1i, nw, ascle, tol)
                nw = mv61
                if nw != 0 {
                  pc57 = 1
                  continue tb56~
                }
                j = 3 - j
                cyr[j - 1] = p1r
                cyi[j - 1] = p1i
                if ic == (i - 1) {
                  pc2 = 25
                  continue tb1~
                }
                ic = i
                break tb56~
              }
              1 => {
                if alas < helim {
                  break tb56~
                }
                zdr = zdr - elim
                s1r = s1r * celmr
                s1i = s1i * celmr
                s2r = s2r * celmr
                s2i = s2i * celmr
                break tb56~
              }
              _ => panic()
            }
          }
          i = i + 1
          cnt55 = cnt55 - 1
        }
        if n != 1 {
          pc2 = 26
          continue tb1~
        }
        s1r = s2r
        s1i = s2i
        pc2 = 26
        continue tb1~
      }
      25 => {
        kflag = 1
        inub = i + 1
        s2r = cyr[j - 1]
        s2i = cyi[j - 1]
        j = 3 - j
        s1r = cyr[j - 1]
        s1i = cyi[j - 1]
        if inub <= inu {
          pc2 = 21
          continue tb1~
        }
        if n != 1 {
          pc2 = 22
          continue tb1~
        }
        s1r = s2r
        s1i = s2i
        pc2 = 22
        continue tb1~
      }
      26 => {
        yr[1 - 1] = s1r
        yi[1 - 1] = s1i
        if n == 1 {
          pc2 = 27
          continue tb1~
        }
        yr[2 - 1] = s2r
        yi[2 - 1] = s2i
        pc2 = 27
        continue tb1~
      }
      27 => {
        ascle = bry[1 - 1]
        let mv62 = zkscl(zdr, zdi, fnu, n, yr, yi, nz, rzr, rzi, ascle, tol, elim)
        nz = mv62
        inu = n - nz
        if inu <= 0 {
          return nz
        }
        kk = nz + 1
        s1r = yr[kk - 1]
        s1i = yi[kk - 1]
        yr[kk - 1] = s1r * csrr[1 - 1]
        yi[kk - 1] = s1i * csrr[1 - 1]
        if inu == 1 {
          return nz
        }
        kk = nz + 2
        s2r = yr[kk - 1]
        s2i = yi[kk - 1]
        yr[kk - 1] = s2r * csrr[1 - 1]
        yi[kk - 1] = s2i * csrr[1 - 1]
        if inu == 2 {
          return nz
        }
        t2 = fnu + ((kk - 1).to_double())
        ckr = t2 * rzr
        cki = t2 * rzi
        kflag = 1
        pc2 = 23
        continue tb1~
      }
      28 => {
        koded = 2
        iflag = 1
        kflag = 2
        pc2 = 11
        continue tb1~
      }
      29 => {
        s1r = coefr
        s1i = coefi
        s2r = coefr
        s2i = coefi
        pc2 = 18
        continue tb1~
      }
      30 => {
        nz = -2
        return nz
      }
      31 => {
        return nz
      }
      _ => panic()
    }
  }
  panic()
}
