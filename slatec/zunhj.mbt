        phii = 0.0
        argr = 1.0
        argi = 0.0
        return (phir, phii, argr, argi, zeta1r, zeta1i, zeta2r, zeta2i, asumr, asumi, bsumr, bsumi)
      }
      1 => {
        zbr = zr * rfnu
        zbi = zi * rfnu
        rfnu2 = rfnu * rfnu
        fn13 = f_pow(fnu, zunhj_ex1)
        fn23 = fn13 * fn13
        rfn13 = 1.0 / fn13
        w2r = (zunhj_coner - (zbr * zbr)) + (zbi * zbi)
        w2i = (zunhj_conei - (zbr * zbi)) - (zbr * zbi)
        aw2 = zabs(w2r, w2i)
        if aw2 > 0.25 {
          pc2 = 5
          continue tb1~
        }
        k = 1
        pr[1 - 1] = zunhj_coner
        pi_[1 - 1] = zunhj_conei
        sumar = zunhj_gama[1 - 1]
        sumai = zunhj_zeroi
        ap[1 - 1] = 1.0
        if aw2 < tol {
          pc2 = 2
          continue tb1~
        }
        let mut cnt3 = i_max(0, (30 - 2 + 1) / 1)
        k = 2
        while cnt3 > 0 {
          pr[k - 1] = (pr[(k - 1) - 1] * w2r) - (pi_[(k - 1) - 1] * w2i)
          pi_[k - 1] = (pr[(k - 1) - 1] * w2i) + (pi_[(k - 1) - 1] * w2r)
          sumar = sumar + (pr[k - 1] * zunhj_gama[k - 1])
          sumai = sumai + (pi_[k - 1] * zunhj_gama[k - 1])
          ap[k - 1] = ap[(k - 1) - 1] * aw2
          if ap[k - 1] < tol {
            pc2 = 2
            continue tb1~
          }
          k = k + 1
          cnt3 = cnt3 - 1
        }
        k = 30
        pc2 = 2
        continue tb1~
      }
      2 => {
        kmax = k
        zetar = (w2r * sumar) - (w2i * sumai)
        zetai = (w2r * sumai) + (w2i * sumar)
        argr = zetar * fn23
        argi = zetai * fn23
        let (mv4, mv5) = zsqrt_(sumar, sumai, zar, zai)
        zar = mv4
        zai = mv5
        let (mv6, mv7) = zsqrt_(w2r, w2i, str, sti)
        str = mv6
        sti = mv7
        zeta2r = str * fnu
        zeta2i = sti * fnu
        str = zunhj_coner + (zunhj_ex2 * ((zetar * zar) - (zetai * zai)))
        sti = zunhj_conei + (zunhj_ex2 * ((zetar * zai) + (zetai * zar)))
        zeta1r = (str * zeta2r) - (sti * zeta2i)
        zeta1i = (str * zeta2i) + (sti * zeta2r)
        zar = zar + zar
        zai = zai + zai
        let (mv8, mv9) = zsqrt_(zar, zai, str, sti)
        str = mv8
        sti = mv9
        phir = str * rfn13
        phii = sti * rfn13
        if ipmtr == 1 {
          pc2 = 4
          continue tb1~
        }
        sumbr = zunhj_zeror
        sumbi = zunhj_zeroi
        let mut cnt10 = i_max(0, (kmax - 1 + 1) / 1)
        k = 1
        while cnt10 > 0 {
          sumbr = sumbr + (pr[k - 1] * zunhj_beta[k - 1])
          sumbi = sumbi + (pi_[k - 1] * zunhj_beta[k - 1])
          k = k + 1
          cnt10 = cnt10 - 1
        }
        asumr = zunhj_zeror
        asumi = zunhj_zeroi
        bsumr = sumbr
        bsumi = sumbi
        l1 = 0
        l2 = 30
        btol = tol * ((d_abs(bsumr)) + (d_abs(bsumi)))
        atol = tol
        pp = 1.0
        ias = 0
        ibs = 0
        if rfnu2 < tol {
          pc2 = 3
          continue tb1~
        }
        let mut cnt11 = i_max(0, (7 - 2 + 1) / 1)
        is_ = 2
        while cnt11 > 0 {
          let mut pc13 = 0
          tb12~: while true {
            match pc13 {
              0 => {
                atol = atol / rfnu2
                pp = pp * rfnu2
                if ias == 1 {
                  pc13 = 2
                  continue tb12~
                }
                sumar = zunhj_zeror
                sumai = zunhj_zeroi
                let mut cnt14 = i_max(0, (kmax - 1 + 1) / 1)
                k = 1
                while cnt14 > 0 {
                  m = l1 + k
                  sumar = sumar + (pr[k - 1] * zunhj_alfa[m - 1])
                  sumai = sumai + (pi_[k - 1] * zunhj_alfa[m - 1])
                  if ap[k - 1] < atol {
                    pc13 = 1
                    continue tb12~
                  }
                  k = k + 1
                  cnt14 = cnt14 - 1
                }
                pc13 = 1
                continue tb12~
              }
              1 => {
                asumr = asumr + (sumar * pp)
                asumi = asumi + (sumai * pp)
                if pp < tol {
                  ias = 1
                }
                pc13 = 2
                continue tb12~
              }
              2 => {
                if ibs == 1 {
                  pc13 = 4
                  continue tb12~
                }
                sumbr = zunhj_zeror
                sumbi = zunhj_zeroi
                let mut cnt15 = i_max(0, (kmax - 1 + 1) / 1)
                k = 1
                while cnt15 > 0 {
                  m = l2 + k
                  sumbr = sumbr + (pr[k - 1] * zunhj_beta[m - 1])
                  sumbi = sumbi + (pi_[k - 1] * zunhj_beta[m - 1])
                  if ap[k - 1] < atol {
                    pc13 = 3
                    continue tb12~
                  }
                  k = k + 1
                  cnt15 = cnt15 - 1
                }
                pc13 = 3
                continue tb12~
              }
              3 => {
                bsumr = bsumr + (sumbr * pp)
                bsumi = bsumi + (sumbi * pp)
                if pp < btol {
                  ibs = 1
                }
                pc13 = 4
                continue tb12~
              }
              4 => {
                if (ias == 1) && (ibs == 1) {
                  pc2 = 3
                  continue tb1~
                }
                l1 = l1 + 30
                l2 = l2 + 30
                break tb12~
              }
              _ => panic()
            }
          }
          is_ = is_ + 1
          cnt11 = cnt11 - 1
        }
        pc2 = 3
        continue tb1~
      }
      3 => {
        asumr = asumr + zunhj_coner
        pp = rfnu * rfn13
        bsumr = bsumr * pp
        bsumi = bsumi * pp
        pc2 = 4
        continue tb1~
      }
      4 => {
        return (phir, phii, argr, argi, zeta1r, zeta1i, zeta2r, zeta2i, asumr, asumi, bsumr, bsumi)
      }
      5 => {
        let (mv16, mv17) = zsqrt_(w2r, w2i, wr, wi)
        wr = mv16
        wi = mv17
        if wr < 0.0 {
          wr = 0.0
        }
        if wi < 0.0 {
          wi = 0.0
        }
        str = zunhj_coner + wr
        sti = wi
        let (mv18, mv19) = zdiv(str, sti, zbr, zbi, zar, zai)
        zar = mv18
        zai = mv19
        let (mv20, mv21, mv22) = zlog(zar, zai, zcr, zci, idum)
        zcr = mv20
        zci = mv21
        idum = mv22
        if zci < 0.0 {
          zci = 0.0
        }
        if zci > zunhj_hpi {
          zci = zunhj_hpi
        }
        if zcr < 0.0 {
          zcr = 0.0
        }
        zthr = (zcr - wr) * 1.5
        zthi = (zci - wi) * 1.5
        zeta1r = zcr * fnu
        zeta1i = zci * fnu
        zeta2r = wr * fnu
        zeta2i = wi * fnu
        azth = zabs(zthr, zthi)
        ang = zunhj_thpi
        if (zthr >= 0.0) && (zthi < 0.0) {
          pc2 = 6
          continue tb1~
        }
        ang = zunhj_hpi
        if zthr == 0.0 {
          pc2 = 6
          continue tb1~
        }
        ang = f_atan((zthi / zthr))
        if zthr < 0.0 {
          ang = ang + zunhj_gpi
        }
        pc2 = 6
        continue tb1~
      }
      6 => {
        pp = f_pow(azth, zunhj_ex2)
        ang = ang * zunhj_ex2
        zetar = pp * (f_cos(ang))
        zetai = pp * (f_sin(ang))
        if zetai < 0.0 {
          zetai = 0.0
        }
        argr = zetar * fn23
        argi = zetai * fn23
        let (mv23, mv24) = zdiv(zthr, zthi, zetar, zetai, rtztr, rtzti)
        rtztr = mv23
        rtzti = mv24
        let (mv25, mv26) = zdiv(rtztr, rtzti, wr, wi, zar, zai)
        zar = mv25
        zai = mv26
        tzar = zar + zar
        tzai = zai + zai
        let (mv27, mv28) = zsqrt_(tzar, tzai, str, sti)
        str = mv27
        sti = mv28
        phir = str * rfn13
        phii = sti * rfn13
        if ipmtr == 1 {
          pc2 = 4
          continue tb1~
        }
        raw = 1.0 / (f_sqrt(aw2))
        str = wr * raw
        sti = (-wi) * raw
        tfnr = (str * rfnu) * raw
        tfni = (sti * rfnu) * raw
        razth = 1.0 / azth
        str = zthr * razth
        sti = (-zthi) * razth
        rzthr = (str * razth) * rfnu
        rzthi = (sti * razth) * rfnu
        zcr = rzthr * zunhj_ar[2 - 1]
        zci = rzthi * zunhj_ar[2 - 1]
        raw2 = 1.0 / aw2
        str = w2r * raw2
        sti = (-w2i) * raw2
        t2r = str * raw2
        t2i = sti * raw2
        str = (t2r * zunhj_c[2 - 1]) + zunhj_c[3 - 1]
        sti = t2i * zunhj_c[2 - 1]
        upr[2 - 1] = (str * tfnr) - (sti * tfni)
        upi[2 - 1] = (str * tfni) + (sti * tfnr)
        bsumr = upr[2 - 1] + zcr
        bsumi = upi[2 - 1] + zci
        asumr = zunhj_zeror
        asumi = zunhj_zeroi
        if rfnu < tol {
          pc2 = 7
          continue tb1~
        }
        przthr = rzthr
        przthi = rzthi
        ptfnr = tfnr
        ptfni = tfni
        upr[1 - 1] = zunhj_coner
        upi[1 - 1] = zunhj_conei
        pp = 1.0
        btol = tol * ((d_abs(bsumr)) + (d_abs(bsumi)))
        ks = 0
        kp1 = 2
        l = 3
        ias = 0
        ibs = 0
        let mut cnt29 = i_max(0, (12 - 2 + 2) / 2)
        lr = 2
        while cnt29 > 0 {
          let mut pc31 = 0
          tb30~: while true {
            match pc31 {
              0 => {
                lrp1 = lr + 1
                let mut cnt32 = i_max(0, (lrp1 - lr + 1) / 1)
                k = lr
                while cnt32 > 0 {
                  ks = ks + 1
                  kp1 = kp1 + 1
                  l = l + 1
                  zar = zunhj_c[l - 1]
                  zai = zunhj_zeroi
                  let mut cnt33 = i_max(0, (kp1 - 2 + 1) / 1)
                  j = 2
                  while cnt33 > 0 {
                    l = l + 1
                    str = ((zar * t2r) - (t2i * zai)) + zunhj_c[l - 1]
                    zai = (zar * t2i) + (zai * t2r)
                    zar = str
                    j = j + 1
                    cnt33 = cnt33 - 1
                  }
                  str = (ptfnr * tfnr) - (ptfni * tfni)
                  ptfni = (ptfnr * tfni) + (ptfni * tfnr)
                  ptfnr = str
                  upr[kp1 - 1] = (ptfnr * zar) - (ptfni * zai)
                  upi[kp1 - 1] = (ptfni * zar) + (ptfnr * zai)
                  crr[ks - 1] = przthr * zunhj_br[(ks + 1) - 1]
                  cri[ks - 1] = przthi * zunhj_br[(ks + 1) - 1]
                  str = (przthr * rzthr) - (przthi * rzthi)
                  przthi = (przthr * rzthi) + (przthi * rzthr)
                  przthr = str
                  drr[ks - 1] = przthr * zunhj_ar[(ks + 2) - 1]
                  dri[ks - 1] = przthi * zunhj_ar[(ks + 2) - 1]
                  k = k + 1
                  cnt32 = cnt32 - 1
                }
                pp = pp * rfnu2
                if ias == 1 {
                  pc31 = 1
                  continue tb30~
                }
                sumar = upr[lrp1 - 1]
                sumai = upi[lrp1 - 1]
                ju = lrp1
                let mut cnt34 = i_max(0, (lr - 1 + 1) / 1)
                jr = 1
                while cnt34 > 0 {
                  ju = ju - 1
                  sumar = (sumar + (crr[jr - 1] * upr[ju - 1])) - (cri[jr - 1] * upi[ju - 1])
                  sumai = (sumai + (crr[jr - 1] * upi[ju - 1])) + (cri[jr - 1] * upr[ju - 1])
                  jr = jr + 1
                  cnt34 = cnt34 - 1
                }
                asumr = asumr + sumar
                asumi = asumi + sumai
                test_ = (d_abs(sumar)) + (d_abs(sumai))
                if (pp < tol) && (test_ < tol) {
                  ias = 1
                }
                pc31 = 1
                continue tb30~
              }
              1 => {
                if ibs == 1 {
                  pc31 = 2
                  continue tb30~
                }
                sumbr = (upr[(lr + 2) - 1] + (upr[lrp1 - 1] * zcr)) - (upi[lrp1 - 1] * zci)
                sumbi = (upi[(lr + 2) - 1] + (upr[lrp1 - 1] * zci)) + (upi[lrp1 - 1] * zcr)
                ju = lrp1
                let mut cnt35 = i_max(0, (lr - 1 + 1) / 1)
                jr = 1
                while cnt35 > 0 {
                  ju = ju - 1
                  sumbr = (sumbr + (drr[jr - 1] * upr[ju - 1])) - (dri[jr - 1] * upi[ju - 1])
                  sumbi = (sumbi + (drr[jr - 1] * upi[ju - 1])) + (dri[jr - 1] * upr[ju - 1])
                  jr = jr + 1
                  cnt35 = cnt35 - 1
                }
                bsumr = bsumr + sumbr
                bsumi = bsumi + sumbi
                test_ = (d_abs(sumbr)) + (d_abs(sumbi))
                if (pp < btol) && (test_ < btol) {
                  ibs = 1
                }
                pc31 = 2
                continue tb30~
              }
              2 => {
                if (ias == 1) && (ibs == 1) {
                  pc2 = 7
                  continue tb1~
                }
                break tb30~
              }
              _ => panic()
            }
          }
          lr = lr + 2
          cnt29 = cnt29 - 1
        }
        pc2 = 7
        continue tb1~
      }
      7 => {
        asumr = asumr + zunhj_coner
        str = (-bsumr) * rfn13
        sti = (-bsumi) * rfn13
        let (mv36, mv37) = zdiv(str, sti, rtztr, rtzti, bsumr, bsumi)
        bsumr = mv36
        bsumi = mv37
        pc2 = 4
        continue tb1~
      }
      8 => {
        return (phir, phii, argr, argi, zeta1r, zeta1i, zeta2r, zeta2i, asumr, asumi, bsumr, bsumi)
      }
      _ => panic()
    }
  }
  panic()
}
