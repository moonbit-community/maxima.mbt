                sti = (dair * bsumdi) + (daii * bsumdr)
                str = str + ((air * asumdr) - (aii * asumdi))
                sti = sti + ((air * asumdi) + (aii * asumdr))
                ptr = (str * phidr) - (sti * phidi)
                pti = (str * phidi) + (sti * phidr)
                s2r = (ptr * csr) - (pti * csi)
                s2i = (ptr * csi) + (pti * csr)
                str = (f_exp(s1r)) * cssr[iflag - 1]
                s1r = str * (f_cos(s1i))
                s1i = str * (f_sin(s1i))
                str = (s2r * s1r) - (s2i * s1i)
                s2i = (s2r * s1i) + (s2i * s1r)
                s2r = str
                if iflag != 1 {
                  pc44 = 7
                  continue tb43~
                }
                let mv65 = zuchk(s2r, s2i, nw, bry[1 - 1], tol)
                nw = mv65
                if nw == 0 {
                  pc44 = 7
                  continue tb43~
                }
                s2r = zunk2_zeror
                s2i = zunk2_zeroi
                pc44 = 7
                continue tb43~
              }
              7 => {
                if yy <= 0.0 {
                  s2i = -s2i
                }
                cyr[kdflg - 1] = s2r
                cyi[kdflg - 1] = s2i
                c2r = s2r
                c2i = s2i
                s2r = s2r * csrr[iflag - 1]
                s2i = s2i * csrr[iflag - 1]
                s1r = yr[kk - 1]
                s1i = yi[kk - 1]
                if kode == 1 {
                  pc44 = 8
                  continue tb43~
                }
                let (mv66, mv67, mv68, mv69, mv70, mv71) = zs1s2(zrr, zri, s1r, s1i, s2r, s2i, nw, asc, alim, iuf)
                s1r = mv66
                s1i = mv67
                s2r = mv68
                s2i = mv69
                nw = mv70
                iuf = mv71
                nz = nz + nw
                pc44 = 8
                continue tb43~
              }
              8 => {
                yr[kk - 1] = ((s1r * cspnr) - (s1i * cspni)) + s2r
                yi[kk - 1] = ((s1r * cspni) + (s1i * cspnr)) + s2i
                kk = kk - 1
                cspnr = -cspnr
                cspni = -cspni
                str = csi
                csi = -csr
                csr = str
                if (c2r != 0.0) || (c2i != 0.0) {
                  pc44 = 9
                  continue tb43~
                }
                kdflg = 1
                break tb43~
              }
              9 => {
                if kdflg == 2 {
                  pc2 = 10
                  continue tb1~
                }
                kdflg = 2
                break tb43~
              }
              10 => {
                if rs1 > 0.0 {
                  pc2 = 11
                  continue tb1~
                }
                s2r = zunk2_zeror
                s2i = zunk2_zeroi
                pc44 = 7
                continue tb43~
              }
              _ => panic()
            }
          }
          k = k + 1
          cnt42 = cnt42 - 1
        }
        k = n
        pc2 = 10
        continue tb1~
      }
      10 => {
        il = n - k
        if il == 0 {
          return nz
        }
        s1r = cyr[1 - 1]
        s1i = cyi[1 - 1]
        s2r = cyr[2 - 1]
        s2i = cyi[2 - 1]
        csr = csrr[iflag - 1]
        ascle = bry[iflag - 1]
        fn_ = (inu + il).to_double()
        let mut cnt72 = i_max(0, (il - 1 + 1) / 1)
        i = 1
        while cnt72 > 0 {
          let mut pc74 = 0
          tb73~: while true {
            match pc74 {
              0 => {
                c2r = s2r
                c2i = s2i
                s2r = s1r + ((fn_ + fnf) * ((rzr * c2r) - (rzi * c2i)))
                s2i = s1i + ((fn_ + fnf) * ((rzr * c2i) + (rzi * c2r)))
                s1r = c2r
                s1i = c2i
                fn_ = fn_ - 1.0
                c2r = s2r * csr
                c2i = s2i * csr
                ckr = c2r
                cki = c2i
                c1r = yr[kk - 1]
                c1i = yi[kk - 1]
                if kode == 1 {
                  pc74 = 1
                  continue tb73~
                }
                let (mv75, mv76, mv77, mv78, mv79, mv80) = zs1s2(zrr, zri, c1r, c1i, c2r, c2i, nw, asc, alim, iuf)
                c1r = mv75
                c1i = mv76
                c2r = mv77
                c2i = mv78
                nw = mv79
                iuf = mv80
                nz = nz + nw
                pc74 = 1
                continue tb73~
              }
              1 => {
                yr[kk - 1] = ((c1r * cspnr) - (c1i * cspni)) + c2r
                yi[kk - 1] = ((c1r * cspni) + (c1i * cspnr)) + c2i
                kk = kk - 1
                cspnr = -cspnr
                cspni = -cspni
                if iflag >= 3 {
                  break tb73~
                }
                c2r = d_abs(ckr)
                c2i = d_abs(cki)
                c2m = d_max(c2r, c2i)
                if c2m <= ascle {
                  break tb73~
                }
                iflag = iflag + 1
                ascle = bry[iflag - 1]
                s1r = s1r * csr
                s1i = s1i * csr
                s2r = ckr
                s2i = cki
                s1r = s1r * cssr[iflag - 1]
                s1i = s1i * cssr[iflag - 1]
                s2r = s2r * cssr[iflag - 1]
                s2i = s2i * cssr[iflag - 1]
                csr = csrr[iflag - 1]
                break tb73~
              }
              _ => panic()
            }
          }
          i = i + 1
          cnt72 = cnt72 - 1
        }
        return nz
      }
      11 => {
        nz = -1
        return nz
      }
      12 => {
        return nz
      }
      _ => panic()
    }
  }
  panic()
}
