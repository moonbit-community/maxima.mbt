                s2i = s2i * cssr[iflag - 1]
                csr = csrr[iflag - 1]
                break tb48~
              }
              _ => panic()
            }
          }
          i = i + 1
          cnt47 = cnt47 - 1
        }
        return nz
      }
      10 => {
        nz = -1
        return nz
      }
      11 => {
        return nz
      }
      _ => panic()
    }
  }
  panic()
}
