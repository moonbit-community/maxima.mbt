  defun(q_pair_factor, args => pair_factor(arg(args, 0), arg(args, 1)))
  defun(q_more_subfactors_q, args => more_subfactors_q(arg(args, 0)))
  defun(q_gcfac_prodscan, args => gcfac_prodscan(arg(args, 0)))
  defun(q_monomial_factor, args => monomial_factor(arg(args, 0)))
  defun(q_d_gcfac, args => d_gcfac(arg(args, 0)))
}

///|
fn register_share_rducon() -> Unit {
  defun(q_query_const_table, args => query_const_table(arg(args, 0)))
  defun(q_new_name, args => new_name(arg(args, 0)))
  defun(q_log_const, args => log_const(arg(args, 0), arg(args, 1)))
  defun(q_obtain_constant, args => obtain_constant(arg(args, 0), arg(args, 1)))
  defun(q_find_constant, args => find_constant(arg(args, 0)))
  defun(q_reduce_constants, args => reduce_constants(arg(args, 0), newconst?=args.get(1)))
  defun(q_d_reduce_consts, args => d_reduce_consts(arg(args, 0), newconstant?=args.get(1)))
}
