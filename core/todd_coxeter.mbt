// Port of src/todd-coxeter.lisp: coset enumeration (Todd-Coxeter).

// (defstruct tc-state nvars ncosets multiply-table relations
//   subgroup-generators row1-relations), stored in $todd_coxeter_state.

///|
fn todd_coxeter__state() -> Value {
  symval(q_d_todd_coxeter_state)
}

///|
fn todd_coxeter__nvars() -> Int raise {
  to_int(struct_ref(todd_coxeter__state(), 0))
}

///|
fn todd_coxeter__ncosets() -> Int raise {
  to_int(struct_ref(todd_coxeter__state(), 1))
}

///|
fn todd_coxeter__set_ncosets(n : Int) -> Unit raise {
  struct_set(todd_coxeter__state(), 1, int(n)) |> ignore
}

///|
fn todd_coxeter__multiply_table() -> Value raise {
  struct_ref(todd_coxeter__state(), 2)
}

///|
fn todd_coxeter__relations() -> Value raise {
  struct_ref(todd_coxeter__state(), 3)
}

///|
fn todd_coxeter__row1_relations() -> Value raise {
  struct_ref(todd_coxeter__state(), 5)
}

///|
fn todd_coxeter__todo() -> Value {
  symval(q_ear_todo)
}

///|
/// The multiplication table for variable i.
fn todd_coxeter__table(i : Int) -> Value raise {
  aref1(todd_coxeter__multiply_table(), i + todd_coxeter__nvars())
}

///|
fn todd_coxeter__set_table(i : Int, v : Value) -> Unit raise {
  aset1(todd_coxeter__multiply_table(), i + todd_coxeter__nvars(), v) |> ignore
}

///|
/// Multiply coset K times variable R.
fn todd_coxeter__mult(k : Int, r : Int) -> Int raise {
  to_int(aref1(todd_coxeter__table(r), k))
}

///|
fn todd_coxeter__set_mult(k : Int, r : Int, s : Int) -> Unit raise {
  aset1(todd_coxeter__table(r), k, int(s)) |> ignore
}

///|
/// Force  k . r = s and  k = s . r^-1
fn todd_coxeter__define_mult(k : Int, r : Int, s : Int) -> Unit raise {
  todd_coxeter__set_mult(k, r, s)
  todd_coxeter__set_mult(s, -r, k)
}

///|
/// cosets M < N are to be made equal
fn todd_coxeter__push_todo(m : Int, n : Int) -> Unit raise {
  vector_push_extend(int(m), todd_coxeter__todo()) |> ignore
  vector_push_extend(int(n), todd_coxeter__todo()) |> ignore
}

///|
fn undef(s : Value) -> Value raise {
  lbool(eql(int(0), s))
}

///|
fn tc_mult(k : Value, r : Value) -> Value raise {
  int(todd_coxeter__mult(to_int(k), to_int(r)))
}

///|
fn define_tc_mult(k : Value, r : Value, s : Value) -> Value raise {
  todd_coxeter__define_mult(to_int(k), to_int(r), to_int(s))
  k
}

///|
fn push_todo(m : Value, n : Value) -> Value raise {
  vector_push_extend(m, todd_coxeter__todo()) |> ignore
  int(vector_push_extend(n, todd_coxeter__todo()))
}

///|
fn table(i : Value) -> Value raise {
  todd_coxeter__table(to_int(i))
}

///|
/// Returns order of G/H, where G is Free/(rels), and H is generated by
/// SUBGP. This is the main entry point at lisp level.
fn todd_coxeter(nvars : Value, rels : Value, subgp : Value) -> Value raise {
  let mut i = 1
  let mut c = 0
  set_up(nvars, rels, subgp) |> ignore
  while todd_coxeter__ncosets() >= i {
    c += 1 // count how many row tries..
    if doing_row(int(i)).truthy() {
      // row still being done
      replace_coset_in_multiply_table() |> ignore
    } else if fill_pointer(todd_coxeter__todo()) > 0 {
      // row finished but there is work to do
      i += 1
      replace_coset_in_multiply_table() |> ignore
    } else {
      // row finished -- no work
      i += 1
    }
  }
  format(t, "~%Rows tried ~d~%", [int(c)]) |> ignore
  int(todd_coxeter__ncosets())
}

///|
/// Store the data in $todd_coxeter_state, and build multiply-table.
fn set_up(nvars : Value, rels : Value, subgp : Value) -> Value raise {
  set_fill_pointer(todd_coxeter__todo(), 0)
  let nv = to_int(nvars)
  set(
    q_d_todd_coxeter_state,
    make_struct("tc-state", [
      nvars,
      int(1),
      make_array([1 + 2 * nv], initial=int(0)),
      rels,
      subgp,
      append(subgp, rels),
    ]),
  )
  |> ignore
  for rel in todd_coxeter__row1_relations().iter() {
    for v in rel.iter() {
      let a = num_abs(v)
      if !(num_le(int(1), a) && num_le(a, nvars)) {
        raise LispError::SimpleError(
          format_to_string(
            "Vars must be integers with absolute value between 1 and ~d",
            [nvars],
          ),
        )
      }
    }
  }
  let mut last : Value = Nil
  for i in -nv..=nv {
    if i != 0 {
      last = make_array([10], initial=int(0))
      todd_coxeter__set_table(i, last)
    }
  }
  last
}

///|
/// Starts multiplying coset i times the relations.  Basic fact is
/// i . rel = i.  When an inconsistency is found the two cosets are put in
/// *todo* and the rest of the relations (non-nil if the row must be
/// resumed) is returned.
fn doing_row(i : Value) -> Value raise {
  with_special(q_ear_this_row, Nil, () => {
    let i = to_int(i)
    let mut j = 0
    let relations = if i == 1 {
      todd_coxeter__row1_relations()
    } else {
      todd_coxeter__relations()
    }
    let mut v = relations
    while !(v is Nil) {
      let mut rel = car(v)
      let mut k = i
      while true {
        let r = to_int(car(rel))
        let mut s = todd_coxeter__mult(k, r)
        if s == 0 {
          if cdr(rel).truthy() {
            s = to_int(next_coset())
            todd_coxeter__define_mult(k, r, s)
          } else {
            s = todd_coxeter__mult(i, -r)
            if s == 0 {
              todd_coxeter__define_mult(k, r, i)
            } else if k < s {
              todd_coxeter__push_todo(k, s)
              return cdr(v)
            } else if k > s {
              todd_coxeter__push_todo(s, k)
              return cdr(v)
            }
            break
          }
        }
        rel = cdr(rel)
        if rel.truthy() {
          if symval(q_ear_debug).truthy() {
            push_special(int(s), q_ear_this_row) |> ignore
            my_print(reverse(symval(q_ear_this_row)), int(i)) |> ignore
          }
          k = s
          j += 1
        } else if i < s {
          todd_coxeter__push_todo(i, s)
          return cdr(v)
        } else if i > s {
          todd_coxeter__push_todo(s, i)
          return cdr(v)
        } else {
          // rel is exhausted and it matched
          break
        }
      }
      v = cdr(v)
    }
    if symval(q_ear_debug).truthy() {
      dcheck_tables() |> ignore
      my_print(reverse(symval(q_ear_this_row)), int(i)) |> ignore
    }
    Nil
  })
}

///|
/// FILL-IN-INVERSES not only completes the (table i) for i < 0 but at the
/// same time checks that (table i) for i > 0 does not have repeats.
fn fill_in_inverses() -> Value raise {
  let nvars = todd_coxeter__nvars()
  for i in 1..=nvars {
    let ta1 = todd_coxeter__table(i)
    let ta2 = todd_coxeter__table(-i)
    for j in 1..=todd_coxeter__ncosets() {
      aset1(ta2, j, int(0)) |> ignore
    }
    for j in 1..=todd_coxeter__ncosets() {
      let s = to_int(aref1(ta1, j))
      if s != 0 {
        let sp = to_int(aref1(ta2, s))
        if sp == 0 {
          aset1(ta2, s, int(j)) |> ignore
        } else {
          // there's a duplicate!
          todd_coxeter__push_todo(sp, j)
          return t
        }
      }
    }
  }
  Nil
}

///|
/// Pop n and m from *todo* and replace n by m in multiply-table and in
/// *todo*, then FILL-IN-INVERSES (which may add entries to *todo*).
fn replace_coset_in_multiply_table() -> Value raise {
  let nvars = todd_coxeter__nvars()
  let todo = todd_coxeter__todo()
  while true {
    let n = to_int(vector_pop(todo))
    let m = to_int(vector_pop(todo))
    if m != n {
      dprint_state() |> ignore
      if symval(q_ear_debug).truthy() {
        format(t, "     ~a --> ~a ", [int(n), int(m)]) |> ignore
      }
      for i in 1..=nvars {
        let ta = todd_coxeter__table(i)
        let s2 = todd_coxeter__mult(n, i)
        if s2 != 0 {
          let s = todd_coxeter__mult(m, i)
          if s == 0 {
            todd_coxeter__set_mult(m, i, s2)
          } else if s < s2 {
            todd_coxeter__push_todo(s, s2)
          } else if s > s2 {
            todd_coxeter__push_todo(s2, s)
          }
        }
        let mut j = n - 1
        while j >= 1 {
          let s = to_int(aref1(ta, j))
          if s > n {
            aset1(ta, j, int(s - 1)) |> ignore
          } else if s == n {
            aset1(ta, j, int(m)) |> ignore
          }
          j -= 1
        }
        let mut j = n
        while j < todd_coxeter__ncosets() {
          let s = to_int(aref1(ta, j + 1))
          if s > n {
            aset1(ta, j, int(s - 1)) |> ignore
          } else if s == n {
            aset1(ta, j, int(m)) |> ignore
          } else {
            aset1(ta, j, int(s)) |> ignore
          }
          j += 1
        }
      }
      let mut i = fill_pointer(todo) - 1
      while i >= 0 {
        let s = to_int(aref1(todo, i))
        if s > n {
          aset1(todo, i, int(s - 1)) |> ignore
        } else if s == n {
          aset1(todo, i, int(m)) |> ignore
        }
        i -= 1
      }
      todd_coxeter__set_ncosets(todd_coxeter__ncosets() - 1)
      dprint_state() |> ignore
    }
    if fill_pointer(todo) > 0 {
      continue
    }
    // check for new duplicates introduced!!
    if fill_in_inverses().truthy() {
      continue
    }
    break
  }
  Nil
}

///|
/// Get the next coset number, making sure the multiply-table will have
/// room for it, and is appropriately cleaned up.
fn next_coset() -> Value raise {
  let n = 1 + todd_coxeter__ncosets()
  let nvars = todd_coxeter__nvars()
  let ta = todd_coxeter__table(1)
  if !(array_total_size(ta) > 1 + n) {
    let m = n + (n >> 1)
    for i in -nvars..=nvars {
      if i != 0 {
        let ta = todd_coxeter__table(i)
        todd_coxeter__set_table(i, adjust_array(ta, [m], initial=int(0)))
      }
    }
  }
  for i in 1..=nvars {
    aset1(todd_coxeter__table(i), n, int(0)) |> ignore
    aset1(todd_coxeter__table(-i), n, int(0)) |> ignore
  }
  todd_coxeter__set_ncosets(n)
  int(n)
}

///|
/// todd_coxeter(rels, subgp) computes the order of G/H where
/// G = Free(listofvars(rels))/subgp_generated(rels)) and H is generated by
/// subgp.
fn d_todd_coxeter(rels : Value, subgp? : Value) -> Value raise {
  let subgp = match subgp {
    Some(s) => s
    None => list1(list1(q_mlist))
  }
  let vars = d_sort(d_listofvars(rels))
  let neg = int(1)
  todd_coxeter(
    d_length(vars),
    mapcar(rel => coerce_rel(neg, vars, rel), cdr(rels)),
    mapcar(rel => coerce_rel(neg, vars, rel), cdr(subgp)),
  )
}

///|
fn coerce_rel(neg : Value, vars : Value, rel : Value) -> Value raise {
  if atom(rel) {
    let p = position(rel, vars)
    if p < 0 {
      raise LispError::SimpleError("coerce-rel: variable not found")
    }
    list1(num_mul(neg, int(p)))
  } else if eq(caar(rel), q_mnctimes) {
    append_n(list_to_array(mapcar(r => coerce_rel(neg, vars, r), cdr(rel))))
  } else if eq(caar(rel), q_mncexpt) {
    let n = meval(third(rel))
    let neg = signum(n)
    let v = coerce_rel(neg, vars, second(rel))
    let parts = []
    let mut i = int(0)
    while num_lt(i, num_abs(third(rel))) {
      parts.push(copy_list(v))
      i = num_add(i, int(1))
    }
    append_n(parts)
  } else {
    raise LispError::SimpleError("bad rel")
  }
}

///|
/// For debugging: display the rows as they are computed.
fn my_print(ro : Value, i : Value) -> Value raise {
  if !symval(q_ear_debug).truthy() {
    return Nil
  }
  let mut ro = ro
  fresh_line() |> ignore
  format(t, "Row ~a ", [i]) |> ignore
  let relations = if eql(i, int(1)) {
    todd_coxeter__row1_relations()
  } else {
    todd_coxeter__relations()
  }
  for rel in relations.iter() {
    let mut v = rel
    while !(v is Nil) {
      format(
        t,
        if num_gt(car(v), int(0)) {
          "~a"
        } else {
          "~(~a~)"
        },
        [nth(to_int(num_abs(car(v))), symval(q_ear_names))],
      )
      |> ignore
      if ro is Nil {
        return Nil
      }
      if cdr(v).truthy() {
        princ(car(ro)) |> ignore
        ro = cdr(ro)
      } else {
        format(t, "~a | ~a", [i, i]) |> ignore
      }
      v = cdr(v)
    }
  }
  Nil
}

///|
fn has_repeat(ar : Value) -> Value raise {
  let j = 1 + todd_coxeter__ncosets()
  let mut ans : Value = Nil
  for k in 1..=todd_coxeter__ncosets() {
    let tem = aref1(ar, k)
    if !eql(tem, int(0)) {
      let mut found = false
      for q in (k + 1)..<j {
        if eql(aref1(ar, q), tem) {
          found = true
          break
        }
      }
      if found && member(tem, ans) is Nil {
        ans = cons(tem, ans)
      }
    }
  }
  ans
}

///|
fn dcheck_tables() -> Value raise {
  if symval(q_ear_debug).truthy() {
    for i in 1..=todd_coxeter__nvars() {
      let tem = has_repeat(todd_coxeter__table(i))
      if tem.truthy() {
        format(t, "~%Table ~a has repeat ~a ", [int(i), tem]) |> ignore
      }
    }
  }
  Nil
}

///|
fn dprint_state() -> Value raise {
  if symval(q_ear_debug).truthy() {
    format(t, "~%Ncosets = ~a, *todo* = ~a", [
      int(todd_coxeter__ncosets()),
      todd_coxeter__todo(),
    ])
    |> ignore
    for i in 1..=todd_coxeter__nvars() {
      format(t, "~%~a:~a", [
        nth(i, symval(q_ear_names)),
        subseq(todd_coxeter__table(i), 1, end=1 + todd_coxeter__ncosets()),
      ])
      |> ignore
    }
    my_print(reverse(symval(q_ear_this_row)), int(0))
  } else {
    Nil
  }
}

///|
fn init_todd_coxeter() -> Unit raise {
  defvar_init(q_ear_todo, make_array([10], initial=int(0), fill=0))
  defvar_init(q_ear_names, list([Nil, q_x, q_y, q_z]))
}
