// Port of src/init-cl.lisp: initialize Maxima -- directories, file search
// lists, command-line options, run-time globals, and the final snapshot of
// built-in symbols taken once all of Maxima is loaded.
//
// The MoonBit main program calls `init_cl__setup_paths()` (which runs
// INITIALIZE-RUNTIME-GLOBALS) after `initialize()`. It may also hand the
// command-line arguments to `init_cl__set_application_args` for
// PROCESS-MAXIMA-ARGS.

// ---- Autoconf variables (autoconf-variables.lisp is generated by configure
// and not part of the port; these are the values for the port's layout,
// which is a Maxima source tree).

///|
let init_cl__default_prefix : String = "/Users/dii/git/maxima.mbt/.repos/maxima"

///|
let init_cl__q_autoconf_prefix : Value = sym("*autoconf-prefix*")

///|
let init_cl__q_autoconf_package : Value = sym("*autoconf-package*")

///|
let init_cl__q_autoconf_libdir : Value = sym("*autoconf-libdir*")

///|
let init_cl__q_autoconf_datadir : Value = sym("*autoconf-datadir*")

///|
let init_cl__q_autoconf_infodir : Value = sym("*autoconf-infodir*")

///|
let init_cl__q_autoconf_win32 : Value = sym("*autoconf-win32*")

///|
let init_cl__q_maxima_default_layout_autotools : Value = sym(
  "*maxima-default-layout-autotools*",
)

///|
let init_cl__q_load_pathname : Value = sym("*load-pathname*")

///|
/// Called by the MoonBit main program with the program arguments (without
/// the program name), for GET-APPLICATION-ARGS.
fn init_cl__set_application_args(args : Array[String]) -> Unit {
  cmdline__argv.val = args
}

///|
/// Entry point for the main program: run-time initialization of paths,
/// file search lists, locale, *bigprimes*, the atan2 table, etc.
fn init_cl__setup_paths() -> Unit raise {
  initialize_runtime_globals() |> ignore
}

///|
fn init_cl__str(v : Value) -> String {
  match v {
    Str(s) => s
    Nil => ""
    _ => princ_to_string(v)
  }
}

///|
fn init_cl__getenv(name : String) -> Value raise {
  maxima_getenv(Str(name))
}

///|
/// COMBINE-PATH (cl-info.lisp): splice a "/" between the path components,
/// collapsing multiple consecutive slashes into a single slash.
fn init_cl__combine_path(parts : Array[String]) -> String {
  let raw = parts.join("/")
  let sb = StringBuilder::new()
  let mut prev_slash = false
  for c in raw {
    if c == '/' {
      if !prev_slash {
        sb.write_char(c)
        prev_slash = true
      }
    } else {
      sb.write_char(c)
      prev_slash = false
    }
  }
  sb.to_string()
}

///|
fn init_cl__combine(parts : Array[Value]) -> Value {
  Str(init_cl__combine_path(parts.map(init_cl__str)))
}

///|
fn shadow_string_assignment(var_ : Value, value : Value) -> Value raise {
  if stringp(value) {
    set(get(var_, q_lisp_shadow), value) |> ignore
    value
  } else {
    merr("assignment: must assign a string to ~:M; found: ~M", [var_, value])
  }
}

///|
fn print_directories() -> Value raise {
  for var_ in [
    q_ear_maxima_prefix, q_ear_maxima_topdir, q_ear_maxima_imagesdir, q_ear_maxima_sharedir,
    q_ear_maxima_srcdir, q_ear_maxima_demodir, q_ear_maxima_testsdir, q_ear_maxima_docdir,
    q_ear_maxima_infodir, q_ear_maxima_htmldir, q_ear_maxima_layout_autotools, q_ear_maxima_userdir,
    q_ear_maxima_tempdir, q_ear_maxima_lang_subdir, q_ear_maxima_objdir,
  ] {
    // Neatly print out the name of the variable (sans *) and the
    // corresponding value.
    let name = string_trim("*", string_downcase(symbol_name(var_))) + ":"
    let pad = if string_length(name) < 25 { 25 - string_length(name) } else { 1 }
    write_string(name + " ".repeat(pad))
    princ(symbol_value(var_)) |> ignore
    terpri()
  }
  Nil
}

///|
fn maxima_parse_dirstring(str : Value) -> Value raise {
  let s = init_cl__str(str)
  let sep = if string_search("\\", s) >= 0 { "\\" } else { "/" }
  let s = string_right_trim(sep, s) + sep
  // The device and directory components of the pathname (POSIX: no device).
  let comps = s
    .split("/")
    .map(v => v.to_string())
    .filter(v => v != "")
    .collect()
  Str("/" + init_cl__combine_path(comps))
}

///|
fn set_pathnames_with_autoconf(
  maxima_prefix_env : Value,
  maxima_docprefix_env : Value,
) -> Value raise {
  ignore(maxima_docprefix_env)
  let package_version = init_cl__combine([
    symval(init_cl__q_autoconf_package),
    symval(q_ear_autoconf_version),
  ])
  let binary_subdirectory : Value = Str(
    "binary-" + init_cl__str(symval(q_ear_maxima_lispname)),
  )
  let (libdir, datadir, infodir) = if maxima_prefix_env.truthy() {
    (
      init_cl__combine([maxima_prefix_env, Str("lib")]),
      init_cl__combine([maxima_prefix_env, Str("share")]),
      init_cl__combine([maxima_prefix_env, Str("info")]),
    )
  } else {
    (
      maxima_parse_dirstring(symval(init_cl__q_autoconf_libdir)),
      maxima_parse_dirstring(symval(init_cl__q_autoconf_datadir)),
      maxima_parse_dirstring(symval(init_cl__q_autoconf_infodir)),
    )
  }
  set(q_ear_maxima_topdir, init_cl__combine([datadir, package_version]))
  |> ignore
  set(
    q_ear_maxima_imagesdir,
    init_cl__combine([libdir, package_version, binary_subdirectory]),
  )
  |> ignore
  set(
    q_ear_maxima_sharedir,
    init_cl__combine([datadir, package_version, Str("share")]),
  )
  |> ignore
  set(q_ear_maxima_srcdir, init_cl__combine([datadir, package_version, Str("src")]))
  |> ignore
  set(
    q_ear_maxima_demodir,
    init_cl__combine([datadir, package_version, Str("demo")]),
  )
  |> ignore
  set(
    q_ear_maxima_testsdir,
    init_cl__combine([datadir, package_version, Str("tests")]),
  )
  |> ignore
  set(q_ear_maxima_docdir, init_cl__combine([datadir, package_version, Str("doc")]))
  |> ignore
  set(q_ear_maxima_infodir, infodir) |> ignore
  set(
    q_ear_maxima_htmldir,
    init_cl__combine([datadir, package_version, Str("doc"), Str("html")]),
  )
}

///|
fn set_pathnames_without_autoconf(
  maxima_prefix_env : Value,
  maxima_docprefix_env : Value,
) -> Value raise {
  let maxima_prefix = if maxima_prefix_env.truthy() {
    maxima_prefix_env
  } else {
    maxima_parse_dirstring(symval(init_cl__q_autoconf_prefix))
  }
  let binary_subdirectory : Value = Str(
    "binary-" + init_cl__str(symval(q_ear_maxima_lispname)),
  )
  set(q_ear_maxima_topdir, maxima_prefix) |> ignore
  set(
    q_ear_maxima_imagesdir,
    init_cl__combine([maxima_prefix, Str("src"), binary_subdirectory]),
  )
  |> ignore
  set(q_ear_maxima_sharedir, init_cl__combine([maxima_prefix, Str("share")]))
  |> ignore
  set(q_ear_maxima_srcdir, init_cl__combine([maxima_prefix, Str("src")]))
  |> ignore
  set(q_ear_maxima_demodir, init_cl__combine([maxima_prefix, Str("demo")]))
  |> ignore
  set(q_ear_maxima_testsdir, init_cl__combine([maxima_prefix, Str("tests")]))
  |> ignore
  let maxima_doc_prefix = if maxima_docprefix_env.truthy() {
    maxima_docprefix_env
  } else {
    maxima_prefix
  }
  set(q_ear_maxima_docdir, init_cl__combine([maxima_doc_prefix, Str("doc")]))
  |> ignore
  set(
    q_ear_maxima_infodir,
    init_cl__combine([maxima_doc_prefix, Str("doc"), Str("info")]),
  )
  |> ignore
  set(
    q_ear_maxima_htmldir,
    init_cl__combine([maxima_doc_prefix, Str("doc"), Str("html")]),
  )
}

///|
fn default_userdir() -> Value raise {
  let home_env = {
    let h = init_cl__getenv("HOME")
    if h.truthy() {
      h
    } else {
      init_cl__getenv("USERPROFILE")
    }
  }
  let windows = init_cl__str(symval(q_ear_autoconf_windows)) == "true"
  let maxima_dir = if windows { "maxima" } else { ".maxima" }
  let base_dir = if home_env.truthy() && init_cl__str(home_env) != "" {
    // use home-env... but not if home-env = c:\, which results in slow
    // startups under windows.
    if init_cl__str(home_env) == "c:\\" {
      "c:\\user\\"
    } else {
      init_cl__str(home_env)
    }
  } else if windows {
    // we have to make a guess
    "c:\\user\\"
  } else {
    "/tmp"
  }
  init_cl__combine([maxima_parse_dirstring(Str(base_dir)), Str(maxima_dir)])
}

///|
fn default_tempdir() -> Value raise {
  let tmpdir_windows = init_cl__getenv("TEMP")
  let tmpdir_posix = init_cl__getenv("TMPDIR")
  let tmpdir_nonstandard1 = init_cl__getenv("TMP")
  let tmpdir_nonstandard2 = init_cl__getenv("TEMPDIR")
  // (string/= tmpdir-windows "") on a NIL TEMP compares "NIL" with "".
  let windows_str = if tmpdir_windows is Nil {
    "NIL"
  } else {
    init_cl__str(tmpdir_windows)
  }
  let dir = if tmpdir_windows.truthy() && init_cl__str(tmpdir_windows) != "" {
    tmpdir_windows
  } else if tmpdir_posix.truthy() && windows_str != "" {
    tmpdir_posix
  } else if tmpdir_nonstandard1.truthy() &&
    init_cl__str(tmpdir_nonstandard1) != "" {
    tmpdir_nonstandard1
  } else if tmpdir_nonstandard2.truthy() &&
    init_cl__str(tmpdir_nonstandard2) != "" {
    tmpdir_nonstandard2
  } else if init_cl__str(symval(q_ear_autoconf_windows)) == "true" {
    // A fallback for windows if everything else has failed
    Str("C:\\Windows\\temp")
  } else {
    // A fallback for the rest of the operating systems
    Str("/tmp")
  }
  maxima_parse_dirstring(dir)
}

///|
fn set_locale_subdir() -> Value raise {
  // Determine *maxima-lang-subdir*
  //   1. from MAXIMA_LANG_SUBDIR environment variable
  //   2. from INTL::*LOCALE* if (1) fails
  let env = init_cl__getenv("MAXIMA_LANG_SUBDIR")
  set(q_ear_maxima_lang_subdir, env) |> ignore
  if env.truthy() {
    return env
  }
  let locale = symval(q_ear_locale)
  let loc = init_cl__str(locale)
  let v : Value = if locale is Nil || loc == "" {
    Nil
  } else if loc == "C" || loc == "POSIX" || loc == "c" || loc == "posix" {
    Nil
  } else {
    let n = string_length(loc)
    let territory = if n > 2 && char_at(loc, 2) == '_' {
      string_downcase(substring(loc, 3, end=5))
    } else {
      ""
    }
    let language = string_downcase(substring(loc, 0, end=2))
    // Set *maxima-lang-subdir* only for known languages.
    if language == "en" {
      Nil
    } else if language == "es" || language == "pt" || language == "de" {
      // Latin-1 aka iso-8859-1 languages
      if language == "pt" && territory == "br" {
        Str(language + "_BR")
      } else {
        Str(language)
      }
    } else if language == "ja" || language == "ru" {
      Str(language)
    } else {
      Nil
    }
  }
  set(q_ear_maxima_lang_subdir, v)
}

///|
/// Set up the default values for $file_search_lisp, $file_search_maxima,
/// $file_search_demo, $file_search_usage, and $file_search_tests.
fn setup_search_lists() -> Value raise {
  // (pathname-type (compile-file-pathname "foo.lisp")) under SBCL.
  let ext = "fasl"
  let lisp_patterns = [ext, "lisp"]
  let maxima_patterns = ["mac", "wxm", "wxmx"]
  let lisp_maxima_patterns = lisp_patterns + maxima_patterns
  let demo_patterns = ["dem", "demo"]
  let usage_patterns = ["usg"]
  let build_search_list = (path_info : Array[(Value, Array[String])]) => {
    let search_path : Array[Value] = []
    for info in path_info {
      for e in info.1 {
        search_path.push(
          Str(init_cl__combine_path([init_cl__str(info.0), "*." + e])),
        )
      }
    }
    make_mlist_l(list(search_path))
  }
  let userdir = symval(q_ear_maxima_userdir)
  let sharedir = symval(q_ear_maxima_sharedir)
  let srcdir = symval(q_ear_maxima_srcdir)
  let topdir = symval(q_ear_maxima_topdir)
  let star2 = (d : Value) => init_cl__combine([d, Str("**")])
  set(
    q_d_file_search_lisp,
    build_search_list([
      (star2(userdir), lisp_patterns),
      // sharedir should only have lisp files.
      (star2(sharedir), ["lisp"]),
      (srcdir, lisp_patterns),
      (topdir, lisp_patterns),
    ]),
  )
  |> ignore
  set(
    q_d_file_search_maxima,
    build_search_list([
      (star2(userdir), maxima_patterns),
      // sharedir should only have mac files.
      (star2(sharedir), ["mac"]),
      (srcdir, ["mac"]),
      (topdir, ["mac"]),
    ]),
  )
  |> ignore
  set(
    q_d_file_search_demo,
    build_search_list([
      (star2(sharedir), demo_patterns),
      (symval(q_ear_maxima_demodir), demo_patterns),
    ]),
  )
  |> ignore
  set(
    q_d_file_search_usage,
    build_search_list([
      (star2(sharedir), usage_patterns),
      (symval(q_ear_maxima_docdir), usage_patterns),
    ]),
  )
  |> ignore
  set(
    q_d_file_search_tests,
    build_search_list([(symval(q_ear_maxima_testsdir), lisp_maxima_patterns)]),
  )
}

///|
fn init_cl__set_initial_value(var_ : Value, v : Value) -> Unit raise {
  let tbl = symval(q_ear_variable_initial_values)
  if hash_table_p(tbl) {
    sethash(var_, tbl, v) |> ignore
  }
}

///|
fn set_pathnames() -> Value raise {
  let mut maxima_prefix_env = init_cl__getenv("MAXIMA_PREFIX")
  let maxima_layout_autotools_env = init_cl__getenv("MAXIMA_LAYOUT_AUTOTOOLS")
  let maxima_userdir_env = init_cl__getenv("MAXIMA_USERDIR")
  let maxima_docprefix_env = init_cl__getenv("MAXIMA_DOC_PREFIX")
  let maxima_tempdir_env = init_cl__getenv("MAXIMA_TEMPDIR")
  let maxima_objdir_env = init_cl__getenv("MAXIMA_OBJDIR")
  let maxima_htmldir_env = init_cl__getenv("MAXIMA_HTMLDIR")
  // MAXIMA_DIRECTORY is a deprecated substitute for MAXIMA_PREFIX
  if maxima_prefix_env is Nil {
    maxima_prefix_env = init_cl__getenv("MAXIMA_DIRECTORY")
  }
  if maxima_prefix_env.truthy() {
    set(q_ear_maxima_prefix, maxima_prefix_env) |> ignore
  } else {
    set(
      q_ear_maxima_prefix,
      maxima_parse_dirstring(symval(init_cl__q_autoconf_prefix)),
    )
    |> ignore
  }
  if maxima_layout_autotools_env.truthy() {
    set(
      q_ear_maxima_layout_autotools,
      lbool(string_equal(init_cl__str(maxima_layout_autotools_env), "true")),
    )
    |> ignore
  } else {
    set(
      q_ear_maxima_layout_autotools,
      lbool(
        string_equal(
          init_cl__str(symval(init_cl__q_maxima_default_layout_autotools)),
          "true",
        ),
      ),
    )
    |> ignore
  }
  if symval(q_ear_maxima_layout_autotools).truthy() {
    set_pathnames_with_autoconf(maxima_prefix_env, maxima_docprefix_env)
    |> ignore
  } else {
    set_pathnames_without_autoconf(maxima_prefix_env, maxima_docprefix_env)
    |> ignore
  }
  // Port addition: MAXIMA_SHAREDIR overrides the share directory.
  let maxima_sharedir_env = init_cl__getenv("MAXIMA_SHAREDIR")
  if maxima_sharedir_env.truthy() {
    set(q_ear_maxima_sharedir, maxima_parse_dirstring(maxima_sharedir_env))
    |> ignore
  }
  if maxima_userdir_env.truthy() {
    set(q_ear_maxima_userdir, maxima_parse_dirstring(maxima_userdir_env))
    |> ignore
  } else {
    set(q_ear_maxima_userdir, default_userdir()) |> ignore
  }
  if maxima_tempdir_env.truthy() {
    set(q_ear_maxima_tempdir, maxima_parse_dirstring(maxima_tempdir_env))
    |> ignore
  } else {
    set(q_ear_maxima_tempdir, default_tempdir()) |> ignore
  }
  // Default *MAXIMA-OBJDIR* is <userdir>/binary/binary-<foo>lisp. Append
  // binary-<foo>lisp whether objdir is the default or obtained from
  // environment.
  let base = if maxima_objdir_env.truthy() {
    init_cl__str(maxima_parse_dirstring(maxima_objdir_env))
  } else {
    init_cl__str(symval(q_ear_maxima_userdir)) + "/binary"
  }
  set(
    q_ear_maxima_objdir,
    Str(
      base +
      "/" +
      init_cl__str(maxima_version1()) +
      "/" +
      init_cl__str(symval(q_ear_maxima_lispname)) +
      "/" +
      init_cl__str(lisp_implementation_version1()),
    ),
  )
  |> ignore
  if maxima_htmldir_env.truthy() {
    set(
      q_ear_maxima_htmldir,
      init_cl__combine([
        maxima_parse_dirstring(maxima_htmldir_env),
        Str("doc"),
        Str("info"),
      ]),
    )
    |> ignore
  }
  // Assign initial values for Maxima shadow variables
  set(q_d_maxima_userdir, symval(q_ear_maxima_userdir)) |> ignore
  init_cl__set_initial_value(q_d_maxima_userdir, symval(q_ear_maxima_userdir))
  set(q_d_maxima_tempdir, symval(q_ear_maxima_tempdir)) |> ignore
  init_cl__set_initial_value(q_d_maxima_tempdir, symval(q_ear_maxima_tempdir))
  set(q_d_maxima_objdir, symval(q_ear_maxima_objdir)) |> ignore
  init_cl__set_initial_value(q_d_maxima_objdir, symval(q_ear_maxima_objdir))
  setup_search_lists() |> ignore
  // If *maxima-lang-subdir* is not nil test whether corresponding info
  // directory with some data really exists. If not this probably means
  // that required language pack wasn't installed and we reset
  // *maxima-lang-subdir* to nil.
  let lang = symval(q_ear_maxima_lang_subdir)
  if lang.truthy() &&
    !probe_file(
      init_cl__combine_path([
        init_cl__str(symval(q_ear_maxima_infodir)),
        init_cl__str(lang),
        "maxima-index.lisp",
      ]),
    ) {
    set(q_ear_maxima_lang_subdir, Nil) |> ignore
  }
  Nil
}

///|
fn list_avail_action() -> Value raise {
  if init_cl__getenv("MAXIMA_LOCAL").truthy() {
    // We're running maxima-local in the src tree.
    let mut maxima_dir = init_cl__getenv("MAXIMA_PREFIX")
    // maxima-local MUST define MAXIMA_PREFIX envvar so we know where we are.
    if maxima_dir is Nil {
      format(
        t,
        "Environment variable MAXIMA_PREFIX not defined by maxima-local.~%Cannot list available versions.  Exiting.~%",
        [],
      )
      |> ignore
      bye() |> ignore
    }
    maxima_dir = init_cl__combine([maxima_dir, Str("src")])
    format(t, "Available versions:~%", []) |> ignore
    for p in get_dirs(Str(init_cl__str(maxima_dir) + "/*")).iter() {
      // Match "src/binary-([^/]+)".
      let name = init_cl__str(p)
      let i = string_search("src/binary-", name)
      if i >= 0 {
        let rest = substring(name, i + 11)
        let mut j = 0
        while j < string_length(rest) && char_at(rest, j) != '/' {
          j += 1
        }
        if j > 0 {
          format(t, "version ~a, lisp ~a~%", [
            symval(q_ear_autoconf_version),
            Str(substring(rest, 0, end=j)),
          ])
          |> ignore
        }
      }
    }
  } else {
    let verpkg = init_cl__getenv("MAXIMA-VERPKGLIBDIR")
    let mut maxima_verpkglibdir = if verpkg.truthy() {
      init_cl__str(verpkg)
    } else if init_cl__getenv("MAXIMA_PREFIX").truthy() {
      init_cl__combine_path([
        init_cl__str(init_cl__getenv("MAXIMA_PREFIX")),
        "lib",
        init_cl__str(symval(init_cl__q_autoconf_package)),
        init_cl__str(symval(q_ear_autoconf_version)),
      ])
    } else {
      init_cl__combine_path([
        init_cl__str(maxima_parse_dirstring(symval(init_cl__q_autoconf_libdir))),
        init_cl__str(symval(init_cl__q_autoconf_package)),
        init_cl__str(symval(q_ear_autoconf_version)),
      ])
    }
    format(t, "Available versions:~%", []) |> ignore
    if !maxima_verpkglibdir.has_suffix("/") {
      maxima_verpkglibdir = maxima_verpkglibdir + "/"
    }
    for version in get_dirs(unix_like_dirname(Str(maxima_verpkglibdir))).iter() {
      for lisp in get_dirs(version).iter() {
        let lisp_string = init_cl__str(unix_like_basename(lisp))
        if string_search("binary-", lisp_string) >= 0 {
          format(t, "version ~a, lisp ~a~%", [
            unix_like_basename(version),
            Str(substring(lisp_string, 7)),
          ])
          |> ignore
        }
      }
    }
  }
  bye()
}

// ---- Command-line options (cl-option structures of command-line.lisp).

///|
fn process_maxima_args(
  input_stream : Value,
  batch_flag : Value,
) -> (Value, Value) raise {
  // Note: The current option parsing code expects every short option to
  // have an equivalent long option.  No check is made for this, so please
  // make sure this holds.  Or change the code in process-args in
  // command-line.lisp.
  //
  // The help strings should not have any special manual formatting but
  // extraneous white space is ok.  They are automatically printed with
  // extraneous whitespace (including newlines) removed and lines wrapped
  // neatly.
  let input_stream = Ref(input_stream)
  let batch_flag = Ref(batch_flag)
  let opts : Array[Value] = []
  let opt = (
    names : Array[String],
    argument : String?,
    action : ((Array[Value]) -> Value raise)?,
    help : String,
  ) => opts.push(
    cmdline__make_cl_option(
      names=list(names.map(n => Str(n))),
      argument=match argument {
        Some(a) => Str(a)
        None => Nil
      },
      action=match action {
        Some(f) => lfunc("cl-option-action", f)
        None => Nil
      },
      help_string=Str(help),
    ),
  )
  let str_arg = (args : Array[Value]) => lstring(args[0])
  opt(
    ["-b", "--batch"],
    Some("<file>"),
    Some(args => {
      input_stream.val = make_string_input_stream(
        format_to_string("batch(\"~a\");", [Str(str_arg(args))]),
      )
      batch_flag.val = q_kw_batch
      Nil
    }),
    "Process maxima file <file> in batch mode.",
  )
  opt(
    ["--batch-lisp"],
    Some("<file>"),
    Some(args => {
      input_stream.val = make_string_input_stream(
        format_to_string(":lisp (with-compilation-unit nil (load \"~a\"));", [
          Str(str_arg(args)),
        ]),
      )
      batch_flag.val = q_kw_batch
      Nil
    }),
    "Process lisp file <file> in batch mode.",
  )
  opt(
    ["--batch-string"],
    Some("<string>"),
    Some(args => {
      set(q_d_batch_answers_from_file, t) |> ignore
      input_stream.val = make_string_input_stream(str_arg(args))
      // see RETRIEVE in macsys.lisp
      set(standard_input, input_stream.val) |> ignore
      // (make-two-way-stream input-stream (make-string-output-stream)):
      // the port has no two-way streams; queries read the input stream.
      set(q_ear_query_io, input_stream.val) |> ignore
      batch_flag.val = q_kw_batch
      Nil
    }),
    "Process maxima command(s) <string> in batch mode.",
  )
  opt(
    ["-d", "--directories"],
    None,
    Some(_ => {
      print_directories() |> ignore
      d_quit()
    }),
    "Display maxima internal directory information.",
  )
  opt(["--disable-readline"], None, Some(_ => Nil), "Disable readline support.")
  opt(
    ["-g", "--enable-lisp-debugger"],
    None,
    Some(_ => set(q_ear_debugger_hook, Nil)),
    "Enable underlying lisp debugger.",
  )
  opt(
    ["-h", "--help"],
    None,
    Some(_ => {
      format(t, "usage: maxima [options]~%", []) |> ignore
      cmdline_list_cl_options(symval(q_ear_maxima_commandline_options))
      |> ignore
      bye()
    }),
    "Display this usage message.",
  )
  opt(
    ["--userdir"],
    Some("<directory>"),
    None,
    "Use  <directory> for user directory (default is %USERPROFILE%/maxima for Windows, and $HOME/.maxima for other operating systems).",
  )
  let initmac = init_cl__str(symval(q_ear_maxima_initmac))
  opt(
    ["--init"],
    Some("<file>"),
    Some(args => {
      // Strip off everything before the last "/" (or "\"). Then strip off
      // everything after the last dot.
      let file = str_arg(args)
      let n = string_length(file)
      let mut dot = -1
      let mut dir = -1
      for i in 0..<n {
        let c = char_at(file, i)
        if c == '.' {
          dot = i
        }
        if c == '/' || c == '\\' {
          dir = i
        }
      }
      let start = if dir >= 0 { dir + 1 } else { 0 }
      let base = if dot >= 0 {
        substring(file, start, end=dot)
      } else {
        substring(file, start)
      }
      if dot >= 0 || dir >= 0 {
        mtell(
          list([
            Str("Warning: Using basename ~S for init files instead of ~S"),
            Str(base),
            Str(file),
          ]),
        )
        |> ignore
      }
      set(q_ear_maxima_initmac, Str(base + ".mac")) |> ignore
      set(q_ear_maxima_initlisp, Str(base + ".lisp"))
    }),
    format_to_string(
      "Set the base name of the Maxima & Lisp initialization files (default is ~s.)  The last extension and any directory parts are removed to form the base name.  The resulting files, <base>.mac and <base>.lisp are only searched for in userdir (see --userdir option).  This may be specified for than once, but only the last is used.",
      [Str(substring(initmac, 0, end=string_length(initmac) - 4))],
    ),
  )
  opt(
    ["-l", "--lisp"],
    Some("<lisp>"),
    None,
    "Use lisp implementation <lisp>.",
  )
  opt(
    ["--list-avail"],
    None,
    Some(_ => list_avail_action()),
    "List the installed version/lisp combinations.",
  )
  // --preload-lisp is left for backward compatibility.  We no longer
  // distinguish between mac and lisp files.  Any file type that $LOAD
  // supports is acceptable.  "--init-mac" and "--init-lisp" are now also
  // (deprecated) aliases for --preload.
  opt(
    ["-p", "--preload", "--preload-lisp", "--init-mac", "--init-lisp"],
    Some("<file>"),
    Some(args => {
      // $loadprint T so we can see the file being loaded; unless
      // *maxima-quiet* is T.
      with_special(
        q_d_loadprint,
        lbool(!symval(q_ear_maxima_quiet).truthy()),
        // If there's an error, catch
        () => catch_tag(q_macsyma_quit, () => d_load(args[0])),
      )
    }),
    "Preload <file>, which may be any file time accepted by\n        Maxima's LOAD function.  The <file> is loaded before any other\n        system initialization is done.  This will be searched for in\n        the locations given by file_search_maxima and\n        file_search_lisp.  This can be specified multiple times to\n        load multiple files. The equivalent options --preload-lisp,\n        --init-mac, and --init-lisp are deprecated.",
  )
  opt(
    ["-q", "--quiet"],
    None,
    Some(_ => set(q_ear_maxima_quiet, t)),
    "Suppress Maxima start-up message.",
  )
  opt(
    ["-Q", "--quit-on-error"],
    None,
    Some(_ => set(q_ear_quit_on_error, t)),
    "Quit, and return an exit code 1, when Maxima encounters an error.",
  )
  opt(
    ["-r", "--run-string"],
    Some("<string>"),
    Some(args => {
      set(q_ear_maxima_run_string, t) |> ignore
      input_stream.val = make_string_input_stream(str_arg(args))
      batch_flag.val = Nil
      Nil
    }),
    "Process maxima command(s) <string> in interactive mode.",
  )
  opt(
    ["-s", "--server"],
    Some("<port>"),
    Some(args => {
      start_client(init_cl__parse_integer(args[0])) |> ignore
      input_stream.val = symval(standard_input)
      Nil
    }),
    "Connect Maxima to server on <port>.",
  )
  opt(
    ["--suppress-input-echo"],
    None,
    Some(_ => set(q_ear_suppress_input_echo, t)),
    "Do not print input expressions when processing noninteractively.",
  )
  opt(
    ["-u", "--use-version"],
    Some("<version>"),
    None,
    "Use maxima version <version>.",
  )
  opt(
    ["-v", "--verbose"],
    None,
    None,
    "Display lisp invocation in maxima wrapper script.",
  )
  opt(
    ["--version"],
    None,
    Some(_ => {
      format(t, "Maxima ~a~%", [symval(q_ear_autoconf_version)]) |> ignore
      d_quit()
    }),
    "Display the default installed version.",
  )
  opt(
    ["--very-quiet"],
    None,
    Some(_ => {
      set(q_ear_maxima_quiet, t) |> ignore
      set(q_ear_display_labels_p, Nil) |> ignore
      set(q_ear_verify_html_index, Nil) |> ignore
      set(q_ear_warn_deprecated_defmvar_options, Nil)
    }),
    "Suppress expression labels, Maxima start-up message and verification of html index.",
  )
  opt(
    ["--very-very-quiet"],
    None,
    Some(_ => {
      set(q_ear_maxima_quiet, t) |> ignore
      set(q_ear_display_labels_p, Nil) |> ignore
      set(q_ear_verify_html_index, Nil) |> ignore
      set(q_d_ttyoff, t) |> ignore
      set(q_ear_warn_deprecated_defmvar_options, Nil)
    }),
    "In addition to --very-quiet, suppress most printed output by setting TTYOFF to T.",
  )
  opt(
    ["-X", "--lisp-options"],
    Some("<Lisp options>"),
    Some(args => {
      if !symval(q_ear_maxima_quiet).truthy() {
        format(t, "Lisp options: ~A", [list(args)]) |> ignore
      }
      Nil
    }),
    "Options to be given to the underlying Lisp",
  )
  opt(
    ["--no-init", "--norc"],
    None,
    Some(_ => set(q_ear_maxima_load_init_files, Nil)),
    "Do not load the init file(s) on startup",
  )
  opt(
    ["--verify-html-index"],
    None,
    Some(_ => set(q_ear_verify_html_index, t)),
    "Verify on startup that the set of html topics is consistent with text topics.",
  )
  set(q_ear_maxima_commandline_options, list(opts)) |> ignore
  cmdline_process_args(
    cmdline_get_application_args(),
    symval(q_ear_maxima_commandline_options),
  )
  |> ignore
  (input_stream.val, batch_flag.val)
}

///|
/// (parse-integer string): the integer the whole string spells.
fn init_cl__parse_integer(s : Value) -> Value raise {
  let str = lstring(s)
  match parse_integer(string_trim(" \t\n", str)) {
    Some(v) => v
    None =>
      raise LispError::SimpleError(
        format_to_string("junk in string ~S", [Str(str)]),
      )
  }
}

///|
/// Delete all files *temp-files-list* contains. The port's runtime cannot
/// delete files, so the entries are only checked.
fn delete_temp_files() -> Value raise {
  let tbl = symval(q_ear_temp_files_list)
  if hash_table_p(tbl) {
    maphash(
      (filename, _param) => {
        let name = init_cl__str(filename)
        if probe_file(name) && !apparently_a_directory_p(filename).truthy() {
          // (delete-file file): not available in the port's runtime.
          ()
        }
      },
      tbl,
    )
  }
  Nil
}

///|
/// Run Maxima in its own package.
fn run() -> (Value, Value) raise {
  initialize_runtime_globals() |> ignore
  let mut input_stream = symval(standard_input)
  let mut batch_flag : Value = Nil
  defer delete_temp_files() |> ignore
  catch_tag(q_to_lisp, () => {
    let (s, b) = process_maxima_args(input_stream, batch_flag)
    input_stream = s
    batch_flag = b
    // Whether the console is used interactively (INTERACTIVE-STREAM-P of
    // the input, which the display code consults): not in batch mode, nor
    // when the input is a socket (-s).
    displa__interactive.val = batch_flag is Nil &&
      !boundp(q_ear_socket_connection)
    if symval(q_ear_verify_html_index).truthy() {
      d_verify_html_index() |> ignore
    }
    load_user_init_file() |> ignore
    // (loop (with-simple-restart (macsyma-quit "Maxima top-level")
    //         (macsyma-top-level input-stream batch-flag)))
    // MACSYMA-TOP-LEVEL ends by quitting; a normal return ends the loop.
    macsyma_top_level(input_stream=input_stream, batch_flag~)
  })
  |> ignore
  (Nil, Nil)
}

///|
/// If the user specified an init file, use it. If not, use the default init
/// file in the userdir directory, but only if it exists.
fn load_user_init_file() -> Value raise {
  let maybe_load_init_file = (loader : (Value) -> Value raise, default_init : Value) => {
    let init_file = init_cl__combine([symval(q_ear_maxima_userdir), default_init])
    if symval(q_ear_maxima_load_init_files).truthy() &&
      file_exists_p(init_file).truthy() {
      format(t, "Loading ~A~%", [init_file]) |> ignore
      loader(init_file)
    } else {
      Nil
    }
  }
  // Catch errors from $load or $batchload which can throw to 'macsyma-quit.
  catch_tag(q_macsyma_quit, () => {
    maybe_load_init_file(f => d_load(f), symval(q_ear_maxima_initlisp))
    |> ignore
    maybe_load_init_file(f => d_batchload(f), symval(q_ear_maxima_initmac))
  })
}

///|
fn initialize_runtime_globals() -> Value raise {
  disable_some_lisp_warnings() |> ignore
  set(
    q_ear_debugger_hook,
    lfunc("maxima-lisp-debugger", args => maxima_lisp_debugger(
      arg(args, 0),
      arg(args, 1),
    )),
  )
  |> ignore
  // Set *print-length* and *print-level* to some reasonable values so that
  // normal Lisp structure is shown, but prevent typical circular structures
  // from hanging Lisp.
  set(q_ear_print_circle, Nil) |> ignore
  set(q_ear_print_length, Fix(100L)) |> ignore
  set(q_ear_print_level, Fix(15L)) |> ignore
  // (initialize-real-and-run-time) is defined inside a LET in macsys.lisp;
  // call it through its function cell.
  let irt = sym("initialize-real-and-run-time")
  if fboundp(irt) {
    funcall(irt, []) |> ignore
  }
  intl_setlocale() |> ignore
  set_locale_subdir() |> ignore
  adjust_character_encoding() |> ignore
  set_pathnames() |> ignore
  catch_tag(q_return_from_debugger, () => info_load_primary_index()) |> ignore
  if boundp(q_ear_maxima_prefix) {
    let dir = init_cl__str(symval(q_ear_maxima_prefix)) +
      (if symval(q_ear_maxima_layout_autotools).truthy() {
        "/share/locale/"
      } else {
        "/locale/"
      })
    set(
      q_ear_locale_directories,
      cons(Str(dir), symval(q_ear_locale_directories)),
    )
    |> ignore
  }
  // Set up $browser for displaying help in browser.
  if boundp(q_ear_autoconf_windows) &&
    string_equal(init_cl__str(symval(q_ear_autoconf_windows)), "true") {
    // "start" will open the default browser in Windows.
    set(q_d_browser, Str("start")) |> ignore
  } else if boundp(q_ear_autoconf_host) {
    let host = init_cl__str(symval(q_ear_autoconf_host))
    if string_search("darwin", host) >= 0 {
      // "open" will open the default browser in MacOS.
      set(q_d_browser, Str("open")) |> ignore
    } else if string_search("linux", string_downcase(host)) >= 0 {
      // "xdg-open" will open the default browser in Linux.
      set(q_d_browser, Str("xdg-open")) |> ignore
    }
  }
  // Make reset() restore this value rather than the DEFMVAR default.
  init_cl__set_initial_value(q_d_browser, symval(q_d_browser))
  set(q_p_e_val, mget(q_d__pcte, q_d_numer)) |> ignore
  // Initialize *bigprimes* here instead of globals.lisp because we need the
  // NEXT-PRIME function.
  let primes = Collector::new()
  let mut p = ash(most_positive_fixnum, -1)
  for _ in 0..<20 {
    p = next_prime(num_sub(p, Fix(1L)), Fix(-1L))
    primes.add(p)
  }
  set(q_ear_bigprimes, primes.result()) |> ignore
  // Initialize *alpha and $pointbound. Since both of these are defmvars, we
  // need to set the initial values appropriately too so they get reset
  // correctly.
  set(q_n_staralpha, car(symval(q_ear_bigprimes))) |> ignore
  init_cl__set_initial_value(q_n_staralpha, car(symval(q_ear_bigprimes)))
  set(q_d_pointbound, symval(q_n_staralpha)) |> ignore
  init_cl__set_initial_value(q_d_pointbound, symval(q_n_staralpha))
  initialize_atan2_hashtable() |> ignore
  Nil
}

///|
fn adjust_character_encoding() -> Value raise {
  // The port's streams are always UTF-8.
  Nil
}

///|
/// The port has no Lisp read-eval-print loop.
fn d_to_lisp() -> Value raise {
  merr("to_lisp: not supported in this port", [])
}

///|
fn to_maxima() -> Value raise {
  throw_tag(q_to_maxima, t)
}

///|
/// Evaluate FORM, returning whatever it returns but adjust ***, **, *, +++,
/// ++, +, ///, //, /, and -. Lisp EVAL is not available in the port.
fn interactive_eval(form : Value) -> Value raise {
  ignore(form)
  merr("interactive-eval: Lisp evaluation is not supported in this port", [])
}

///|
fn maxima_read_eval_print_loop() -> Value raise {
  merr("to_lisp: the Lisp read-eval-print loop is not supported in this port", [])
}

///|
fn maxima_lisp_debugger_repl(
  condition : Value,
  me_or_my_encapsulation : Value,
) -> Value raise {
  ignore(me_or_my_encapsulation)
  format(t, "~&Maxima encountered a Lisp error:~%~% ~A", [condition]) |> ignore
  format(
    t,
    "~&~%Automatically continuing.~%To re-enable the Lisp debugger set *debugger-hook* to nil.~%",
    [],
  )
  |> ignore
  finish_output()
  throw_tag(q_to_maxima_repl, t)
}

///|
fn d_help(dummy : Value) -> Value raise {
  ignore(dummy)
  symval(q_d_help)
}

///|
/// Builds an optimized version of the symbol property list PLIST,
/// distinguishing between symbols that denote an operator, e.g. 'MTIMES,
/// and those that don't, e.g. '$%PI. The properties on the list are
/// reordered in such a way that those accessed most are close to the front,
/// which speeds up GET. For small enough property lists (see
/// *PLIST-PAD-CUTOFF*), absent properties are explicitly added with a value
/// of NIL.
fn optimized_plist(plist : Value) -> Value raise {
  if plist is Nil {
    return plist
  }
  let simplifier = getf(plist, q_operators)
  let keys = if simplifier.truthy() {
    list([q_operators, q_distribute_over, q_opers, q_msimpind, q_mprops, q_noun])
  } else {
    list([q_mprops, q_mfexpr_star, q_noun, q_translated_mmacro, q_translated])
  }
  let mut front : Value = Nil
  let mut tail : Value = Nil
  let mut real_pairs = 0
  let mut rest_ = plist
  while rest_.truthy() {
    let key = car(rest_)
    let val = cadr(rest_)
    if !(val is Nil && memq(key, keys).truthy()) {
      real_pairs += 1
      if memq(key, keys) is Nil {
        tail = cons(key, tail)
        tail = cons(val, tail)
      }
    }
    rest_ = cddr(rest_)
  }
  tail = nreverse(tail)
  let pad = simplifier.truthy() ||
    real_pairs > to_int(symval(q_ear_plist_pad_cutoff))
  for key in reverse(keys).iter() {
    let val = getf(plist, key)
    if val.truthy() || pad {
      front = list_star([key, val, front])
    }
  }
  nconc(front, tail)
}

///|
/// Optimizes a symbol's property list by moving properties that are
/// frequently accessed by the simplifier to the front of the list (unless
/// it's empty), adding an explicit nil entry for absent properties.
fn optimize_symbol_plist(s : Value) -> Value raise {
  set_symbol_plist(s, optimized_plist(symbol_plist(s)))
}

///|
/// Return a pathname string such that subdirs is a subdirectory of
/// maxima_objdir.
fn maxima_objdir(subdirs : Value) -> Value raise {
  let parts = [symval(q_ear_maxima_objdir)]
  for d in subdirs.iter() {
    parts.push(d)
  }
  init_cl__combine(parts)
}

///|
/// Return the Maxima object directory stripped of the subdirectories that
/// are specific to the Maxima version, Lisp implementation and Lisp
/// version. If the user has overridden $maxima_objdir manually, return the
/// directory itself. A trailing slash is always added, if necessary.
fn maxima_objdir_base() -> Value raise {
  let objdir = init_cl__str(symval(q_ear_maxima_objdir))
  let path = init_cl__combine_path([objdir, ""]) // ensure trailing slash
  let tbl = symval(q_ear_variable_initial_values)
  let initial = if hash_table_p(tbl) {
    gethash(q_d_maxima_objdir, tbl)
  } else {
    Nil
  }
  if stringp(initial) && objdir == init_cl__str(initial) {
    // *MAXIMA-OBJDIR* has its default value: strip the last 3
    // subdirectories
    let comps = path.split("/").map(v => v.to_string()).collect()
    // comps ends with "" (trailing slash); drop the 3 directories before it
    let dirs = comps[0:comps.length() - 1].to_array()
    let keep = if dirs.length() > 3 {
      dirs[0:dirs.length() - 3].to_array()
    } else {
      dirs[0:1].to_array()
    }
    Str(keep.join("/") + "/")
  } else {
    // User override: return the path as-is (with ensured trailing slash)
    Str(path)
  }
}

///|
/// Return the directory part of *load-pathname*.
fn maxima_load_pathname_directory() -> Value raise {
  match symval(init_cl__q_load_pathname) {
    Str(path) => {
      let mut k = -1
      for i in 0..<string_length(path) {
        if char_at(path, i) == '/' {
          k = i
        }
      }
      Str(if k >= 0 { substring(path, 0, end=k + 1) } else { "" })
    }
    _ => Nil
  }
}

///|
fn init_init_cl() -> Unit raise {
  // Autoconf variables for the port's (source-tree) layout.
  defvar_init(init_cl__q_autoconf_prefix, Str(init_cl__default_prefix))
  defvar_init(init_cl__q_autoconf_package, Str("maxima"))
  defvar_init(q_ear_autoconf_version, Str("5.50post"))
  defvar_init(init_cl__q_autoconf_libdir, Str(init_cl__default_prefix + "/lib"))
  defvar_init(
    init_cl__q_autoconf_datadir,
    Str(init_cl__default_prefix + "/share"),
  )
  defvar_init(
    init_cl__q_autoconf_infodir,
    Str(init_cl__default_prefix + "/doc/info"),
  )
  defvar_init(q_ear_autoconf_host, Str(""))
  defvar_init(init_cl__q_autoconf_win32, Str("false"))
  defvar_init(q_ear_autoconf_windows, Str("false"))
  defvar_init(init_cl__q_maxima_default_layout_autotools, Str("false"))
  defvar_init(init_cl__q_load_pathname, Nil)
  // (defmvar $maxima_userdir ...) etc. assign SHADOW-STRING-ASSIGNMENT.
  with_special(q_context, q_d_global, () => {
    for x in [
      q_d__pctpi,
      q_d__pcti,
      q_d__pcte,
      q_d__pctphi,
      q_p_i,
      q_d__pctgamma,
      q_d__pctcatalan, // numeric constants
      q_d_inf,
      q_d_minf,
      q_d_und,
      q_d_ind,
      q_d_infinity, // pseudo-constants
      q_d_zeroa,
      q_d_zerob, // infinitesimals
      t,
      Value::Nil, // logical constants (Maxima names: true, false)
    ] {
      kind(x, q_d_constant) |> ignore
      setf_get(x, q_sysconst, t) |> ignore
    }
    Value::Nil
  })
  |> ignore
  // Build-time DECLARE calls probe the database with TRUEP and FALSEP, and
  // the last search's transient +LABS/-LABS marks are still on the probed
  // symbols' property lists. Sweep them now, so that they don't get copied
  // into *BUILTIN-SYMBOL-PROPS* below.
  clear() |> ignore
  // Now that all of maxima has been loaded, define the various lists and
  // hashtables of builtin symbols and values.
  defvar_init(q_ear_builtin_symbol_props, make_hash_table())
  defvar_init(q_ear_builtin_symbol_values, make_hash_table())
  let props_tbl = symval(q_ear_builtin_symbol_props)
  for sy in all_symbols() {
    let name = sy.name
    if name != "" &&
      (char_at(name, 0) == '$' || char_at(name, 0) == '%') {
      let s = Value::Sym(sy)
      set(q_ear_builtin_symbols, cons(s, symval(q_ear_builtin_symbols)))
      |> ignore
      sethash(s, props_tbl, copy_tree(symbol_plist(s))) |> ignore
    }
  }
  // Also store the property lists for symbols associated with operators;
  // e.g. MPLUS, MTIMES, etc. Here we find them via the MHEADER property,
  // which is used by the parser.
  for sy in all_symbols() {
    let h = get(Value::Sym(sy), q_mheader)
    if h.truthy() {
      let s1 = first(h)
      if gethash(s1, props_tbl) is Nil {
        set(q_ear_builtin_symbols, cons(s1, symval(q_ear_builtin_symbols)))
        |> ignore
        sethash(s1, props_tbl, copy_tree(symbol_plist(s1))) |> ignore
      }
    }
  }
  // Initialize assume database for $%pi, $%e, etc
  for c in symval(q_ear_builtin_numeric_constants).iter() {
    initialize_numeric_constant(c) |> ignore
  }
  set(q_p_e_val, mget(q_d__pcte, q_d_numer)) |> ignore
  // Initialize assume database for $zeroa and $zerob
  for c in [q_d_zeroa, q_d_zerob] {
    initialize_zeroab(c) |> ignore
  }
  // Make sure derivatives defined by DEFGRAD are simplified and that the
  // variables and derivatives are consistent.
  process_defgrad() |> ignore
  // Optimize the property lists of built-in symbols for faster access, also
  // the ones stored in *BUILTIN-SYMBOL-PROPS*.
  for s in symval(q_ear_builtin_symbols).iter() {
    optimize_symbol_plist(s) |> ignore
    let saved = gethash(s, props_tbl)
    if saved.truthy() {
      sethash(s, props_tbl, optimized_plist(saved)) |> ignore
    }
  }
  for s in symval(q_ear_builtin_symbols).iter() {
    if boundp(s) {
      set(
        q_ear_builtin_symbols_with_values,
        cons(s, symval(q_ear_builtin_symbols_with_values)),
      )
      |> ignore
    }
  }
  let values_tbl = symval(q_ear_builtin_symbol_values)
  for s in symval(q_ear_builtin_symbols_with_values).iter() {
    sethash(s, values_tbl, symval(s)) |> ignore
  }
  set(q_ear_builtin__dolprops, copy_list(symval(q_d_props))) |> ignore
  set(q_ear_builtin__dolrules, copy_list(symval(q_d_rules))) |> ignore
}
