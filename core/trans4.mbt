// Port of src/trans4.lisp: translation properties for various operators,
// ".", "^^", some functions such as GAMMA, and the rule translators.

///|
/// DEF%TR MNCTIMES
fn trans4__tr_mnctimes(form : Value) -> Value raise {
  let form = tr_args(cdr(form))
  if length(form) == 2 {
    cons(q_d_any, cons(q_ncmul2, form))
  } else {
    list4(q_d_any, q_ncmuln, cons(q_list, form), Nil)
  }
}

///|
/// DEF%TR MNCEXPT
fn trans4__tr_mncexpt(form : Value) -> Value raise {
  cons(q_d_any, cons(q_ncpower, tr_args(cdr(form))))
}

///|
/// DEF%TR $REMAINDER
fn trans4__tr_remainder(form : Value) -> Value raise {
  let n = tr_nargs_check(form, args_p=cons(Fix(2L), Nil))
  let tr_args = mapcar(x => translate(x), cdr(form))
  if num_eq(n, Fix(2L)) &&
    eq(caar(tr_args), q_d_fixnum) &&
    eq(car(cadr(tr_args)), q_d_fixnum) {
    cons(q_d_fixnum, list3(q_rem, cdr(car(tr_args)), cdr(cadr(tr_args))))
  } else {
    call_and_simp(q_d_any, q_d_remainder, mapcar(x => cdr(x), tr_args))
  }
}

///|
/// DEF%TR $BETA
fn trans4__tr_beta(form : Value) -> Value raise {
  cons(
    q_d_any,
    list2(
      q_simplify,
      cons(q_list, cons(transl__quote(list1(q_d_beta)), tr_args(cdr(form)))),
    ),
  )
}

///|
/// DEF%TR MFACTORIAL
fn trans4__tr_mfactorial(form : Value) -> Value raise {
  let form = translate(cadr(form))
  if eq(car(form), q_d_fixnum) {
    cons(q_d_number, list2(q_factorial, cdr(form)))
  } else {
    cons(
      q_d_any,
      list2(
        q_simplify,
        list3(q_list, transl__quote(list1(q_mfactorial)), cdr(form)),
      ),
    )
  }
}

///|
/// YUK-SU-META-PROP
fn yuk_su_meta_prop(f : Value, form : Value) -> Value raise {
  let bs = bind_all([(q_meta_prop_p, t), (q_meta_prop_l, Nil)])
  defer unbind_all(bs)
  funcall(f, [cdr(form)]) |> ignore
  cons(
    q_d_any,
    cons(
      q_progn,
      mapcar(x => patch_up_meval_in_fset(x), nreverse(symval(q_meta_prop_l))),
    ),
  )
}

///|
/// DEF%TR $MATCHDECLARE
fn trans4__tr_matchdeclare(form : Value) -> Value raise {
  let mut vars : Value = Nil
  let mut l = cdr(form)
  while l is Cons(_) {
    if atom(car(l)) {
      vars = cons(car(l), vars)
    } else if eq(caaar(l), q_mlist) {
      vars = append(cdar(l), vars)
    }
    l = cddr(l)
  }
  let defs = mapcar(
    var_ => dtranslate(
      list4(
        list1(q_d_define_variable),
        var_,
        list2(list1(q_mquote), var_),
        q_d_any,
      ),
    ),
    vars,
  )
  let sub = dtranslate(cons(list1(q_sub__dolmatchdeclare), cdr(form)))
  cons(q_d_any, cons(q_progn, append(defs, list1(sub))))
}

///|
/// DEF%TR SUB_$MATCHDECLARE
fn trans4__tr_sub_matchdeclare(form : Value) -> Value raise {
  yuk_su_meta_prop(
    q_proc__dolmatchdeclare,
    cons(list1(q_d_matchdeclare), cdr(form)),
  )
}

///|
/// PATCH-UP-MEVAL-IN-FSET
fn patch_up_meval_in_fset(form : Value) -> Value raise {
  if !eq(car(form), q_fset) {
    return form
  }
  // FORM is always generated by META-FSET:
  // (fset 'ssymbol (coerce 'definition 'function))
  let ssymbol = cadr(cadr(form))
  let mut definition = cadr(cadr(caddr(form)))
  if !eq(car(definition), q_lambda) {
    barfo(
      format(
        Nil,
        "PATCH-UP-MEVAL-IN-FSET: not a lambda expression: ~A",
        [definition],
      ),
    )
    |> ignore
  }
  tr_format(Str("note: translating rule or match ~:M ...~%"), list1(ssymbol))
  |> ignore
  definition = lisp__gtlisp_tr_lambda(definition)
  if definition is Nil {
    form
  } else if eq(car(definition), q_lambda) {
    // If the definition is a lambda form, just use defun instead of fset.
    cons(q_defun, cons(ssymbol, cdr(definition)))
  } else {
    list3(q_fset, transl__quote(ssymbol), definition)
  }
}

///|
/// LISP->LISP-TR-LAMBDA: basically, a lisp->lisp translation, setting up
/// the proper lambda contexts for the special forms, and calling TRANSLATE
/// on the "lusers" generated by Fateman braindamage, (MEVAL '$A),
/// (MEVAL '(($F) $X)).
fn lisp__gtlisp_tr_lambda(l : Value) -> Value raise {
  if symval(q_lisp__gtlisp_tr_lambda).truthy() {
    catch_tag(q_lisp__gtlisp_tr_lambda, () => tr_lisp__gtlisp(l))
  } else {
    Nil
  }
}

///|
/// TR-LISP->LISP
fn tr_lisp__gtlisp(exp_ : Value) -> Value raise {
  if atom(exp_) {
    cdr(translate_atom(exp_))
  } else {
    let op = car(exp_)
    if symbolp(op) {
      let p = get(op, q_tr_lisp__gtlisp)
      if p.truthy() {
        funcall(p, [exp_])
      } else {
        tr_lisp__gtlisp_default(exp_)
      }
    } else {
      tr_format(Str("error: found a non-symbolic operator; I give up.~%"), Nil)
      |> ignore
      throw_tag(q_lisp__gtlisp_tr_lambda, Nil)
    }
  }
}

///|
/// TR-LISP->LISP-DEFAULT
fn tr_lisp__gtlisp_default(exp_ : Value) -> Value raise {
  if macsyma_special_op_p(car(exp_)).truthy() {
    tr_format(Str("error: unhandled special operator ~:@M~%"), list1(car(exp_)))
    |> ignore
    throw_tag(q_lisp__gtlisp_tr_lambda, Nil)
  } else {
    tr_lisp__gtlisp_fun(exp_)
  }
}

///|
/// TR-LISP->LISP-FUN
fn tr_lisp__gtlisp_fun(exp_ : Value) -> Value raise {
  cons(car(exp_), maptr_lisp__gtlisp(cdr(exp_)))
}

///|
/// MAPTR-LISP->LISP
fn maptr_lisp__gtlisp(l : Value) -> Value raise {
  mapcar(x => tr_lisp__gtlisp(x), l)
}

///|
fn trans4__tl_lambda(form : Value) -> Value raise {
  let arglist = cadr(form)
  for v in arglist.iter() {
    tbind(v) |> ignore
  }
  let body = maptr_lisp__gtlisp(cddr(form))
  cons(q_lambda, cons(tunbinds(arglist), body))
}

///|
fn trans4__tl_prog(form : Value) -> Value raise {
  let arglist = cadr(form)
  for v in arglist.iter() {
    tbind(v) |> ignore
  }
  let body = mapcar(
    x => if atom(x) { x } else { tr_lisp__gtlisp(x) },
    cddr(form),
  )
  cons(q_prog, cons(tunbinds(arglist), body))
}

///|
/// (DEFUN RETLIST FEXPR (L) (CONS '(MLIST SIMP)
///   (MAPCAR #'(LAMBDA (Z) (LIST '(MEQUAL SIMP) Z (MEVAL Z))) L)))
fn trans4__tl_retlist(form : Value) -> Value raise {
  cons(
    q_retlist_tr,
    mapcan(z => list2(transl__quote(z), tr_lisp__gtlisp(z)), cdr(form)),
  )
}

///|
fn trans4__tl_setq(form : Value) -> Value raise {
  let mut n : Value = Nil
  let mut l = cdr(form)
  while l is Cons(_) {
    n = cons(car(l), n)
    n = cons(tr_lisp__gtlisp(cadr(l)), n)
    l = cddr(l)
  }
  cons(q_setq, nreverse(n))
}

///|
fn trans4__tl_msetq(form : Value) -> Value raise {
  cdr(translate(cons(list1(q_msetq), cdr(form))))
}

///|
fn trans4__tl_cond(form : Value) -> Value raise {
  cons(q_cond, mapcar(x => maptr_lisp__gtlisp(x), cdr(form)))
}

///|
fn trans4__tl_meval(form : Value) -> Value raise {
  let form = cadr(form)
  if !atom(form) && eq(car(form), q_quote) {
    cdr(translate(cadr(form)))
  } else if symval(q_unbound_meval_kludge_fix).truthy() {
    // only case of unbound MEVAL is in output of DEFMATCH, and appears like
    // a useless double-evaluation of arguments.
    form
  } else {
    tr_format(Str("error: found unbound MEVAL; I give up.~%"), Nil) |> ignore
    throw_tag(q_lisp__gtlisp_tr_lambda, Nil)
  }
}

///|
fn trans4__tl_is(form : Value) -> Value raise {
  let form = cadr(form)
  if !atom(form) && eq(car(form), q_quote) {
    cdr(translate(list2(list1(q_d_is), cadr(form))))
  } else {
    tr_format(Str("error: found unbound IS; I give up.~%"), Nil) |> ignore
    throw_tag(q_lisp__gtlisp_tr_lambda, Nil)
  }
}

///|
fn init_trans4() -> Unit raise {
  transl__deftr(q_mnctimes, trans4__tr_mnctimes)
  transl__deftr(q_mncexpt, trans4__tr_mncexpt)
  transl__deftr(q_d_remainder, trans4__tr_remainder)
  transl__deftr(q_d_beta, trans4__tr_beta)
  transl__deftr(q_mfactorial, trans4__tr_mfactorial)
  transl__deftr(q_d_matchdeclare, trans4__tr_matchdeclare)
  transl__deftr(q_sub__dolmatchdeclare, trans4__tr_sub_matchdeclare)
  transl__deftr(q_d_defmatch, form => yuk_su_meta_prop(
    q_proc__doldefmatch,
    form,
  ))
  transl__deftr(q_d_tellsimp, form => yuk_su_meta_prop(
    q_proc__doltellsimp,
    form,
  ))
  transl__deftr(q_d_tellsimpafter, form => yuk_su_meta_prop(
    q_proc__doltellsimpafter,
    form,
  ))
  transl__deftr(q_d_defrule, form => yuk_su_meta_prop(q_proc__doldefrule, form))
  let deftl = fn(name : Value, f : (Value) -> Value raise) raise {
    putprop(
      name,
      lfunc(symbol_name(name) + "-tr-lisp->lisp", args => f(arg(args, 0))),
      q_tr_lisp__gtlisp,
    )
    |> ignore
  }
  deftl(q_declare, form => form)
  deftl(q_lambda, trans4__tl_lambda)
  deftl(q_prog, trans4__tl_prog)
  deftl(q_retlist, trans4__tl_retlist)
  deftl(q_quote, form => form)
  for name in [q_catch, q_throw, q_return, q_function, q_not, q_and, q_or] {
    putprop(name, q_tr_lisp__gtlisp_fun, q_tr_lisp__gtlisp) |> ignore
  }
  deftl(q_setq, trans4__tl_setq)
  deftl(q_msetq, trans4__tl_msetq)
  deftl(q_cond, trans4__tl_cond)
  deftl(q_meval, trans4__tl_meval)
  deftl(q_is, trans4__tl_is)
}
