///|
/// SUBROUTINE slatec::dqk15w (numerical/slatec/dqk15w.lisp)
fn slatec_dqk15w(f : Value, w : Value, p1 : Value, p2 : Value, p3 : Value, p4 : Value, kp : Value, a : Value, b : Value, result : Value, abserr : Value, resabs : Value, resasc : Value) -> (Value, Value, Value, Value, Value, Value, Value, Value, Value, Value, Value, Value, Value) raise {
  let w_err : Ref[Error?] = Ref(None)
  let w_fn = fn(a0 : Double, a1 : Double, a2 : Double, a3 : Double, a4 : Double, a5 : Int) -> Double {
    if w_err.val is Some(_) {
      return 0.0
    }
    let vs = slv__call_values(w, [Flo(a0), Flo(a1), Flo(a2), Flo(a3), Flo(a4), Fix(a5.to_int64())]) catch {
      e => {
        w_err.val = Some(e)
        return 0.0
      }
    }
    slv__value_d(vs) catch {
      e => {
        w_err.val = Some(e)
        0.0
      }
    }
  }
  let r = @slatec.dqk15w(slv__integrand(f), w_fn, slv__d(p1, "P1"), slv__d(p2, "P2"), slv__d(p3, "P3"), slv__d(p4, "P4"), slv__i(kp, "KP"), slv__d(a, "A"), slv__d(b, "B"), slv__d(result, "RESULT"), slv__d(abserr, "ABSERR"), slv__d(resabs, "RESABS"), slv__d(resasc, "RESASC"))
  if w_err.val is Some(e) {
    raise e
  }
  (Nil, Nil, Flo(r.0), Flo(r.1), Flo(r.2), Flo(r.3), Fix(r.4.to_int64()), Nil, Nil, Flo(r.5), Flo(r.6), Flo(r.7), Flo(r.8))
}

