              work[work_off + (((i - ll) + nm12) - 1)] = cosl
              work[work_off + (((i - ll) + nm13) - 1)] = -sinl
              i = i + (-1)
              cnt47 = cnt47 - 1
            }
            e[e_off + (ll - 1)] = f
            if (d_abs(e[e_off + (ll - 1)])) <= thresh {
              e[e_off + (ll - 1)] = dbdsqr_zero
            }
            if ncvt > 0 {
              dlasr("L", "V", "B", ((m - ll) + 1), ncvt, work, work_off + ((nm12 + 1) - 1), work, work_off + ((nm13 + 1) - 1), vt, vt_off + ((ll - 1) + ldvt * (1 - 1)), ldvt)
            }
            if nru > 0 {
              dlasr("R", "V", "B", nru, ((m - ll) + 1), work, work_off + (1 - 1), work, work_off + (n - 1), u, u_off + ((1 - 1) + ldu * (ll - 1)), ldu)
            }
            if ncc > 0 {
              dlasr("L", "V", "B", ((m - ll) + 1), ncc, work, work_off + (1 - 1), work, work_off + (n - 1), c, c_off + ((ll - 1) + ldc * (1 - 1)), ldc)
            }
          }
        }
        pc2 = 1
        continue tb1~
      }
      4 => {
        let mut cnt54 = i_max(0, (n - 1 + 1) / 1)
        i = 1
        while cnt54 > 0 {
          if d[d_off + (i - 1)] < dbdsqr_zero {
            d[d_off + (i - 1)] = -d[d_off + (i - 1)]
            if ncvt > 0 {
              dscal(ncvt, dbdsqr_negone, vt, vt_off + ((i - 1) + ldvt * (1 - 1)), ldvt)
            }
          }
          i = i + 1
          cnt54 = cnt54 - 1
        }
        let mut cnt55 = i_max(0, ((n + (-1)) - 1 + 1) / 1)
        i = 1
        while cnt55 > 0 {
          isub = 1
          smin = d[d_off + (1 - 1)]
          let mut cnt56 = i_max(0, (((n + 1) + (-i)) - 2 + 1) / 1)
          j = 2
          while cnt56 > 0 {
            if d[d_off + (j - 1)] <= smin {
              isub = j
              smin = d[d_off + (j - 1)]
            }
            j = j + 1
            cnt56 = cnt56 - 1
          }
          if isub != ((n + 1) + (-i)) {
            d[d_off + (isub - 1)] = d[d_off + (((n + 1) - i) - 1)]
            d[d_off + (((n + 1) - i) - 1)] = smin
            if ncvt > 0 {
              dswap(ncvt, vt, vt_off + ((isub - 1) + ldvt * (1 - 1)), ldvt, vt, vt_off + ((((n + 1) + (-i)) - 1) + ldvt * (1 - 1)), ldvt)
            }
            if nru > 0 {
              dswap(nru, u, u_off + ((1 - 1) + ldu * (isub - 1)), 1, u, u_off + ((1 - 1) + ldu * (((n + 1) - i) - 1)), 1)
            }
            if ncc > 0 {
              dswap(ncc, c, c_off + ((isub - 1) + ldc * (1 - 1)), ldc, c, c_off + ((((n + 1) + (-i)) - 1) + ldc * (1 - 1)), ldc)
            }
          }
          i = i + 1
          cnt55 = cnt55 - 1
        }
        pc2 = 6
        continue tb1~
      }
      5 => {
        info = 0
        let mut cnt57 = i_max(0, ((n + (-1)) - 1 + 1) / 1)
        i = 1
        while cnt57 > 0 {
          if e[e_off + (i - 1)] != dbdsqr_zero {
            info = info + 1
          }
          i = i + 1
          cnt57 = cnt57 - 1
        }
        pc2 = 6
        continue tb1~
      }
      6 => {
        return info
      }
      7 => {
        return info
      }
      _ => panic()
    }
  }
  panic()
}
