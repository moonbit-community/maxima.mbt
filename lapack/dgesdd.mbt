          let mv32 = dorgbr("Q", m, n, n, a, 0, lda, work, itauq - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
          ierr = mv32
          let step34 = ldwrkr
          let mut cnt33 = i_max(0, (m - 1 + step34) / step34)
          i = 1
          while cnt33 > 0 {
            chunk = i_min(((m - i) + 1), ldwrkr)
            dgemm("N", "N", chunk, n, n, dgesdd_one, a, (i - 1) + lda * (1 - 1), lda, work, iu - 1, ldwrku, dgesdd_zero, work, ir - 1, ldwrkr)
            dlacpy("F", chunk, n, work, ir - 1, ldwrkr, a, (i - 1) + lda * (1 - 1), lda)
            i = i + ldwrkr
            cnt33 = cnt33 - 1
          }
        }
      } else if wntqs {
        dlaset("F", m, n, dgesdd_zero, dgesdd_zero, u, 0, ldu)
        let mv35 = dbdsdc("U", "I", n, s, work, ie - 1, u, 0, ldu, vt, 0, ldvt, dum, idum, work, nwork - 1, iwork, info)
        info = mv35
        let mv36 = dormbr("Q", "L", "N", m, n, n, a, 0, lda, work, itauq - 1, u, 0, ldu, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv36
        let mv37 = dormbr("P", "R", "T", n, n, n, a, 0, lda, work, itaup - 1, vt, 0, ldvt, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv37
      } else if wntqa {
        dlaset("F", m, m, dgesdd_zero, dgesdd_zero, u, 0, ldu)
        let mv38 = dbdsdc("U", "I", n, s, work, ie - 1, u, 0, ldu, vt, 0, ldvt, dum, idum, work, nwork - 1, iwork, info)
        info = mv38
        dlaset("F", (m - n), (m - n), dgesdd_zero, dgesdd_one, u, ((n + 1) - 1) + ldu * ((n + 1) - 1), ldu)
        let mv39 = dormbr("Q", "L", "N", m, m, n, a, 0, lda, work, itauq - 1, u, 0, ldu, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv39
        let mv40 = dormbr("P", "R", "T", n, n, m, a, 0, lda, work, itaup - 1, vt, 0, ldvt, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv40
      }
    }
  } else {
    if n >= mnthr {
      if wntqn {
        itau = 1
        nwork = itau + m
        let mv41 = dgelqf(m, n, a, lda, work, itau - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv41
        dlaset("U", (m - 1), (m - 1), dgesdd_zero, dgesdd_zero, a, (1 - 1) + lda * (2 - 1), lda)
        ie = 1
        itauq = ie + m
        itaup = itauq + m
        nwork = itaup + m
        let mv42 = dgebrd(m, m, a, 0, lda, s, work, ie - 1, work, itauq - 1, work, itaup - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv42
        nwork = ie + m
        let mv43 = dbdsdc("U", "N", m, s, work, ie - 1, dum, 0, 1, dum, 0, 1, dum, idum, work, nwork - 1, iwork, info)
        info = mv43
      } else if wntqo {
        ivt = 1
        il = ivt + (m * m)
        if lwork >= ((((m * n) + (m * m)) + (3 * m)) + bdspac) {
          ldwrkl = m
          chunk = n
        } else {
          ldwrkl = m
          chunk = (lwork - (m * m)) / m
        }
        itau = il + (ldwrkl * m)
        nwork = itau + m
        let mv44 = dgelqf(m, n, a, lda, work, itau - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv44
        dlacpy("L", m, m, a, 0, lda, work, il - 1, ldwrkl)
        dlaset("U", (m - 1), (m - 1), dgesdd_zero, dgesdd_zero, work, (il + ldwrkl) - 1, ldwrkl)
        let mv45 = dorglq(m, n, m, a, 0, lda, work, itau - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv45
        ie = itau
        itauq = ie + m
        itaup = itauq + m
        nwork = itaup + m
        let mv46 = dgebrd(m, m, work, il - 1, ldwrkl, s, work, ie - 1, work, itauq - 1, work, itaup - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv46
        let mv47 = dbdsdc("U", "I", m, s, work, ie - 1, u, 0, ldu, work, ivt - 1, m, dum, idum, work, nwork - 1, iwork, info)
        info = mv47
        let mv48 = dormbr("Q", "L", "N", m, m, m, work, il - 1, ldwrkl, work, itauq - 1, u, 0, ldu, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv48
        let mv49 = dormbr("P", "R", "T", m, m, m, work, il - 1, ldwrkl, work, itaup - 1, work, ivt - 1, m, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv49
        let step51 = chunk
        let mut cnt50 = i_max(0, (n - 1 + step51) / step51)
        i = 1
        while cnt50 > 0 {
          blk = i_min(((n - i) + 1), chunk)
          dgemm("N", "N", m, blk, m, dgesdd_one, work, ivt - 1, m, a, (1 - 1) + lda * (i - 1), lda, dgesdd_zero, work, il - 1, ldwrkl)
          dlacpy("F", m, blk, work, il - 1, ldwrkl, a, (1 - 1) + lda * (i - 1), lda)
          i = i + chunk
          cnt50 = cnt50 - 1
        }
      } else if wntqs {
        il = 1
        ldwrkl = m
        itau = il + (ldwrkl * m)
        nwork = itau + m
        let mv52 = dgelqf(m, n, a, lda, work, itau - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv52
        dlacpy("L", m, m, a, 0, lda, work, il - 1, ldwrkl)
        dlaset("U", (m - 1), (m - 1), dgesdd_zero, dgesdd_zero, work, (il + ldwrkl) - 1, ldwrkl)
        let mv53 = dorglq(m, n, m, a, 0, lda, work, itau - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv53
        ie = itau
        itauq = ie + m
        itaup = itauq + m
        nwork = itaup + m
        let mv54 = dgebrd(m, m, work, il - 1, ldwrkl, s, work, ie - 1, work, itauq - 1, work, itaup - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv54
        let mv55 = dbdsdc("U", "I", m, s, work, ie - 1, u, 0, ldu, vt, 0, ldvt, dum, idum, work, nwork - 1, iwork, info)
        info = mv55
        let mv56 = dormbr("Q", "L", "N", m, m, m, work, il - 1, ldwrkl, work, itauq - 1, u, 0, ldu, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv56
        let mv57 = dormbr("P", "R", "T", m, m, m, work, il - 1, ldwrkl, work, itaup - 1, vt, 0, ldvt, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv57
        dlacpy("F", m, m, vt, 0, ldvt, work, il - 1, ldwrkl)
        dgemm("N", "N", m, n, m, dgesdd_one, work, il - 1, ldwrkl, a, 0, lda, dgesdd_zero, vt, 0, ldvt)
      } else if wntqa {
        ivt = 1
        ldwkvt = m
        itau = ivt + (ldwkvt * m)
        nwork = itau + m
        let mv58 = dgelqf(m, n, a, lda, work, itau - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv58
        dlacpy("U", m, n, a, 0, lda, vt, 0, ldvt)
        let mv59 = dorglq(n, n, m, vt, 0, ldvt, work, itau - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv59
        dlaset("U", (m - 1), (m - 1), dgesdd_zero, dgesdd_zero, a, (1 - 1) + lda * (2 - 1), lda)
        ie = itau
        itauq = ie + m
        itaup = itauq + m
        nwork = itaup + m
        let mv60 = dgebrd(m, m, a, 0, lda, s, work, ie - 1, work, itauq - 1, work, itaup - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv60
        let mv61 = dbdsdc("U", "I", m, s, work, ie - 1, u, 0, ldu, work, ivt - 1, ldwkvt, dum, idum, work, nwork - 1, iwork, info)
        info = mv61
        let mv62 = dormbr("Q", "L", "N", m, m, m, a, 0, lda, work, itauq - 1, u, 0, ldu, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv62
        let mv63 = dormbr("P", "R", "T", m, m, m, a, 0, lda, work, itaup - 1, work, ivt - 1, ldwkvt, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv63
        dgemm("N", "N", m, n, m, dgesdd_one, work, ivt - 1, ldwkvt, vt, 0, ldvt, dgesdd_zero, a, 0, lda)
        dlacpy("F", m, n, a, 0, lda, vt, 0, ldvt)
      }
    } else {
      ie = 1
      itauq = ie + m
      itaup = itauq + m
      nwork = itaup + m
      let mv64 = dgebrd(m, n, a, 0, lda, s, work, ie - 1, work, itauq - 1, work, itaup - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
      ierr = mv64
      if wntqn {
        let mv65 = dbdsdc("L", "N", m, s, work, ie - 1, dum, 0, 1, dum, 0, 1, dum, idum, work, nwork - 1, iwork, info)
        info = mv65
      } else if wntqo {
        ldwkvt = m
        ivt = nwork
        if lwork >= (((m * n) + (3 * m)) + bdspac) {
          dlaset("F", m, n, dgesdd_zero, dgesdd_zero, work, ivt - 1, ldwkvt)
          nwork = ivt + (ldwkvt * n)
        } else {
          nwork = ivt + (ldwkvt * m)
          il = nwork
          chunk = ((lwork - (m * m)) - (3 * m)) / m
        }
        let mv66 = dbdsdc("L", "I", m, s, work, ie - 1, u, 0, ldu, work, ivt - 1, ldwkvt, dum, idum, work, nwork - 1, iwork, info)
        info = mv66
        let mv67 = dormbr("Q", "L", "N", m, m, n, a, 0, lda, work, itauq - 1, u, 0, ldu, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv67
        if lwork >= (((m * n) + (3 * m)) + bdspac) {
          let mv68 = dormbr("P", "R", "T", m, n, m, a, 0, lda, work, itaup - 1, work, ivt - 1, ldwkvt, work, nwork - 1, ((lwork - nwork) + 1), ierr)
          ierr = mv68
          dlacpy("F", m, n, work, ivt - 1, ldwkvt, a, 0, lda)
        } else {
          let mv69 = dorgbr("P", m, n, m, a, 0, lda, work, itaup - 1, work, nwork - 1, ((lwork - nwork) + 1), ierr)
          ierr = mv69
          let step71 = chunk
          let mut cnt70 = i_max(0, (n - 1 + step71) / step71)
          i = 1
          while cnt70 > 0 {
            blk = i_min(((n - i) + 1), chunk)
            dgemm("N", "N", m, blk, m, dgesdd_one, work, ivt - 1, ldwkvt, a, (1 - 1) + lda * (i - 1), lda, dgesdd_zero, work, il - 1, m)
            dlacpy("F", m, blk, work, il - 1, m, a, (1 - 1) + lda * (i - 1), lda)
            i = i + chunk
            cnt70 = cnt70 - 1
          }
        }
      } else if wntqs {
        dlaset("F", m, n, dgesdd_zero, dgesdd_zero, vt, 0, ldvt)
        let mv72 = dbdsdc("L", "I", m, s, work, ie - 1, u, 0, ldu, vt, 0, ldvt, dum, idum, work, nwork - 1, iwork, info)
        info = mv72
        let mv73 = dormbr("Q", "L", "N", m, m, n, a, 0, lda, work, itauq - 1, u, 0, ldu, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv73
        let mv74 = dormbr("P", "R", "T", m, n, m, a, 0, lda, work, itaup - 1, vt, 0, ldvt, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv74
      } else if wntqa {
        dlaset("F", n, n, dgesdd_zero, dgesdd_zero, vt, 0, ldvt)
        let mv75 = dbdsdc("L", "I", m, s, work, ie - 1, u, 0, ldu, vt, 0, ldvt, dum, idum, work, nwork - 1, iwork, info)
        info = mv75
        dlaset("F", (n - m), (n - m), dgesdd_zero, dgesdd_one, vt, ((m + 1) - 1) + ldvt * ((m + 1) - 1), ldvt)
        let mv76 = dormbr("Q", "L", "N", m, m, n, a, 0, lda, work, itauq - 1, u, 0, ldu, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv76
        let mv77 = dormbr("P", "R", "T", n, n, m, a, 0, lda, work, itaup - 1, vt, 0, ldvt, work, nwork - 1, ((lwork - nwork) + 1), ierr)
        ierr = mv77
      }
    }
  }
  if iscl == 1 {
    if anrm > bignum {
      let mv78 = dlascl("G", 0, 0, bignum, anrm, minmn, 1, s, 0, minmn, ierr)
      ierr = mv78
    }
    if anrm < smlnum {
      let mv79 = dlascl("G", 0, 0, smlnum, anrm, minmn, 1, s, 0, minmn, ierr)
      ierr = mv79
    }
  }
  work[1 - 1] = maxwrk.to_double()
  info
}
