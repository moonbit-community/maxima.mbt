            let (mv27, mv28, mv29) = dlaln2(true, 2, 2, sminw, dlaqtr_one, t_, t__off + ((j1 - 1) + ldt * (j1 - 1)), ldt, dlaqtr_one, dlaqtr_one, d, 0, 2, dlaqtr_zero, w, v, 2, scaloc, xnorm, ierr)
            scaloc = mv27
            xnorm = mv28
            ierr = mv29
            if ierr != 0 {
              info = 2
            }
            if scaloc != dlaqtr_one {
              dscal(n2, scaloc, x, x_off, 1)
              scale = scaloc * scale
            }
            x[x_off + (j1 - 1)] = v[(1 - 1) + 2 * (1 - 1)]
            x[x_off + (j2 - 1)] = v[(2 - 1) + 2 * (1 - 1)]
            x[x_off + ((n + j1) - 1)] = v[(1 - 1) + 2 * (2 - 1)]
            x[x_off + ((n + j2) - 1)] = v[(2 - 1) + 2 * (2 - 1)]
            xmax = d_max(d_max(((d_abs(x[x_off + (j1 - 1)])) + (d_abs(x[x_off + ((n + j1) - 1)]))), ((d_abs(x[x_off + (j2 - 1)])) + (d_abs(x[x_off + ((n + j2) - 1)])))), xmax)
          }
          break tb24~
        }
        j = j + 1
        cnt23 = cnt23 - 1
      }
    }
  }
  (scale, info)
}
