                cc[(m1 - 1) + in1 * ((i - 1) + ido * (((j2 - 1) - 1) + ip * (k - 1)))] = ch[(m2 - 1) + in2 * ((i - 1) + ido * ((k - 1) + l1 * (j - 1)))] + ch[(m2 - 1) + in2 * ((i - 1) + ido * ((k - 1) + l1 * (jc - 1)))]
                cc[(m1 - 1) + in1 * ((ic - 1) + ido * (((j2 - 2) - 1) + ip * (k - 1)))] = ch[(m2 - 1) + in2 * ((i - 1) + ido * ((k - 1) + l1 * (jc - 1)))] - ch[(m2 - 1) + in2 * ((i - 1) + ido * ((k - 1) + l1 * (j - 1)))]
