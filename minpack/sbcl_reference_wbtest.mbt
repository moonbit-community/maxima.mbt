test "sbcl reference 0: hybrd1 rosen n=2 tol=1.49012e-08 maxc=0" {
  let r = ref_case(s => {
    t_hybrd1(s, "rosen", 2, [(-1.2), 1.0], 1.4901161193847656e-08, 0)
  })
  assert_eq(r, " i2 i1 i22 | d4607182418800017408 d4607182418800017408 | d0 d0 d0 s\"\"")
}

