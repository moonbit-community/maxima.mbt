// Generated by tools/f2cl2mbt.py --lib=minpack --reference-test; do not edit.
// Differential test against the f2cl Lisp of Maxima's share/minpack/lisp run under
// SBCL 2.6.9: each case runs the same calls in Lisp and in MoonBit and
// renders every result as IEEE bit patterns, plus the text printed on
// Fortran unit 6.

///|
fn rd(s : StringBuilder, x : Double) -> Unit {
  s.write_string(" d" + x.reinterpret_as_int64().to_string())
}

///|
fn ri(s : StringBuilder, n : Int) -> Unit {
  s.write_string(" i" + n.to_string())
}

///|
fn rb(s : StringBuilder, b : Bool) -> Unit {
  s.write_string(if b { " bT" } else { " bF" })
}

///|
fn rc(s : StringBuilder, z : Complex) -> Unit {
  s.write_string(
    " c" + z.re.reinterpret_as_int64().to_string() + "," +
    z.im.reinterpret_as_int64().to_string(),
  )
}

///|
fn mix(h : UInt64, w : Int64) -> UInt64 {
  (h ^ w.reinterpret_as_uint64()) * 1099511628211UL
}

///|
/// Arrays of more than 64 elements are rendered as an FNV-1a hash of their
/// bit patterns.
fn rhash(s : StringBuilder, n : Int, h : UInt64) -> Unit {
  s.write_string(" |h" + n.to_string() + ":" + h.to_string())
}

///|
fn rad(s : StringBuilder, a : FixedArray[Double]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(h, x.reinterpret_as_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    rd(s, x)
  }
}

///|
fn rai(s : StringBuilder, a : FixedArray[Int]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(h, x.to_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    ri(s, x)
  }
}

///|
fn rac(s : StringBuilder, a : FixedArray[Complex]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(mix(h, x.re.reinterpret_as_int64()), x.im.reinterpret_as_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    rc(s, x)
  }
}

///|
fn quote_text(t : String) -> String {
  let sb = StringBuilder()
  for c in t {
    match c {
      '\n' => sb.write_string("\\n")
      '"' => sb.write_string("\\\"")
      '\\' => sb.write_string("\\\\")
      _ => sb.write_char(c)
    }
  }
  sb.to_string()
}

///|
/// Run `body`, capturing what the routines print.
fn ref_case(body : (StringBuilder) -> Unit raise) -> String raise {
  let s = StringBuilder()
  let text = StringBuilder()
  let saved = @f2cl.output_hook.val
  @f2cl.output_hook.val = t => text.write_string(t)
  body(s) catch {
    e => {
      @f2cl.output_hook.val = saved
      raise e
    }
  }
  @f2cl.output_hook.val = saved
  s.write_string(" s\"" + quote_text(text.to_string()) + "\"")
  s.to_string()
}

///|
fn dvec(xs : Array[Double]) -> FixedArray[Double] {
  FixedArray::from_array(xs)
}

///|
fn cvec(xs : Array[(Double, Double)]) -> FixedArray[Complex] {
  FixedArray::from_array(xs.map(p => cplx(p.0, p.1)))
}


///|
let bard_y : FixedArray[Double] = [
  0.14, 0.18, 0.22, 0.25, 0.29, 0.32, 0.35, 0.39, 0.37, 0.58, 0.73, 0.96, 1.34,
  2.10, 4.39,
]

///|
fn prob_f(
  p : String,
  m : Int,
  n : Int,
  x : FixedArray[Double],
  xo : Int,
  f : FixedArray[Double],
  fo : Int,
) -> Unit {
  match p {
    "rosen" => {
      f[fo + 0] = 1.0 - x[xo + 0]
      f[fo + 1] = 10.0 * (x[xo + 1] - x[xo + 0] * x[xo + 0])
    }
    "powell" => {
      f[fo + 0] = x[xo + 0] + 10.0 * x[xo + 1]
      f[fo + 1] = (5.0 : Double).sqrt() * (x[xo + 2] - x[xo + 3])
      f[fo + 2] = (x[xo + 1] - 2.0 * x[xo + 2]) * (x[xo + 1] - 2.0 * x[xo + 2])
      f[fo + 3] = (10.0 : Double).sqrt() *
        ((x[xo + 0] - x[xo + 3]) * (x[xo + 0] - x[xo + 3]))
    }
    "broyden" =>
      for i in 0..<n {
        f[fo + i] = (3.0 - 2.0 * x[xo + i]) * x[xo + i] -
          (if i > 0 { x[xo + i - 1] } else { 0.0 }) -
          2.0 * (if i < n - 1 { x[xo + i + 1] } else { 0.0 }) +
          1.0
      }
    "freud" => {
      f[fo + 0] = -13.0 + x[xo + 0] + ((5.0 - x[xo + 1]) * x[xo + 1] - 2.0) * x[xo + 1]
      f[fo + 1] = -29.0 + x[xo + 0] + ((x[xo + 1] + 1.0) * x[xo + 1] - 14.0) * x[xo + 1]
    }
    "bard" =>
      for i in 0..<15 {
        let u = i + 1
        let v = 16 - u
        let w = if u < v { u } else { v }
        f[fo + i] = bard_y[i] -
          (x[xo + 0] +
          u.to_double() / (v.to_double() * x[xo + 1] + w.to_double() * x[xo + 2]))
      }
    "linear" => {
      let mut sum = 0.0
      for j in 0..<n {
        sum = sum + x[xo + j]
      }
      for i in 0..<m {
        f[fo + i] = (if i < n { x[xo + i] } else { 0.0 }) -
          2.0 / m.to_double() * sum -
          1.0
      }
    }
    _ => abort(p)
  }
}

///|
fn prob_j(
  p : String,
  m : Int,
  n : Int,
  x : FixedArray[Double],
  xo : Int,
  fjac : FixedArray[Double],
  jo : Int,
  ld : Int,
) -> Unit {
  fn set(i : Int, k : Int, v : Double) {
    fjac[jo + i + ld * k] = v
  }

  for k in 0..<n {
    for i in 0..<m {
      set(i, k, 0.0)
    }
  }
  match p {
    "rosen" => {
      set(0, 0, -1.0)
      set(1, 0, -20.0 * x[xo + 0])
      set(1, 1, 10.0)
    }
    "powell" => {
      set(0, 0, 1.0)
      set(0, 1, 10.0)
      set(1, 2, (5.0 : Double).sqrt())
      set(1, 3, -(5.0 : Double).sqrt())
      let d = x[xo + 1] - 2.0 * x[xo + 2]
      set(2, 1, 2.0 * d)
      set(2, 2, -4.0 * d)
      let d = 2.0 * (10.0 : Double).sqrt() * (x[xo + 0] - x[xo + 3])
      set(3, 0, d)
      set(3, 3, -d)
    }
    "broyden" =>
      for i in 0..<n {
        set(i, i, 3.0 - 4.0 * x[xo + i])
        if i > 0 {
          set(i, i - 1, -1.0)
        }
        if i < n - 1 {
          set(i, i + 1, -2.0)
        }
      }
    "freud" => {
      set(0, 0, 1.0)
      set(0, 1, (10.0 - 3.0 * x[xo + 1]) * x[xo + 1] - 2.0)
      set(1, 0, 1.0)
      set(1, 1, (3.0 * x[xo + 1] + 2.0) * x[xo + 1] - 14.0)
    }
    "bard" =>
      for i in 0..<15 {
        let u = i + 1
        let v = 16 - u
        let w = if u < v { u } else { v }
        let den = v.to_double() * x[xo + 1] + w.to_double() * x[xo + 2]
        let tmp = den * den
        set(i, 0, -1.0)
        set(i, 1, (u * v).to_double() / tmp)
        set(i, 2, (u * w).to_double() / tmp)
      }
    "linear" =>
      for i in 0..<m {
        for k in 0..<n {
          set(i, k, (if i == k { 1.0 } else { 0.0 }) - 2.0 / m.to_double())
        }
      }
    _ => abort(p)
  }
}

///|
let calls : Ref[Int] = { val: 0 }

///|
fn count_call(iflag : Int, maxc : Int) -> Int {
  if iflag != 0 {
    calls.val = calls.val + 1
  }
  if maxc > 0 && calls.val > maxc {
    -1
  } else {
    iflag
  }
}

///|
fn t_hybrd1(s : StringBuilder, p : String, n : Int, x0 : Array[Double], tol : Double, maxc : Int) -> Unit raise {
  let x = dvec(x0)
  let fvec = FixedArray::make(n, 0.0)
  let lwa = n * (3 * n + 13) / 2
  let wa = FixedArray::make(lwa, 0.0)
  calls.val = 0
  let (r0, r1) = hybrd1(
    fn(n, x, xo, fv, fo, iflag) {
      let iflag = count_call(iflag, maxc)
      if iflag > 0 {
        prob_f(p, n, n, x, xo, fv, fo)
      }
      (n, iflag)
    },
    n, x, fvec, tol, 0, wa, lwa,
  )
  ri(s, r0)
  ri(s, r1)
  ri(s, calls.val)
  rad(s, x)
  rad(s, fvec)
  rd(s, enorm(n, fvec, 0))
}

///|
fn t_hybrj1(s : StringBuilder, p : String, n : Int, x0 : Array[Double], tol : Double, maxc : Int) -> Unit raise {
  let x = dvec(x0)
  let fvec = FixedArray::make(n, 0.0)
  let fjac = FixedArray::make(n * n, 0.0)
  let lwa = n * (n + 13) / 2
  let wa = FixedArray::make(lwa, 0.0)
  calls.val = 0
  let (r0, r1, r2) = hybrj1(
    fn(n, x, xo, fv, fo, fj, jo, ld, iflag) {
      let iflag = count_call(iflag, maxc)
      if iflag == 1 {
        prob_f(p, n, n, x, xo, fv, fo)
      } else if iflag == 2 {
        prob_j(p, n, n, x, xo, fj, jo, ld)
      }
      (n, ld, iflag)
    },
    n, x, fvec, fjac, n, tol, 0, wa, lwa,
  )
  ri(s, r0)
  ri(s, r1)
  ri(s, r2)
  ri(s, calls.val)
  rad(s, x)
  rad(s, fvec)
  rad(s, fjac)
}

///|
fn t_lmdif1(s : StringBuilder, p : String, m : Int, n : Int, x0 : Array[Double], tol : Double, maxc : Int) -> Unit raise {
  let x = dvec(x0)
  let fvec = FixedArray::make(m, 0.0)
  let lwa = m + 5 * n + m * n
  let wa = FixedArray::make(lwa, 0.0)
  let iwa = FixedArray::make(n, 0)
  calls.val = 0
  let (r0, r1, r2) = lmdif1(
    fn(m, n, x, xo, fv, fo, iflag) {
      let iflag = count_call(iflag, maxc)
      if iflag > 0 {
        prob_f(p, m, n, x, xo, fv, fo)
      }
      (m, n, iflag)
    },
    m, n, x, fvec, tol, 0, iwa, wa, lwa,
  )
  ri(s, r0)
  ri(s, r1)
  ri(s, r2)
  ri(s, calls.val)
  rad(s, x)
  rad(s, fvec)
  rai(s, iwa)
  rd(s, enorm(m, fvec, 0))
}

///|
fn t_lmder1(s : StringBuilder, p : String, m : Int, n : Int, x0 : Array[Double], tol : Double, maxc : Int) -> Unit raise {
  let x = dvec(x0)
  let fvec = FixedArray::make(m, 0.0)
  let fjac = FixedArray::make(m * n, 0.0)
  let lwa = m + 5 * n
  let wa = FixedArray::make(lwa, 0.0)
  let ipvt = FixedArray::make(n, 0)
  calls.val = 0
  let (r0, r1, r2, r3) = lmder1(
    fn(m, n, x, xo, fv, fo, fj, jo, ld, iflag) {
      let iflag = count_call(iflag, maxc)
      if iflag == 1 {
        prob_f(p, m, n, x, xo, fv, fo)
      } else if iflag == 2 {
        prob_j(p, m, n, x, xo, fj, jo, ld)
      }
      (m, n, ld, iflag)
    },
    m, n, x, fvec, fjac, m, tol, 0, ipvt, wa, lwa,
  )
  ri(s, r0)
  ri(s, r1)
  ri(s, r2)
  ri(s, r3)
  ri(s, calls.val)
  rad(s, x)
  rad(s, fvec)
  rad(s, fjac)
  rai(s, ipvt)
}

///|
fn t_hybrd(s : StringBuilder, p : String, n : Int, x0 : Array[Double], ml : Int, mu : Int, mode : Int, nprint : Int) -> Unit raise {
  let x = dvec(x0)
  let fvec = FixedArray::make(n, 0.0)
  let fjac = FixedArray::make(n * n, 0.0)
  let r = FixedArray::make(n * (n + 1) / 2, 0.0)
  let diag = FixedArray::makei(n, i => (i + 1).to_double())
  let qtf = FixedArray::make(n, 0.0)
  let w1 = FixedArray::make(n, 0.0)
  let w2 = FixedArray::make(n, 0.0)
  let w3 = FixedArray::make(n, 0.0)
  let w4 = FixedArray::make(n, 0.0)
  calls.val = 0
  let (r0, r1, r2) = hybrd(
    fn(n, x, xo, fv, fo, iflag) {
      let iflag = count_call(iflag, 0)
      if iflag > 0 {
        prob_f(p, n, n, x, xo, fv, fo)
      }
      (n, iflag)
    },
    n, x, fvec, 1.0e-10, 2000, ml, mu, 0.0, diag, 0, mode, 100.0, nprint, 0, 0,
    fjac, 0, n, r, 0, r.length(), qtf, 0, w1, 0, w2, 0, w3, 0, w4, 0,
  )
  ri(s, r0)
  ri(s, r1)
  ri(s, r2)
  ri(s, calls.val)
  rad(s, x)
  rad(s, fvec)
  rad(s, r)
  rad(s, qtf)
}

///|
fn t_lmdif(s : StringBuilder, p : String, m : Int, n : Int, x0 : Array[Double], mode : Int, nprint : Int, epsfcn : Double) -> Unit raise {
  let x = dvec(x0)
  let fvec = FixedArray::make(m, 0.0)
  let fjac = FixedArray::make(m * n, 0.0)
  let diag = FixedArray::makei(n, i => (i + 2).to_double())
  let qtf = FixedArray::make(n, 0.0)
  let ipvt = FixedArray::make(n, 0)
  let w1 = FixedArray::make(n, 0.0)
  let w2 = FixedArray::make(n, 0.0)
  let w3 = FixedArray::make(n, 0.0)
  let w4 = FixedArray::make(m, 0.0)
  calls.val = 0
  let (r0, r1, r2, r3) = lmdif(
    fn(m, n, x, xo, fv, fo, iflag) {
      let iflag = count_call(iflag, 0)
      if iflag > 0 {
        prob_f(p, m, n, x, xo, fv, fo)
      }
      (m, n, iflag)
    },
    m, n, x, fvec, 1.0e-12, 1.0e-12, 0.0, 3000, epsfcn, diag, 0, mode, 100.0,
    nprint, 0, 0, fjac, 0, m, ipvt, qtf, 0, w1, 0, w2, 0, w3, 0, w4, 0,
  )
  ri(s, r0)
  ri(s, r1)
  ri(s, r2)
  ri(s, r3)
  ri(s, calls.val)
  rad(s, x)
  rad(s, fvec)
  rad(s, fjac)
  rai(s, ipvt)
  rad(s, qtf)
}

