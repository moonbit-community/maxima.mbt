///|
test "sbcl reference 4: prob2 no initial guess" {
  let r = ref_case(s => {
    cn_run(s, (p2_fsub, p2_dfsub, p2_gsub, p2_dgsub, p2_guess), 2, [2, 2], 0.0, 1.0, [0.0, 0.0, 1.0, 1.0], [1, 4, 10, 4, 40000, 2500, 1, 0, 0, 0, 0], [1, 2, 3, 4], [1.0e-05, 1.0e-05, 1.0e-05, 1.0e-05], 40000, 2500, [0.3], 4) |> ignore
  })
  assert_eq(r, " i1 |h40000:12026860277935875925 |h2500:4486005503682719957 | d4579334207360780694 d4586977753124170066 d-4624009628244842745 d-4616648158210636932 s\"\"")
}

