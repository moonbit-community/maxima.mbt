  })
  assert_eq(r, " i-1 |h300:8530134014793929259 | i1 i5 i1 i4 i4 i16 i40 i4 i1 i2 i3 i4 i5 i8 i8 i8 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 s\"\\n\\n VERSION *COLNEW* OF COLSYS .    \\n\\n\\n THE MAXIMUM NUMBER OF SUBINTERVALS IS MIN (   1 (ALLOWED FROM FSPACE),   3 (ALLOWED FROM ISPACE) )\\n\\n INSUFFICIENT SPACE TO DOUBLE MESH FOR ERROR ESTIMATE\\n\\n THE NEW MESH (OF    1 SUBINTERVALS), \\n    1.000000    2.000000\\n\\n THE NEW MESH (OF    1 SUBINTERVALS), \\n    1.000000    2.000000\\n\\n THE NEW MESH (OF    1 SUBINTERVALS), \\n    1.000000    2.000000\\n\\n  EXPECTED N TOO LARGE \\n  (PROBABLY TOLERANCES TOO STRINGENT, OR NMAX TOO SMALL)\\n\"")
}

///|
test "sbcl reference 3: prob2 (full output)" {
  let r = ref_case(s => {
    cn_run(s, (p2_fsub, p2_dfsub, p2_gsub, p2_dgsub, p2_guess), 2, [2, 2], 0.0, 1.0, [0.0, 0.0, 1.0, 1.0], [1, 4, 10, 4, 40000, 2500, -1, 0, 1, 0, 0], [1, 2, 3, 4], [1.0e-05, 1.0e-05, 1.0e-05, 1.0e-05], 40000, 2500, [0.0, 0.05, 0.5, 1.0], 4) |> ignore
