          dmz[dmz_off + (i - 1)] = dmz[dmz_off + (i - 1)] + (fact * deldmz[deldmz_off + (i - 1)])
          i = i + 1
          cnt48 = cnt48 - 1
        }
        rlxold = relax
        pc2 = 13
        continue tb1~
      }
      19 => {
        let mut cnt49 = i_max(0, (colest_part_1[80] - 1 + 1) / 1)
        it = 1
        while cnt49 > 0 {
          inz = colest_part_1[40 + (it - 1)]
          let step51 = colord_part_0[2]
          let mut cnt50 = i_max(0, (colapr_part_0[3] - inz + step51) / step51)
          iz = inz
          while cnt50 > 0 {
            if (d_abs(dqz[dqz_off + (iz - 1)])) > (colest_part_0[120 + (it - 1)] * ((d_abs(z[z_off + (iz - 1)])) + 1.0)) {
              pc2 = 11
              continue tb1~
            }
            iz = iz + colord_part_0[2]
            cnt50 = cnt50 - 1
          }
          it = it + 1
          cnt49 = cnt49 - 1
        }
        if colout_part_1[1] < 1 {
          let fa52 : Array[FArg] = []
          fa52.push(AI(colnln_part_0[1]))
          fformat(colout_part_1[0], [Lit("~%"), Lit(" CONVERGENCE AFTER"), Rep(1, [Dir("~3D")]), Lit(" ITERATIONS"), Lit("~%"), Lit("~%")], fa52)
        }
        let mut cnt53 = i_max(0, (colapr_part_0[3] - 1 + 1) / 1)
        i = 1
        while cnt53 > 0 {
          z[z_off + (i - 1)] = z[z_off + (i - 1)] + dqz[dqz_off + (i - 1)]
          i = i + 1
          cnt53 = cnt53 - 1
        }
        let mut cnt54 = i_max(0, (colapr_part_0[4] - 1 + 1) / 1)
        i = 1
        while cnt54 > 0 {
          dmz[dmz_off + (i - 1)] = dmz[dmz_off + (i - 1)] + dqdmz[dqdmz_off + (i - 1)]
          i = i + 1
          cnt54 = cnt54 - 1
        }
        pc2 = 20
        continue tb1~
      }
      20 => {
        if ((anfix < colout_part_0[0]) || (rnorm < colout_part_0[0])) && (colout_part_1[1] < 1) {
          let fa55 : Array[FArg] = []
          fa55.push(AI(colnln_part_0[1]))
          fformat(colout_part_1[0], [Lit("~%"), Lit(" CONVERGENCE AFTER"), Rep(1, [Dir("~3D")]), Lit(" ITERATIONS"), Lit("~%"), Lit("~%")], fa55)
        }
        iconv = 1
        if colnln_part_0[3] == (-1) {
          colnln_part_0[3] = 0
        }
        pc2 = 21
        continue tb1~
      }
      21 => {
        if colout_part_1[1] >= 0 {
          pc2 = 22
          continue tb1~
        }
        let mut cnt56 = i_max(0, (colord_part_0[2] - 1 + 1) / 1)
        j = 1
        while cnt56 > 0 {
          let fa57 : Array[FArg] = []
          fa57.push(AI(j))
          fformat(colout_part_1[0], [Lit(" MESH VALUES FOR Z("), Rep(1, [Dir("~2D")]), Lit("),"), Lit("~%")], fa57)
          let fa58 : Array[FArg] = []
          let mut di59 = j
          while di59 <= colapr_part_0[3] {
            fa58.push(AD(z[z_off + (di59 - 1)]))
            di59 = di59 + colord_part_0[2]
          }
          fformat(colout_part_1[0], [Lit(" "), Rep(8, [Dir("~15,7,2,0,'*,,'DE")]), Lit("~%")], fa58)
          j = j + 1
          cnt56 = cnt56 - 1
        }
        pc2 = 22
        continue tb1~
      }
      22 => {
        ifin = 1
        if imesh == 2 {
          let mv60 = errchk(xi, xi_off, z, z_off, dmz, dmz_off, valstr, valstr_off, ifin)
          ifin = mv60
        }
        if (imesh == 1) || ((ifin == 0) && (colnln_part_0[3] != 2)) {
          pc2 = 26
          continue tb1~
        }
        iflag = 1
        return iflag
      }
      23 => {
        if colout_part_1[1] < 1 {
          let fa61 : Array[FArg] = []
          fa61.push(AI(colnln_part_0[1]))
          fformat(colout_part_1[0], [Lit("~%"), Lit(" NO CONVERGENCE AFTER "), Rep(1, [Dir("~3D")]), Lit(" ITERATIONS"), Lit("~%"), Lit("~%")], fa61)
        }
        pc2 = 25
        continue tb1~
      }
      24 => {
        if colout_part_1[1] < 1 {
          let fa62 : Array[FArg] = []
          fa62.push(AD(relax))
          fa62.push(AD(relmin))
          fformat(colout_part_1[0], [Lit("~%"), Lit(" NO CONVERGENCE.  RELAXATION FACTOR ="), Rep(1, [Dir("~10,3,2,0,'*,,'DE")]), Lit(" IS TOO SMALL (LESS THAN"), Rep(1, [Dir("~10,3,2,0,'*,,'DE")]), Lit(")"), Lit("~%"), Lit("~%")], fa62)
        }
        pc2 = 25
        continue tb1~
      }
      25 => {
        iflag = -2
        noconv = noconv + 1
        if (colnln_part_0[3] == 2) && (noconv > 1) {
          return iflag
        }
        if colnln_part_0[3] == 0 {
          colnln_part_0[3] = -1
        }
        pc2 = 26
        continue tb1~
      }
      26 => {
        np1 = colapr_part_0[0] + 1
        let mut cnt63 = i_max(0, (np1 - 1 + 1) / 1)
        i = 1
        while cnt63 > 0 {
          xiold[xiold_off + (i - 1)] = xi[xi_off + (i - 1)]
          i = i + 1
          cnt63 = cnt63 - 1
        }
        colapr_part_0[1] = colapr_part_0[0]
        imesh = 1
        if (iconv == 0) || (colmsh_part_0[1] >= colmsh_part_0[2]) || (colmsh_part_0[3] >= colmsh_part_0[2]) {
          imesh = 2
        }
        if (colmsh_part_0[3] >= colmsh_part_0[2]) && (colmsh_part_0[1] < colmsh_part_0[2]) {
          colmsh_part_0[3] = 1
        }
        let mv64 = newmsh(imesh, xi, xi_off, xiold, xiold_off, z, z_off, dmz, dmz_off, valstr, valstr_off, slope, slope_off, accum, accum_off, nfxpnt, fixpnt)
        imesh = mv64
        if colapr_part_0[0] <= colapr_part_0[2] {
          pc2 = 27
          continue tb1~
        }
        colapr_part_0[0] = colapr_part_0[0] / 2
        iflag = -1
        if (iconv == 0) && (colout_part_1[1] < 1) {
          let fa65 : Array[FArg] = []
          fformat(colout_part_1[0], [Lit("  (NO CONVERGENCE)"), Lit("~%")], fa65)
        }
        if (iconv == 1) && (colout_part_1[1] < 1) {
          let fa66 : Array[FArg] = []
          fformat(colout_part_1[0], [Lit("  (PROBABLY TOLERANCES TOO STRINGENT, OR NMAX TOO "), Lit("SMALL)"), Lit("~%")], fa66)
        }
        return iflag
      }
      27 => {
        if iconv == 0 {
          imesh = 1
        }
        if colnln_part_0[3] == 1 {
          iconv = 0
        }
        pc2 = 1
        continue tb1~
      }
      28 => {
        return iflag
      }
      _ => panic()
    }
  }
  panic()
}
