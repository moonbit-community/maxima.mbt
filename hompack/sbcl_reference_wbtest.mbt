  assert_eq(r, " i5 d4532020583610935537 d4532020583610935537 i26 d4613320501482977178 | d4607119373317997770 d4607356933275388257 d4607110189541902288 d4607110189541761443 d4607110189541813087 d4607110189541822474 s\"\"")
}

///|
test "sbcl reference 10: fixpdf ex2 zero finding" {
  let r = ref_case(s => {
    hp_fixpdf(s, ex2_f, ex2_fjac, 5, 0, (-1.0), 1.0e-05, [0.5, 0.5, 0.5, 0.5, 0.5])
  })
  assert_eq(r, " i1 d4532020583610935537 d4532020583610935537 i85 d4623868537212645221 | d4607182425232488980 d4621872920981645230 d-4616082013748398822 d-4616082013748397543 d-4616082013748400204 d-4616082013748390142 s\"\"")
}

///|
test "sbcl reference 11: fixpdf circle zero finding" {
  let r = ref_case(s => {
    hp_fixpdf(s, circ_f, circ_fjac, 2, 0, 1.0e-05, 1.0e-08, [0.1, 0.3])
  })
  assert_eq(r, " i1 d4487126258331716666 d4487126258331716666 i69 d4611975352990383181 | d4607182418801800134 d-4613833804947072329 d-4622560616692945879 s\"\"")
}

///|
