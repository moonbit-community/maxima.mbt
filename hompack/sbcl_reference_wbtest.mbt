// Generated by tools/f2cl2mbt.py --lib=hompack --reference-test; do not edit.
// Differential test against the f2cl Lisp of Maxima's share/hompack run under
// SBCL 2.6.9: each case runs the same calls in Lisp and in MoonBit and
// renders every result as IEEE bit patterns, plus the text printed on
// Fortran unit 6.

///|
fn rd(s : StringBuilder, x : Double) -> Unit {
  s.write_string(" d" + x.reinterpret_as_int64().to_string())
}

///|
fn ri(s : StringBuilder, n : Int) -> Unit {
  s.write_string(" i" + n.to_string())
}

///|
fn rb(s : StringBuilder, b : Bool) -> Unit {
  s.write_string(if b { " bT" } else { " bF" })
}

///|
fn rc(s : StringBuilder, z : Complex) -> Unit {
  s.write_string(
    " c" + z.re.reinterpret_as_int64().to_string() + "," +
    z.im.reinterpret_as_int64().to_string(),
  )
}

///|
fn mix(h : UInt64, w : Int64) -> UInt64 {
  (h ^ w.reinterpret_as_uint64()) * 1099511628211UL
}

///|
/// Arrays of more than 64 elements are rendered as an FNV-1a hash of their
/// bit patterns.
fn rhash(s : StringBuilder, n : Int, h : UInt64) -> Unit {
  s.write_string(" |h" + n.to_string() + ":" + h.to_string())
}

///|
fn rad(s : StringBuilder, a : FixedArray[Double]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(h, x.reinterpret_as_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    rd(s, x)
  }
}

///|
fn rai(s : StringBuilder, a : FixedArray[Int]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(h, x.to_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    ri(s, x)
  }
}

///|
fn rac(s : StringBuilder, a : FixedArray[Complex]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(mix(h, x.re.reinterpret_as_int64()), x.im.reinterpret_as_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    rc(s, x)
  }
}

///|
fn quote_text(t : String) -> String {
  let sb = StringBuilder()
  for c in t {
    match c {
      '\n' => sb.write_string("\\n")
      '"' => sb.write_string("\\\"")
      '\\' => sb.write_string("\\\\")
      _ => sb.write_char(c)
    }
  }
  sb.to_string()
}

///|
/// Run `body`, capturing what the routines print.
fn ref_case(body : (StringBuilder) -> Unit raise) -> String raise {
  let s = StringBuilder()
  let text = StringBuilder()
  let saved = @f2cl.output_hook.val
  @f2cl.output_hook.val = t => text.write_string(t)
  body(s) catch {
    e => {
      @f2cl.output_hook.val = saved
      raise e
    }
  }
  @f2cl.output_hook.val = saved
  s.write_string(" s\"" + quote_text(text.to_string()) + "\"")
  s.to_string()
}

///|
fn dvec(xs : Array[Double]) -> FixedArray[Double] {
  FixedArray::from_array(xs)
}

///|
fn cvec(xs : Array[(Double, Double)]) -> FixedArray[Complex] {
  FixedArray::from_array(xs.map(p => cplx(p.0, p.1)))
}


///|
fn ex2_f(x : FixedArray[Double], xo : Int, v : FixedArray[Double], vo : Int) -> Unit raise {
  let x1 = x[xo]
  let x2 = x[xo + 1]
  let x3 = x[xo + 2]
  let x4 = x[xo + 3]
  let x5 = x[xo + 4]
  let s = x1 + x2 + x3 + x4 + x5 - 6.0
  v[vo] = x1 * x2 * x3 * x4 * x5 - 1.0
  v[vo + 1] = s + x2
  v[vo + 2] = s + x3
  v[vo + 3] = s + x4
  v[vo + 4] = s + x5
}

///|
fn ex2_fjac(
  x : FixedArray[Double],
  xo : Int,
  v : FixedArray[Double],
  vo : Int,
  k : Int,
) -> Unit raise {
  let mut p = 1.0
  for j in 0..<5 {
    if j != k - 1 {
      p = p * x[xo + j]
    }
  }
  v[vo] = p
  for i in 1..<5 {
    v[vo + i] = if i == k - 1 { 2.0 } else { 1.0 }
  }
}

///|
fn circ_f(x : FixedArray[Double], xo : Int, v : FixedArray[Double], vo : Int) -> Unit raise {
  let x1 = x[xo]
  let x2 = x[xo + 1]
  v[vo] = x1 * x1 + x2 * x2 - 4.0
  v[vo + 1] = x1 * x2 - 1.0
}

///|
fn circ_fjac(
  x : FixedArray[Double],
  xo : Int,
  v : FixedArray[Double],
  vo : Int,
  k : Int,
) -> Unit raise {
  let x1 = x[xo]
  let x2 = x[xo + 1]
  if k == 1 {
    v[vo] = 2.0 * x1
    v[vo + 1] = x2
  } else {
    v[vo] = 2.0 * x2
    v[vo + 1] = x1
  }
}

///|
fn hp_polsys(
  s : StringBuilder,
  n : Int,
  numt : Array[Int],
  coef : Array[Double],
  kdeg : Array[Int],
  iflg1 : Int,
  iflg2 : Array[Int],
  epsbig : Double,
  epssml : Double,
  sspar : Array[Double],
  numrr : Int,
) -> Unit raise {
  let mut mmaxt = numt[0]
  for t in numt {
    if t > mmaxt {
      mmaxt = t
    }
  }
  let total_deg = iflg2.length()
  let lenwk = 21 + 61 * n + 10 * n * n + 7 * n * mmaxt + 4 * n * n * mmaxt
  let leniwk = 43 + 7 * n + n * (n + 1) * mmaxt
  let wk = FixedArray::make(lenwk, 0.0)
  let iwk = FixedArray::make(lenwk, 0)
  let lamda = FixedArray::make(total_deg, 0.0)
  let arclen = FixedArray::make(total_deg, 0.0)
  let nfe = FixedArray::make(total_deg, 0)
  let roots = FixedArray::make(2 * (n + 1) * total_deg, 0.0)
  let iflg2a = FixedArray::from_array(iflg2)
  let (r_iflg1, r_numrr) = polsys(
    n,
    FixedArray::from_array(numt),
    dvec(coef),
    FixedArray::from_array(kdeg),
    iflg1,
    iflg2a,
    epsbig,
    epssml,
    dvec(sspar),
    numrr,
    n,
    mmaxt,
    total_deg,
    lenwk,
    leniwk,
    lamda,
    roots,
    arclen,
    nfe,
    wk,
    iwk,
  )
  ri(s, r_iflg1)
  ri(s, r_numrr)
  rai(s, iflg2a)
  rad(s, lamda)
  rad(s, roots)
  rad(s, arclen)
  rai(s, nfe)
}

///|
fn zeros(n : Int) -> FixedArray[Double] {
  FixedArray::make(n, 0.0)
}

///|
fn izeros(n : Int) -> FixedArray[Int] {
  FixedArray::make(n, 0)
}

///|
fn hp_set(
  f : (FixedArray[Double], Int, FixedArray[Double], Int) -> Unit raise,
  fj : (FixedArray[Double], Int, FixedArray[Double], Int, Int) -> Unit raise,
) -> Unit {
  f_hook.val = f
  fjac_hook.val = fj
}

///|
fn hp_fixpdf(
  s : StringBuilder,
  f : (FixedArray[Double], Int, FixedArray[Double], Int) -> Unit raise,
  fj : (FixedArray[Double], Int, FixedArray[Double], Int, Int) -> Unit raise,
  n : Int,
  iflag : Int,
  arctol : Double,
  eps : Double,
  a0 : Array[Double],
) -> Unit raise {
  hp_set(f, fj)
  let y = zeros(n + 1)
  let a = zeros(n)
  for k, v in a0 {
    a[k] = v
    y[k + 1] = v
  }
  let (r_iflag, r_arctol, r_eps, r_nfe, r_arclen) = fixpdf(
    n,
    y,
    iflag,
    arctol,
    eps,
    0,
    a,
    n,
    0,
    0.0,
    zeros(n + 1),
    zeros(n + 1),
    zeros(n * (n + 1)),
    zeros(n),
    zeros(n + 1),
    izeros(n + 1),
    zeros(n + 1),
    zeros(16 * (n + 1)),
    zeros(n + 1),
    zeros(1),
    izeros(1),
  )
  ri(s, r_iflag)
  rd(s, r_arctol)
  rd(s, r_eps)
  ri(s, r_nfe)
  rd(s, r_arclen)
  rad(s, y)
}

///|
fn hp_fixpnf(
  s : StringBuilder,
  f : (FixedArray[Double], Int, FixedArray[Double], Int) -> Unit raise,
  fj : (FixedArray[Double], Int, FixedArray[Double], Int, Int) -> Unit raise,
  n : Int,
  iflag : Int,
  arcre : Double,
  ansre : Double,
  a0 : Array[Double],
) -> Unit raise {
  hp_set(f, fj)
  let n1 = n + 1
  let y = zeros(n1)
  let a = zeros(n)
  for k, v in a0 {
    a[k] = v
    y[k + 1] = v
  }
  let sspar = FixedArray::make(8, -1.0)
  let (r_iflag, r_arcre, r_arcae, r_ansre, r_ansae, r_nfe, r_arclen) = fixpnf(
    n,
    y,
    iflag,
    arcre,
    arcre,
    ansre,
    ansre,
    0,
    a,
    0,
    0.0,
    zeros(n1),
    zeros(n1),
    zeros(n1),
    zeros(n * (n + 2)),
    zeros(3 * n1),
    zeros(n1),
    izeros(n1),
    zeros(n1),
    zeros(n1),
    zeros(n1),
    zeros(n1),
    sspar,
    zeros(1),
    izeros(1),
  )
  ri(s, r_iflag)
  rd(s, r_arcre)
  rd(s, r_arcae)
  rd(s, r_ansre)
  rd(s, r_ansae)
  ri(s, r_nfe)
  rd(s, r_arclen)
