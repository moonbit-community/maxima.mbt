          xerrwd(msg, 60, 111, 0, 0, 0, 0, 0, 0.0, 0.0)
        }
        if lavd {
          msg = f2cl_string("      at T = R1 by average no. of linear iterations = R2    ", 60)
          xerrwd(msg, 60, 111, 0, 0, 0, 0, 2, dls001_part_0[216], avdim)
        }
        if lcfn {
          msg = f2cl_string("DLSODPK- Warning. Poor iterative algorithm performance seen ", 60)
          xerrwd(msg, 60, 112, 0, 0, 0, 0, 0, 0.0, 0.0)
        }
        if lcfn {
          msg = f2cl_string("      at T = R1 by nonlinear convergence failure rate = R2  ", 60)
          xerrwd(msg, 60, 112, 0, 0, 0, 0, 2, dls001_part_0[216], rcfn)
        }
        if lcfl {
          msg = f2cl_string("DLSODPK- Warning. Poor iterative algorithm performance seen ", 60)
          xerrwd(msg, 60, 113, 0, 0, 0, 0, 0, 0.0, 0.0)
        }
        if lcfl {
          msg = f2cl_string("      at T = R1 by linear convergence failure rate = R2     ", 60)
          xerrwd(msg, 60, 113, 0, 0, 0, 0, 2, dls001_part_0[216], rcfl)
        }
        pc2 = 20
        continue tb1~
      }
      20 => {
        dewset(dls001_part_1[31], itol, rtol, atol, rwork, dls001_part_1[19] - 1, rwork, dls001_part_1[20] - 1)
        let mut cnt13 = i_max(0, (dls001_part_1[31] - 1 + 1) / 1)
        i = 1
        while cnt13 > 0 {
          if (rwork[((i + dls001_part_1[20]) - 1) - 1]) <= 0.0 {
            pc2 = 33
            continue tb1~
          }
          rwork[((i + dls001_part_1[20]) - 1) - 1] = 1.0 / (rwork[((i + dls001_part_1[20]) - 1) - 1])
          i = i + 1
          cnt13 = cnt13 - 1
        }
        pc2 = 21
        continue tb1~
      }
      21 => {
        tolsf = dls001_part_0[217] * (dvnorm(dls001_part_1[31], rwork, dls001_part_1[19] - 1, rwork, dls001_part_1[20] - 1))
        if tolsf <= 1.0 {
          pc2 = 22
          continue tb1~
        }
        tolsf = tolsf * 2.0
        if dls001_part_1[33] == 0 {
          pc2 = 63
          continue tb1~
        }
        pc2 = 34
        continue tb1~
      }
      22 => {
        if (dls001_part_0[216] + dls001_part_0[211]) != dls001_part_0[216] {
          pc2 = 23
          continue tb1~
        }
        dls001_part_1[3] = dls001_part_1[3] + 1
        if dls001_part_1[3] > dls001_part_1[2] {
          pc2 = 23
          continue tb1~
        }
        msg = f2cl_string("DLSODPK-  Warning..Internal T(=R1) and H(=R2) are ", 60)
        xerrwd(msg, 50, 101, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      such that in the machine, T + H = T on the next step  ", 60)
        xerrwd(msg, 60, 101, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("     (H = step size). Solver will continue anyway.", 60)
        xerrwd(msg, 50, 101, 0, 0, 0, 0, 2, dls001_part_0[216], dls001_part_0[211])
        if dls001_part_1[3] < dls001_part_1[2] {
          pc2 = 23
          continue tb1~
        }
        msg = f2cl_string("DLSODPK-  Above warning has been issued I1 times. ", 60)
        xerrwd(msg, 50, 102, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("     It will not be issued again for this problem.", 60)
        xerrwd(msg, 50, 102, 0, 1, dls001_part_1[2], 0, 0, 0.0, 0.0)
        pc2 = 23
        continue tb1~
      }
      23 => {
        dstodpk(neq, y, rwork, dls001_part_1[19] - 1, dls001_part_1[5], rwork, dls001_part_1[19] - 1, rwork, dls001_part_1[20] - 1, rwork, dls001_part_1[22] - 1, rwork, dlpk01_part_1[4] - 1, rwork, dls001_part_1[21] - 1, rwork, dls001_part_1[23] - 1, iwork, dls001_part_1[24] - 1, f, jac, psol)
        kgo = 1 - dls001_part_1[17]
        match kgo {
          1 => {
            pc2 = 24
            continue tb1~
          }
          2 => {
            pc2 = 35
            continue tb1~
          }
          3 => {
            pc2 = 36
            continue tb1~
          }
          4 => {
            pc2 = 37
            continue tb1~
          }
          _ => ()
        }
        pc2 = 24
        continue tb1~
      }
      24 => {
        dls001_part_1[0] = 1
        match itask {
          1 => {
            pc2 = 25
            continue tb1~
          }
          2 => {
            pc2 = 30
            continue tb1~
          }
          3 => {
            pc2 = 26
            continue tb1~
          }
          4 => {
            pc2 = 27
            continue tb1~
          }
          5 => {
            pc2 = 29
            continue tb1~
          }
          _ => ()
        }
        pc2 = 25
        continue tb1~
      }
      25 => {
        if ((dls001_part_0[216] - tout) * dls001_part_0[211]) < 0.0 {
          pc2 = 19
          continue tb1~
        }
        let mv14 = dintdy(tout, 0, rwork, dls001_part_1[19] - 1, dls001_part_1[5], y, iflag)
        iflag = mv14
        t_ = tout
        pc2 = 31
        continue tb1~
      }
      26 => {
        if ((dls001_part_0[216] - tout) * dls001_part_0[211]) >= 0.0 {
          pc2 = 30
          continue tb1~
        }
        pc2 = 19
        continue tb1~
      }
      27 => {
        if ((dls001_part_0[216] - tout) * dls001_part_0[211]) < 0.0 {
          pc2 = 28
          continue tb1~
        }
        let mv15 = dintdy(tout, 0, rwork, dls001_part_1[19] - 1, dls001_part_1[5], y, iflag)
        iflag = mv15
        t_ = tout
        pc2 = 31
        continue tb1~
      }
      28 => {
        hmx = (d_abs(dls001_part_0[216])) + (d_abs(dls001_part_0[211]))
        ihit = (d_abs((dls001_part_0[216] - tcrit))) <= ((100.0 * dls001_part_0[217]) * hmx)
        if ihit {
          pc2 = 30
          continue tb1~
        }
        tnext = dls001_part_0[216] + (dls001_part_0[211] * (1.0 + (4.0 * dls001_part_0[217])))
        if ((tnext - tcrit) * dls001_part_0[211]) <= 0.0 {
          pc2 = 19
          continue tb1~
        }
        dls001_part_0[211] = (tcrit - dls001_part_0[216]) * (1.0 - (4.0 * dls001_part_0[217]))
        dls001_part_1[16] = -2
        pc2 = 19
        continue tb1~
      }
      29 => {
        hmx = (d_abs(dls001_part_0[216])) + (d_abs(dls001_part_0[211]))
        ihit = (d_abs((dls001_part_0[216] - tcrit))) <= ((100.0 * dls001_part_0[217]) * hmx)
        pc2 = 30
        continue tb1~
      }
      30 => {
        let mut cnt16 = i_max(0, (dls001_part_1[31] - 1 + 1) / 1)
        i = 1
        while cnt16 > 0 {
          y[i - 1] = rwork[((i + dls001_part_1[19]) - 1) - 1]
          i = i + 1
          cnt16 = cnt16 - 1
        }
        t_ = dls001_part_0[216]
        if (itask != 4) && (itask != 5) {
          pc2 = 31
          continue tb1~
        }
        if ihit {
          t_ = tcrit
        }
        pc2 = 31
        continue tb1~
      }
      31 => {
        istate = 2
        rwork[11 - 1] = dls001_part_0[214]
        rwork[12 - 1] = dls001_part_0[211]
        rwork[13 - 1] = dls001_part_0[216]
        iwork[11 - 1] = dls001_part_1[33]
        iwork[12 - 1] = dls001_part_1[34]
        iwork[13 - 1] = dls001_part_1[35]
        iwork[14 - 1] = dls001_part_1[36]
        iwork[15 - 1] = dls001_part_1[32]
        iwork[19 - 1] = dlpk01_part_1[8]
        iwork[20 - 1] = dlpk01_part_1[9]
        iwork[21 - 1] = dlpk01_part_1[10]
        iwork[22 - 1] = dlpk01_part_1[11]
        iwork[23 - 1] = dlpk01_part_1[12]
        return (t_, istate)
      }
      32 => {
        msg = f2cl_string("DLSODPK-  At current T (=R1), MXSTEP (=I1) steps  ", 60)
        xerrwd(msg, 50, 201, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      taken on this call before reaching TOUT     ", 60)
        xerrwd(msg, 50, 201, 0, 1, dls001_part_1[1], 0, 1, dls001_part_0[216], 0.0)
        istate = -1
        pc2 = 39
        continue tb1~
      }
      33 => {
        ewti = rwork[((dls001_part_1[20] + i) - 1) - 1]
        msg = f2cl_string("DLSODPK-  At T (=R1), EWT(I1) has become R2 <= 0. ", 60)
        xerrwd(msg, 50, 202, 0, 1, i, 0, 2, dls001_part_0[216], ewti)
        istate = -6
        pc2 = 39
        continue tb1~
      }
      34 => {
        msg = f2cl_string("DLSODPK-  At T (=R1), too much accuracy requested ", 60)
        xerrwd(msg, 50, 203, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      for precision of machine..  See TOLSF (=R2) ", 60)
        xerrwd(msg, 50, 203, 0, 0, 0, 0, 2, dls001_part_0[216], tolsf)
        rwork[14 - 1] = tolsf
        istate = -2
        pc2 = 39
        continue tb1~
      }
      35 => {
        msg = f2cl_string("DLSODPK-  At T(=R1), step size H(=R2), the error  ", 60)
        xerrwd(msg, 50, 204, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      test failed repeatedly or with ABS(H) = HMIN", 60)
        xerrwd(msg, 50, 204, 0, 0, 0, 0, 2, dls001_part_0[216], dls001_part_0[211])
        istate = -4
        pc2 = 38
        continue tb1~
      }
      36 => {
        msg = f2cl_string("DLSODPK-  At T (=R1) and step size H (=R2), the   ", 60)
        xerrwd(msg, 50, 205, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      corrector convergence failed repeatedly     ", 60)
        xerrwd(msg, 50, 205, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      or with ABS(H) = HMIN   ", 60)
        xerrwd(msg, 30, 205, 0, 0, 0, 0, 2, dls001_part_0[216], dls001_part_0[211])
        istate = -5
        pc2 = 38
        continue tb1~
      }
      37 => {
        msg = f2cl_string("DLSODPK-  At T (=R1) an unrecoverable error return", 60)
        xerrwd(msg, 50, 205, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      was made from Subroutine PSOL     ", 60)
        xerrwd(msg, 40, 205, 0, 0, 0, 0, 1, dls001_part_0[216], 0.0)
        istate = -7
        pc2 = 39
        continue tb1~
      }
      38 => {
        big = 0.0
        imxer = 1
        let mut cnt17 = i_max(0, (dls001_part_1[31] - 1 + 1) / 1)
        i = 1
        while cnt17 > 0 {
          tb18~: while true {
            size = d_abs(((rwork[((i + dls001_part_1[21]) - 1) - 1]) * (rwork[((i + dls001_part_1[20]) - 1) - 1])))
            if big >= size {
              break tb18~
            }
            big = size
            imxer = i
            break tb18~
          }
          i = i + 1
          cnt17 = cnt17 - 1
        }
        iwork[16 - 1] = imxer
        pc2 = 39
        continue tb1~
      }
      39 => {
        let mut cnt19 = i_max(0, (dls001_part_1[31] - 1 + 1) / 1)
        i = 1
        while cnt19 > 0 {
          y[i - 1] = rwork[((i + dls001_part_1[19]) - 1) - 1]
          i = i + 1
          cnt19 = cnt19 - 1
        }
        t_ = dls001_part_0[216]
        rwork[11 - 1] = dls001_part_0[214]
        rwork[12 - 1] = dls001_part_0[211]
        rwork[13 - 1] = dls001_part_0[216]
        iwork[11 - 1] = dls001_part_1[33]
        iwork[12 - 1] = dls001_part_1[34]
        iwork[13 - 1] = dls001_part_1[35]
        iwork[14 - 1] = dls001_part_1[36]
        iwork[15 - 1] = dls001_part_1[32]
        iwork[19 - 1] = dlpk01_part_1[8]
        iwork[20 - 1] = dlpk01_part_1[9]
        iwork[21 - 1] = dlpk01_part_1[10]
        iwork[22 - 1] = dlpk01_part_1[11]
        iwork[23 - 1] = dlpk01_part_1[12]
        return (t_, istate)
      }
      40 => {
        msg = f2cl_string("DLSODPK-  ISTATE(=I1) illegal.", 60)
        xerrwd(msg, 30, 1, 0, 1, istate, 0, 0, 0.0, 0.0)
        if istate < 0 {
          pc2 = 66
          continue tb1~
        }
        pc2 = 65
        continue tb1~
      }
      41 => {
        msg = f2cl_string("DLSODPK-  ITASK (=I1) illegal.", 60)
        xerrwd(msg, 30, 2, 0, 1, itask, 0, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      42 => {
        msg = f2cl_string("DLSODPK-  ISTATE > 1 but DLSODPK not initialized.", 60)
        xerrwd(msg, 50, 3, 0, 0, 0, 0, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      43 => {
        msg = f2cl_string("DLSODPK-  NEQ (=I1)  <  1    ", 60)
        xerrwd(msg, 30, 4, 0, 1, neq[1 - 1], 0, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      44 => {
        msg = f2cl_string("DLSODPK-  ISTATE = 3 and NEQ increased (I1 to I2).", 60)
        xerrwd(msg, 50, 5, 0, 2, dls001_part_1[31], neq[1 - 1], 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      45 => {
        msg = f2cl_string("DLSODPK-  ITOL (=I1) illegal. ", 60)
        xerrwd(msg, 30, 6, 0, 1, itol, 0, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      46 => {
        msg = f2cl_string("DLSODPK-  IOPT (=I1) illegal. ", 60)
        xerrwd(msg, 30, 7, 0, 1, iopt, 0, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      47 => {
        msg = f2cl_string("DLSODPK-  MF (=I1) illegal.   ", 60)
        xerrwd(msg, 30, 8, 0, 1, mf, 0, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      48 => {
        msg = f2cl_string("DLSODPK-  MAXORD (=I1)  <  0 ", 60)
        xerrwd(msg, 30, 11, 0, 1, dls001_part_1[27], 0, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      49 => {
        msg = f2cl_string("DLSODPK-  MXSTEP (=I1)  <  0 ", 60)
        xerrwd(msg, 30, 12, 0, 1, dls001_part_1[1], 0, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      50 => {
        msg = f2cl_string("DLSODPK-  MXHNIL (=I1)  <  0 ", 60)
        xerrwd(msg, 30, 13, 0, 1, dls001_part_1[2], 0, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      51 => {
        msg = f2cl_string("DLSODPK-  TOUT (=R1) behind T (=R2)     ", 60)
        xerrwd(msg, 40, 14, 0, 0, 0, 0, 2, tout, t_)
        msg = f2cl_string("      Integration direction is given by H0 (=R1)  ", 60)
        xerrwd(msg, 50, 14, 0, 0, 0, 0, 1, h0, 0.0)
        pc2 = 65
        continue tb1~
      }
      52 => {
        msg = f2cl_string("DLSODPK-  HMAX (=R1)  <  0.0 ", 60)
        xerrwd(msg, 30, 15, 0, 0, 0, 0, 1, hmax, 0.0)
        pc2 = 65
        continue tb1~
      }
      53 => {
        msg = f2cl_string("DLSODPK-  HMIN (=R1)  <  0.0 ", 60)
        xerrwd(msg, 30, 16, 0, 0, 0, 0, 1, dls001_part_0[212], 0.0)
        pc2 = 65
        continue tb1~
      }
      54 => {
        msg = f2cl_string("DLSODPK-  RWORK length needed, LENRW(=I1), exceeds LRW(=I2) ", 60)
        xerrwd(msg, 60, 17, 0, 2, lenrw, lrw, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      55 => {
        msg = f2cl_string("DLSODPK-  IWORK length needed, LENIW(=I1), exceeds LIW(=I2) ", 60)
        xerrwd(msg, 60, 18, 0, 2, leniw, liw, 0, 0.0, 0.0)
        pc2 = 65
        continue tb1~
      }
      56 => {
        msg = f2cl_string("DLSODPK-  RTOL(I1) is R1  <  0.0       ", 60)
        xerrwd(msg, 40, 19, 0, 1, i, 0, 1, rtoli, 0.0)
        pc2 = 65
        continue tb1~
      }
      57 => {
        msg = f2cl_string("DLSODPK-  ATOL(I1) is R1  <  0.0       ", 60)
        xerrwd(msg, 40, 20, 0, 1, i, 0, 1, atoli, 0.0)
        pc2 = 65
        continue tb1~
      }
      58 => {
        ewti = rwork[((dls001_part_1[20] + i) - 1) - 1]
        msg = f2cl_string("DLSODPK-  EWT(I1) is R1  <=  0.0        ", 60)
        xerrwd(msg, 40, 21, 0, 1, i, 0, 1, ewti, 0.0)
        pc2 = 65
        continue tb1~
      }
      59 => {
        msg = f2cl_string("DLSODPK- TOUT(=R1) too close to T(=R2) to start integration.", 60)
        xerrwd(msg, 60, 22, 0, 0, 0, 0, 2, tout, t_)
        pc2 = 65
        continue tb1~
      }
      60 => {
        msg = f2cl_string("DLSODPK-  ITASK = I1 and TOUT (=R1) behind TCUR - HU (= R2) ", 60)
        xerrwd(msg, 60, 23, 0, 1, itask, 0, 2, tout, tp)
        pc2 = 65
        continue tb1~
      }
      61 => {
        msg = f2cl_string("DLSODPK-  ITASK = 4 or 5 and TCRIT (=R1) behind TCUR (=R2)  ", 60)
        xerrwd(msg, 60, 24, 0, 0, 0, 0, 2, tcrit, dls001_part_0[216])
        pc2 = 65
        continue tb1~
      }
      62 => {
        msg = f2cl_string("DLSODPK-  ITASK = 4 or 5 and TCRIT (=R1) behind TOUT (=R2)  ", 60)
        xerrwd(msg, 60, 25, 0, 0, 0, 0, 2, tcrit, tout)
        pc2 = 65
        continue tb1~
      }
      63 => {
        msg = f2cl_string("DLSODPK-  At start of problem, too much accuracy  ", 60)
        xerrwd(msg, 50, 26, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      requested for precision of machine..  See TOLSF (=R1) ", 60)
        xerrwd(msg, 60, 26, 0, 0, 0, 0, 1, tolsf, 0.0)
        rwork[14 - 1] = tolsf
        pc2 = 65
        continue tb1~
      }
      64 => {
        msg = f2cl_string("DLSODPK-  Trouble in DINTDY. ITASK = I1, TOUT = R1", 60)
        xerrwd(msg, 50, 27, 0, 1, itask, 0, 1, tout, 0.0)
        pc2 = 65
        continue tb1~
      }
      65 => {
        istate = -3
        return (t_, istate)
      }
      66 => {
        msg = f2cl_string("DLSODPK-  Run aborted.. apparent infinite loop.   ", 60)
        xerrwd(msg, 50, 303, 2, 0, 0, 0, 0, 0.0, 0.0)
        return (t_, istate)
      }
      67 => {
        return (t_, istate)
      }
      _ => panic()
    }
  }
  panic()
}
