        msg = f2cl_string("DLSODAR-  ITASK = 4 or 5 and TCRIT (=R1) behind TCUR (=R2)  ", 60)
        xerrwd(msg, 60, 24, 0, 0, 0, 0, 2, tcrit, dls001_part_0[216])
        pc2 = 81
        continue tb1~
      }
      73 => {
        msg = f2cl_string("DLSODAR-  ITASK = 4 or 5 and TCRIT (=R1) behind TOUT (=R2)  ", 60)
        xerrwd(msg, 60, 25, 0, 0, 0, 0, 2, tcrit, tout)
        pc2 = 81
        continue tb1~
      }
      74 => {
        msg = f2cl_string("DLSODAR-  At start of problem, too much accuracy  ", 60)
        xerrwd(msg, 50, 26, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      requested for precision of machine..  See TOLSF (=R1) ", 60)
        xerrwd(msg, 60, 26, 0, 0, 0, 0, 1, tolsf, 0.0)
        rwork[14 - 1] = tolsf
        pc2 = 81
        continue tb1~
      }
      75 => {
        msg = f2cl_string("DLSODAR-  Trouble in DINTDY. ITASK = I1, TOUT = R1", 60)
        xerrwd(msg, 50, 27, 0, 1, itask, 0, 1, tout, 0.0)
        pc2 = 81
        continue tb1~
      }
      76 => {
        msg = f2cl_string("DLSODAR-  MXORDN (=I1)  <  0 ", 60)
        xerrwd(msg, 30, 28, 0, 1, dlsa01_part_1[7], 0, 0, 0.0, 0.0)
        pc2 = 81
        continue tb1~
      }
      77 => {
        msg = f2cl_string("DLSODAR-  MXORDS (=I1)  <  0 ", 60)
        xerrwd(msg, 30, 29, 0, 1, dlsa01_part_1[8], 0, 0, 0.0, 0.0)
        pc2 = 81
        continue tb1~
      }
      78 => {
        msg = f2cl_string("DLSODAR-  NG (=I1)  <  0     ", 60)
        xerrwd(msg, 30, 30, 0, 1, ng, 0, 0, 0.0, 0.0)
        pc2 = 81
        continue tb1~
      }
      79 => {
        msg = f2cl_string("DLSODAR-  NG changed (from I1 to I2) illegally,   ", 60)
        xerrwd(msg, 50, 31, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      i.e. not immediately after a root was found.", 60)
        xerrwd(msg, 50, 31, 0, 2, dlsr01_part_1[7], ng, 0, 0.0, 0.0)
        pc2 = 81
        continue tb1~
      }
      80 => {
        msg = f2cl_string("DLSODAR-  One or more components of g has a root  ", 60)
        xerrwd(msg, 50, 32, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      too near to the initial point.    ", 60)
        xerrwd(msg, 40, 32, 0, 0, 0, 0, 0, 0.0, 0.0)
        pc2 = 81
        continue tb1~
      }
      81 => {
        istate = -3
        return (t_, istate)
      }
      82 => {
        msg = f2cl_string("DLSODAR-  Run aborted.. apparent infinite loop.   ", 60)
        xerrwd(msg, 50, 303, 2, 0, 0, 0, 0, 0.0, 0.0)
        return (t_, istate)
      }
      83 => {
        return (t_, istate)
      }
      _ => panic()
    }
  }
  panic()
}
