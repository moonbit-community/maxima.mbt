// Generated by tools/f2cl2mbt.py --lib=odepack --reference-test; do not edit.
// Differential test against the f2cl Lisp of Maxima's share/odepack run under
// SBCL 2.6.9: each case runs the same calls in Lisp and in MoonBit and
// renders every result as IEEE bit patterns, plus the text printed on
// Fortran unit 6.

///|
fn rd(s : StringBuilder, x : Double) -> Unit {
  s.write_string(" d" + x.reinterpret_as_int64().to_string())
}

///|
fn ri(s : StringBuilder, n : Int) -> Unit {
  s.write_string(" i" + n.to_string())
}

///|
fn rb(s : StringBuilder, b : Bool) -> Unit {
  s.write_string(if b { " bT" } else { " bF" })
}

///|
fn rc(s : StringBuilder, z : Complex) -> Unit {
  s.write_string(
    " c" + z.re.reinterpret_as_int64().to_string() + "," +
    z.im.reinterpret_as_int64().to_string(),
  )
}

///|
fn mix(h : UInt64, w : Int64) -> UInt64 {
  (h ^ w.reinterpret_as_uint64()) * 1099511628211UL
}

///|
/// Arrays of more than 64 elements are rendered as an FNV-1a hash of their
/// bit patterns.
fn rhash(s : StringBuilder, n : Int, h : UInt64) -> Unit {
  s.write_string(" |h" + n.to_string() + ":" + h.to_string())
}

///|
fn rad(s : StringBuilder, a : FixedArray[Double]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(h, x.reinterpret_as_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    rd(s, x)
  }
}

///|
fn rai(s : StringBuilder, a : FixedArray[Int]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(h, x.to_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    ri(s, x)
  }
}

///|
fn rac(s : StringBuilder, a : FixedArray[Complex]) -> Unit {
  if a.length() > 64 {
    let mut h = 14695981039346656037UL
    for x in a {
      h = mix(mix(h, x.re.reinterpret_as_int64()), x.im.reinterpret_as_int64())
    }
    rhash(s, a.length(), h)
    return
  }
  s.write_string(" |")
  for x in a {
    rc(s, x)
  }
}

///|
fn quote_text(t : String) -> String {
  let sb = StringBuilder()
  for c in t {
    match c {
      '\n' => sb.write_string("\\n")
      '"' => sb.write_string("\\\"")
      '\\' => sb.write_string("\\\\")
      _ => sb.write_char(c)
    }
  }
  sb.to_string()
}

///|
/// Run `body`, capturing what the routines print.
fn ref_case(body : (StringBuilder) -> Unit raise) -> String raise {
  let s = StringBuilder()
  let text = StringBuilder()
  let saved = @f2cl.output_hook.val
  @f2cl.output_hook.val = t => text.write_string(t)
  body(s) catch {
    e => {
      @f2cl.output_hook.val = saved
      raise e
    }
  }
  @f2cl.output_hook.val = saved
  s.write_string(" s\"" + quote_text(text.to_string()) + "\"")
  s.to_string()
}

///|
fn dvec(xs : Array[Double]) -> FixedArray[Double] {
  FixedArray::from_array(xs)
}

///|
fn cvec(xs : Array[(Double, Double)]) -> FixedArray[Complex] {
  FixedArray::from_array(xs.map(p => cplx(p.0, p.1)))
}


///|
fn rob_f(
  _neq : FixedArray[Int],
  _t : Double,
  y : FixedArray[Double],
  yo : Int,
  ydot : FixedArray[Double],
  dofs : Int,
) -> Unit raise {
  ydot[dofs + 0] = -0.04 * y[yo + 0] + 1.0e4 * y[yo + 1] * y[yo + 2]
  ydot[dofs + 2] = 3.0e7 * y[yo + 1] * y[yo + 1]
  ydot[dofs + 1] = -ydot[dofs + 0] - ydot[dofs + 2]
}

///|
fn rob_jac(
  _neq : FixedArray[Int],
  _t : Double,
  y : FixedArray[Double],
  _ml : Int,
  _mu : Int,
  pd : FixedArray[Double],
  po : Int,
  nrpd : Int,
) -> Unit raise {
  pd[po + 0] = -0.04
  pd[po + 1] = 0.04
  pd[po + 2] = 0.0
  pd[po + nrpd] = 1.0e4 * y[2]
  pd[po + nrpd + 1] = -1.0e4 * y[2] - 6.0e7 * y[1]
  pd[po + nrpd + 2] = 6.0e7 * y[1]
  pd[po + 2 * nrpd] = 1.0e4 * y[1]
  pd[po + 2 * nrpd + 1] = -1.0e4 * y[1]
  pd[po + 2 * nrpd + 2] = 0.0
}

///|
fn osc_f(
  _neq : FixedArray[Int],
  t : Double,
  y : FixedArray[Double],
  yo : Int,
  ydot : FixedArray[Double],
  dofs : Int,
) -> Unit raise {
  ydot[dofs + 0] = y[yo + 1]
  ydot[dofs + 1] = -1.0 * y[yo + 0] - 0.1 * y[yo + 1] - @f2cl.f_sin(t)
}

///|
fn osc_jac(
  _neq : FixedArray[Int],
  _t : Double,
  _y : FixedArray[Double],
  _ml : Int,
  _mu : Int,
  pd : FixedArray[Double],
  po : Int,
  nrpd : Int,
) -> Unit raise {
  pd[po + 0] = 0.0
  pd[po + 1] = -1.0
  pd[po + nrpd] = 1.0
  pd[po + nrpd + 1] = -0.1
}

///|
fn ode_run(
  s : StringBuilder,
  f : (FixedArray[Int], Double, FixedArray[Double], Int, FixedArray[Double], Int) -> Unit raise,
  jac : (FixedArray[Int], Double, FixedArray[Double], Int, Int, FixedArray[Double], Int, Int) -> Unit raise,
  mf : Int,
  itol : Int,
  rtol : Double,
  atols : Array[Double],
  y0 : Array[Double],
  t0 : Double,
  tout0 : Double,
  nout : Int,
  factor : Double,
  maxima_style : Bool,
) -> Unit raise {
  let neq = y0.length()
  let lrw = if mf == 10 { 20 + 16 * neq } else { 22 + 9 * neq + neq * neq }
  let liw = if mf == 10 { 20 } else { 20 + neq }
  let rwork = FixedArray::make(lrw, 0.0)
  let iwork = FixedArray::make(liw, 0)
  let mut y = dvec(y0)
  let mut tt = t0
  let mut tout = tout0
  let mut istate = 1
  for _k in 0..<nout {
    if maxima_style {
      y = dvec(y0)
      tt = t0
    }
    let (rt, ri_) = dlsode(
      f, [neq], y, tt, tout, itol, [rtol], dvec(atols), 1, istate, 0, rwork, lrw,
      iwork, liw, jac, mf,
    )
    tt = rt
    istate = ri_
    rd(s, tt)
    ri(s, istate)
    rad(s, y)
    if istate < 0 {
      break
    }
    if factor == 0.0 {
      tout = tout + tout0
    } else {
      tout = tout * factor
    }
  }
  rai(s, iwork)
  rad(s, rwork)
}

///|
fn ode_loop(
  s : StringBuilder,
  step : (Double, Double, Int) -> (Double, Int) raise,
  y : FixedArray[Double],
  t0 : Double,
  tout0 : Double,
  nout : Int,
  factor : Double,
  istate0 : Int,
  extra : (() -> Unit)?,
) -> Unit raise {
  let mut tt = t0
  let mut tout = tout0
  let mut istate = istate0
  for _k in 0..<nout {
    let (rt, ri_) = step(tt, tout, istate)
    tt = rt
    istate = ri_
    rd(s, tt)
    ri(s, istate)
    rad(s, y)
    if extra is Some(e) {
      e()
    }
    if istate < 0 {
      break
    }
    if istate != 3 {
      if factor == 0.0 {
        tout = tout + tout0
      } else {
        tout = tout * factor
      }
    }
  }
}

///|
fn rob_g(
  neq : FixedArray[Int],
  _t : Double,
  y : FixedArray[Double],
  yo : Int,
  _ng : Int,
  gout : FixedArray[Double],
  go : Int,
) -> Unit raise {
  gout[go] = y[yo] - 1.0e-4
  gout[go + 1] = y[yo + neq[0] - 1] - 1.0e-2
}

///|
fn rob_jacs(
  _neq : FixedArray[Int],
  _t : Double,
  y : FixedArray[Double],
  yo : Int,
  j : Int,
  _ian : FixedArray[Int],
  _iano : Int,
  _jan : FixedArray[Int],
  _jano : Int,
  pdj : FixedArray[Double],
  po : Int,
) -> Unit raise {
  match j {
    1 => {
      pdj[po] = -0.04
      pdj[po + 1] = 0.04
      pdj[po + 2] = 0.0
    }
    2 => {
      pdj[po] = 1.0e4 * y[yo + 2]
      pdj[po + 1] = -1.0e4 * y[yo + 2] - 6.0e7 * y[yo + 1]
      pdj[po + 2] = 6.0e7 * y[yo + 1]
    }
    _ => {
      pdj[po] = 1.0e4 * y[yo + 1]
      pdj[po + 1] = -1.0e4 * y[yo + 1]
      pdj[po + 2] = 0.0
    }
  }
}

///|
fn rob_res(
  _neq : FixedArray[Int],
  _t : Double,
  y : FixedArray[Double],
  yo : Int,
  s : FixedArray[Double],
  so : Int,
  r : FixedArray[Double],
  ro : Int,
  ires : Int,
) -> Int raise {
  let y0 = y[yo]
  let y1 = y[yo + 1]
  let y2 = y[yo + 2]
  let f0 = -0.04 * y0 + 1.0e4 * y1 * y2
  let f2 = 3.0e7 * y1 * y1
  let f1 = -f0 - f2
  r[ro] = f0 - s[so]
  r[ro + 1] = f1 - s[so + 1]
  r[ro + 2] = f2 - s[so + 2]
  ires
}

///|
fn rob_adda(
  _neq : FixedArray[Int],
  _t : Double,
  _y : FixedArray[Double],
  _yo : Int,
  _ml : Int,
  _mu : Int,
  p : FixedArray[Double],
  po : Int,
  nrowp : Int,
) -> Unit raise {
  for i in 0..<3 {
    p[po + i + i * nrowp] = p[po + i + i * nrowp] + 1.0
  }
}

///|
fn rob_jaci(
  neq : FixedArray[Int],
  t : Double,
  y : FixedArray[Double],
  yo : Int,
  _s : FixedArray[Double],
  _so : Int,
  ml : Int,
  mu : Int,
  p : FixedArray[Double],
  po : Int,
  nrowp : Int,
) -> Unit raise {
  // rob_jac reads y from its start
  let yy = FixedArray::make(3, 0.0)
  for i in 0..<3 {
    yy[i] = y[yo + i]
  }
  rob_jac(neq, t, yy, ml, mu, p, po, nrowp)
}

///|
fn rob_addas(
  _neq : FixedArray[Int],
  _t : Double,
  _y : FixedArray[Double],
  _yo : Int,
  j : Int,
  _ian : FixedArray[Int],
  _iano : Int,
  _jan : FixedArray[Int],
  _jano : Int,
  p : FixedArray[Double],
  po : Int,
) -> Unit raise {
  p[po + j - 1] = p[po + j - 1] + 1.0
}

///|
fn rob_jacis(
  neq : FixedArray[Int],
  t : Double,
  y : FixedArray[Double],
  yo : Int,
  _s : FixedArray[Double],
  _so : Int,
  j : Int,
  ian : FixedArray[Int],
  iano : Int,
  jan : FixedArray[Int],
  jano : Int,
  p : FixedArray[Double],
  po : Int,
) -> Unit raise {
  rob_jacs(neq, t, y, yo, j, ian, iano, jan, jano, p, po)
}

///|
fn heat_res(
  neq : FixedArray[Int],
  _t : Double,
  y : FixedArray[Double],
  yo : Int,
  s : FixedArray[Double],
  so : Int,
  r : FixedArray[Double],
  ro : Int,
  ires : Int,
) -> Int raise {
  let n = neq[0]
  for i in 0..<n {
    let yl = if i > 0 { y[yo + i - 1] } else { 0.0 }
    let yr = if i < n - 1 { y[yo + i + 1] } else { 0.0 }
    r[ro + i] = yl - 2.0 * y[yo + i] + yr - s[so + i]
  }
  ires
}

///|
fn heat_adda(
  _neq : FixedArray[Int],
  _t : Double,
  _y : FixedArray[Double],
  _yo : Int,
  _mb : Int,
  nb : Int,
  pa : FixedArray[Double],
  pao : Int,
  _pb : FixedArray[Double],
  _pbo : Int,
  _pc : FixedArray[Double],
  _pco : Int,
) -> Unit raise {
  for k in 0..<nb {
    pa[pao + k] = pa[pao + k] + 1.0
  }
}

///|
fn heat_jac(
  _neq : FixedArray[Int],
  _t : Double,
  _y : FixedArray[Double],
  _yo : Int,
  _s : FixedArray[Double],
  _so : Int,
  _mb : Int,
  nb : Int,
  pa : FixedArray[Double],
  pao : Int,
  pb : FixedArray[Double],
  pbo : Int,
  pc : FixedArray[Double],
  pco : Int,
) -> Unit raise {
  for k in 0..<nb {
    pa[pao + k] = -2.0
    pb[pbo + k] = if k < nb - 1 { 1.0 } else { 0.0 }
    pc[pco + k] = if k > 0 { 1.0 } else { 0.0 }
  }
}

