///|
test "sbcl reference 7: illegal input (negative rtol)" {
  let r = ref_case(s => {
    ode_run(s, osc_f, osc_jac, 22, 1, (-1.0e-06), [1.0e-08], [1.0, 0.0], 0.0, 0.5, 2, 0.0, true)
  })
  assert_eq(r, " d0 i-3 | d4607182418800017408 d0 | i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i0 i44 i22 i0 i0 i0 i0 | d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 d0 s\" DLSODE-  RTOL(I1) is R1  <  0.0                                                 \\n      In above message,  I1 =         1\\n      In above message,  R1 = -0.1000000000000D-05\\n\"")
}

