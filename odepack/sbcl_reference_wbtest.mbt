///|
fn set_iwork(iwork : FixedArray[Int], iw : Array[(Int, Int)]) -> Unit {
  for p in iw {
    iwork[p.0] = p.1
  }
}

///|
fn ode_explicit(
  s : StringBuilder,
  solver : String,
  f : (FixedArray[Int], Double, FixedArray[Double], Int, FixedArray[Double], Int) -> Unit raise,
  jac : (FixedArray[Int], Double, FixedArray[Double], Int, Int, FixedArray[Double], Int, Int) -> Unit raise,
  mf : Int,
  y0 : Array[Double],
  rtol : Double,
  atol : Double,
  t0 : Double,
  tout0 : Double,
  nout : Int,
  factor : Double,
  lrw : Int,
  liw : Int,
  iopt : Int,
  iw : Array[(Int, Int)],
  extra : Bool,
) -> Unit raise {
  let neq = y0.length()
  let y = dvec(y0)
  let rwork = FixedArray::make(lrw, 0.0)
  let iwork = FixedArray::make(liw, 0)
  let jroot = FixedArray::make(2, 0)
  set_iwork(iwork, iw)
  let step = fn(tt : Double, tout : Double, istate : Int) -> (Double, Int) raise {
    match solver {
      "dlsoda" =>
        dlsoda(
          f, [neq], y, tt, tout, 1, [rtol], [atol], 1, istate, iopt, rwork, lrw, iwork, liw,
          jac, mf,
        )
      "dlsodes" =>
        dlsodes(
          f, [neq], y, tt, tout, 1, [rtol], [atol], 1, istate, iopt, rwork, lrw, iwork, liw,
          rob_jacs, mf,
        )
      "dlsodar" =>
        dlsodar(
          f, [neq], y, tt, tout, 1, [rtol], [atol], 1, istate, iopt, rwork, lrw, iwork, liw,
          jac, mf, rob_g, 2, jroot,
        )
      "dlsodpk" =>
        dlsodpk(
          f, [neq], y, tt, tout, 1, [rtol], [atol], 1, istate, iopt, rwork, lrw, iwork, liw,
          id_jac, id_psol, mf,
        )
      _ =>
        dlsodkr(
          f, [neq], y, tt, tout, 1, [rtol], [atol], 1, istate, iopt, rwork, lrw, iwork, liw,
          id_jack, id_psol, mf, rob_g, 2, jroot,
        )
    }
  }
  ode_loop(
    s,
    step,
    y,
    t0,
    tout0,
    nout,
    factor,
    1,
    if extra {
      Some(() => rai(s, jroot))
    } else {
      None
    },
  )
  rai(s, iwork)
  rad(s, rwork)
}

///|
fn ode_implicit(
  s : StringBuilder,
  solver : String,
  mf : Int,
  y0 : Array[Double],
  yd0 : Array[Double],
  istate0 : Int,
  rtol : Double,
  atol : Double,
  t0 : Double,
  tout0 : Double,
  nout : Int,
  factor : Double,
  lrw : Int,
  liw : Int,
  iw : Array[(Int, Int)],
) -> Unit raise {
  let neq = y0.length()
  let y = dvec(y0)
  let ydoti = dvec(yd0)
  let rwork = FixedArray::make(lrw, 0.0)
  let iwork = FixedArray::make(liw, 0)
  set_iwork(iwork, iw)
  let step = fn(tt : Double, tout : Double, istate : Int) -> (Double, Int) raise {
    match solver {
      "dlsodi" =>
        dlsodi(
          rob_res, rob_adda, rob_jaci, [neq], y, ydoti, tt, tout, 1, [rtol], [atol], 1, istate,
          0, rwork, lrw, iwork, liw, mf,
        )
      "dlsoibt" =>
        dlsoibt(
          heat_res, heat_adda, heat_jac, [neq], y, ydoti, tt, tout, 1, [rtol], [atol], 1, istate,
          0, rwork, lrw, iwork, liw, mf,
        )
      _ =>
        dlsodis(
          rob_res, rob_addas, rob_jacis, [neq], y, ydoti, tt, tout, 1, [rtol], [atol], 1, istate,
          0, rwork, lrw, iwork, liw, mf,
        )
    }
  }
  ode_loop(s, step, y, t0, tout0, nout, factor, istate0, None)
  rad(s, ydoti)
  rai(s, iwork)
  rad(s, rwork)
}

