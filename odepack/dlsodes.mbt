      70 => {
        msg = f2cl_string("DLSODES- RWORK length insufficient (for Subroutine JGROUP). ", 60)
        xerrwd(msg, 60, 29, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("        Length needed is  >=  LENRW (=I1), exceeds LRW (=I2)", 60)
        xerrwd(msg, 60, 29, 0, 2, lenrw, lrw, 0, 0.0, 0.0)
        pc2 = 75
        continue tb1~
      }
      71 => {
        msg = f2cl_string("DLSODES- RWORK length insufficient (for Subroutine ODRV).   ", 60)
        xerrwd(msg, 60, 30, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("        Length needed is  >=  LENRW (=I1), exceeds LRW (=I2)", 60)
        xerrwd(msg, 60, 30, 0, 2, lenrw, lrw, 0, 0.0, 0.0)
        pc2 = 75
        continue tb1~
      }
      72 => {
        msg = f2cl_string("DLSODES- Error from ODRV in Yale Sparse Matrix Package.     ", 60)
        xerrwd(msg, 60, 31, 0, 0, 0, 0, 0, 0.0, 0.0)
        imul = (dlss01_part_1[3] - 1) / dls001_part_1[31]
        irem = dlss01_part_1[3] - (imul * dls001_part_1[31])
        msg = f2cl_string("      At T (=R1), ODRV returned error flag = I1*NEQ + I2.   ", 60)
        xerrwd(msg, 60, 31, 0, 2, imul, irem, 1, dls001_part_0[216], 0.0)
        pc2 = 75
        continue tb1~
      }
      73 => {
        msg = f2cl_string("DLSODES- RWORK length insufficient (for Subroutine CDRV).   ", 60)
        xerrwd(msg, 60, 32, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("        Length needed is  >=  LENRW (=I1), exceeds LRW (=I2)", 60)
        xerrwd(msg, 60, 32, 0, 2, lenrw, lrw, 0, 0.0, 0.0)
        pc2 = 75
        continue tb1~
      }
      74 => {
        msg = f2cl_string("DLSODES- Error from CDRV in Yale Sparse Matrix Package.     ", 60)
        xerrwd(msg, 60, 33, 0, 0, 0, 0, 0, 0.0, 0.0)
        imul = (dlss01_part_1[3] - 1) / dls001_part_1[31]
        irem = dlss01_part_1[3] - (imul * dls001_part_1[31])
        msg = f2cl_string("      At T (=R1), CDRV returned error flag = I1*NEQ + I2.   ", 60)
        xerrwd(msg, 60, 33, 0, 2, imul, irem, 1, dls001_part_0[216], 0.0)
        if imul == 2 {
          msg = f2cl_string("        Duplicate entry in sparsity structure descriptors.  ", 60)
          xerrwd(msg, 60, 33, 0, 0, 0, 0, 0, 0.0, 0.0)
        }
        if (imul == 3) || (imul == 6) {
          msg = f2cl_string("        Insufficient storage for NSFC (called by CDRV).     ", 60)
          xerrwd(msg, 60, 33, 0, 0, 0, 0, 0, 0.0, 0.0)
        }
        pc2 = 75
        continue tb1~
      }
      75 => {
        istate = -3
        return (t_, istate)
      }
      76 => {
        msg = f2cl_string("DLSODES- Run aborted.. apparent infinite loop.    ", 60)
        xerrwd(msg, 50, 303, 2, 0, 0, 0, 0, 0.0, 0.0)
        return (t_, istate)
      }
      77 => {
        return (t_, istate)
      }
      _ => panic()
    }
  }
  panic()
}
