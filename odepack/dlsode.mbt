        iflag = mv15
        t_ = tout
        pc2 = 31
        continue tb1~
      }
      26 => {
        if ((dls001_part_0[216] - tout) * dls001_part_0[211]) >= 0.0 {
          pc2 = 30
          continue tb1~
        }
        pc2 = 20
        continue tb1~
      }
      27 => {
        if ((dls001_part_0[216] - tout) * dls001_part_0[211]) < 0.0 {
          pc2 = 28
          continue tb1~
        }
        let mv16 = dintdy(tout, 0, rwork, dls001_part_1[19] - 1, dls001_part_1[5], y, iflag)
        iflag = mv16
        t_ = tout
        pc2 = 31
        continue tb1~
      }
      28 => {
        hmx = (d_abs(dls001_part_0[216])) + (d_abs(dls001_part_0[211]))
        ihit = (d_abs((dls001_part_0[216] - tcrit))) <= ((100.0 * dls001_part_0[217]) * hmx)
        if ihit {
          pc2 = 30
          continue tb1~
        }
        tnext = dls001_part_0[216] + (dls001_part_0[211] * (1.0 + (4.0 * dls001_part_0[217])))
        if ((tnext - tcrit) * dls001_part_0[211]) <= 0.0 {
          pc2 = 20
          continue tb1~
        }
        dls001_part_0[211] = (tcrit - dls001_part_0[216]) * (1.0 - (4.0 * dls001_part_0[217]))
        dls001_part_1[16] = -2
        pc2 = 20
        continue tb1~
      }
      29 => {
        hmx = (d_abs(dls001_part_0[216])) + (d_abs(dls001_part_0[211]))
        ihit = (d_abs((dls001_part_0[216] - tcrit))) <= ((100.0 * dls001_part_0[217]) * hmx)
        pc2 = 30
        continue tb1~
      }
      30 => {
        let mut cnt17 = i_max(0, (dls001_part_1[31] - 1 + 1) / 1)
        i = 1
        while cnt17 > 0 {
          y[i - 1] = rwork[((i + dls001_part_1[19]) - 1) - 1]
          i = i + 1
          cnt17 = cnt17 - 1
        }
        t_ = dls001_part_0[216]
        if (itask != 4) && (itask != 5) {
          pc2 = 31
          continue tb1~
        }
        if ihit {
          t_ = tcrit
        }
        pc2 = 31
        continue tb1~
      }
      31 => {
        istate = 2
        rwork[11 - 1] = dls001_part_0[214]
        rwork[12 - 1] = dls001_part_0[211]
        rwork[13 - 1] = dls001_part_0[216]
        iwork[11 - 1] = dls001_part_1[33]
        iwork[12 - 1] = dls001_part_1[34]
        iwork[13 - 1] = dls001_part_1[35]
        iwork[14 - 1] = dls001_part_1[36]
        iwork[15 - 1] = dls001_part_1[32]
        return (t_, istate)
      }
      32 => {
        msg = f2cl_string("DLSODE-  At current T (=R1), MXSTEP (=I1) steps   ", 80)
        xerrwd(msg, 50, 201, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      taken on this call before reaching TOUT     ", 80)
        xerrwd(msg, 50, 201, 0, 1, dls001_part_1[1], 0, 1, dls001_part_0[216], 0.0)
        istate = -1
        pc2 = 38
        continue tb1~
      }
      33 => {
        ewti = rwork[((dls001_part_1[20] + i) - 1) - 1]
        msg = f2cl_string("DLSODE-  At T (=R1), EWT(I1) has become R2  <=  0.", 80)
        xerrwd(msg, 50, 202, 0, 1, i, 0, 2, dls001_part_0[216], ewti)
        istate = -6
        pc2 = 38
        continue tb1~
      }
      34 => {
        msg = f2cl_string("DLSODE-  At T (=R1), too much accuracy requested  ", 80)
        xerrwd(msg, 50, 203, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      for precision of machine..  see TOLSF (=R2) ", 80)
        xerrwd(msg, 50, 203, 0, 0, 0, 0, 2, dls001_part_0[216], tolsf)
        rwork[14 - 1] = tolsf
        istate = -2
        pc2 = 38
        continue tb1~
      }
      35 => {
        msg = f2cl_string("DLSODE-  At T(=R1) and step size H(=R2), the error", 80)
        xerrwd(msg, 50, 204, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      test failed repeatedly or with ABS(H) = HMIN", 80)
        xerrwd(msg, 50, 204, 0, 0, 0, 0, 2, dls001_part_0[216], dls001_part_0[211])
        istate = -4
        pc2 = 37
        continue tb1~
      }
      36 => {
        msg = f2cl_string("DLSODE-  At T (=R1) and step size H (=R2), the    ", 80)
        xerrwd(msg, 50, 205, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      corrector convergence failed repeatedly     ", 80)
        xerrwd(msg, 50, 205, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      or with ABS(H) = HMIN   ", 80)
        xerrwd(msg, 30, 205, 0, 0, 0, 0, 2, dls001_part_0[216], dls001_part_0[211])
        istate = -5
        pc2 = 37
        continue tb1~
      }
      37 => {
        big = 0.0
        imxer = 1
        let mut cnt18 = i_max(0, (dls001_part_1[31] - 1 + 1) / 1)
        i = 1
        while cnt18 > 0 {
          tb19~: while true {
            size = d_abs(((rwork[((i + dls001_part_1[21]) - 1) - 1]) * (rwork[((i + dls001_part_1[20]) - 1) - 1])))
            if big >= size {
              break tb19~
            }
            big = size
            imxer = i
            break tb19~
          }
          i = i + 1
          cnt18 = cnt18 - 1
        }
        iwork[16 - 1] = imxer
        pc2 = 38
        continue tb1~
      }
      38 => {
        let mut cnt20 = i_max(0, (dls001_part_1[31] - 1 + 1) / 1)
        i = 1
        while cnt20 > 0 {
          y[i - 1] = rwork[((i + dls001_part_1[19]) - 1) - 1]
          i = i + 1
          cnt20 = cnt20 - 1
        }
        t_ = dls001_part_0[216]
        rwork[11 - 1] = dls001_part_0[214]
        rwork[12 - 1] = dls001_part_0[211]
        rwork[13 - 1] = dls001_part_0[216]
        iwork[11 - 1] = dls001_part_1[33]
        iwork[12 - 1] = dls001_part_1[34]
        iwork[13 - 1] = dls001_part_1[35]
        iwork[14 - 1] = dls001_part_1[36]
        iwork[15 - 1] = dls001_part_1[32]
        return (t_, istate)
      }
      39 => {
        msg = f2cl_string("DLSODE-  ISTATE (=I1) illegal ", 80)
        xerrwd(msg, 30, 1, 0, 1, istate, 0, 0, 0.0, 0.0)
        if istate < 0 {
          pc2 = 67
          continue tb1~
        }
        pc2 = 66
        continue tb1~
      }
      40 => {
        msg = f2cl_string("DLSODE-  ITASK (=I1) illegal  ", 80)
        xerrwd(msg, 30, 2, 0, 1, itask, 0, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      41 => {
        msg = f2cl_string("DLSODE-  ISTATE  >  1 but DLSODE not initialized ", 80)
        xerrwd(msg, 50, 3, 0, 0, 0, 0, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      42 => {
        msg = f2cl_string("DLSODE-  NEQ (=I1)  <  1     ", 80)
        xerrwd(msg, 30, 4, 0, 1, neq[1 - 1], 0, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      43 => {
        msg = f2cl_string("DLSODE-  ISTATE = 3 and NEQ increased (I1 to I2)  ", 80)
        xerrwd(msg, 50, 5, 0, 2, dls001_part_1[31], neq[1 - 1], 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      44 => {
        msg = f2cl_string("DLSODE-  ITOL (=I1) illegal   ", 80)
        xerrwd(msg, 30, 6, 0, 1, itol, 0, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      45 => {
        msg = f2cl_string("DLSODE-  IOPT (=I1) illegal   ", 80)
        xerrwd(msg, 30, 7, 0, 1, iopt, 0, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      46 => {
        msg = f2cl_string("DLSODE-  MF (=I1) illegal     ", 80)
        xerrwd(msg, 30, 8, 0, 1, mf, 0, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      47 => {
        msg = f2cl_string("DLSODE-  ML (=I1) illegal..  < 0 or  >= NEQ (=I2)", 80)
        xerrwd(msg, 50, 9, 0, 2, ml, neq[1 - 1], 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      48 => {
        msg = f2cl_string("DLSODE-  MU (=I1) illegal..  < 0 or  >= NEQ (=I2)", 80)
        xerrwd(msg, 50, 10, 0, 2, mu, neq[1 - 1], 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      49 => {
        msg = f2cl_string("DLSODE-  MAXORD (=I1)  <  0  ", 80)
        xerrwd(msg, 30, 11, 0, 1, dls001_part_1[27], 0, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      50 => {
        msg = f2cl_string("DLSODE-  MXSTEP (=I1)  <  0  ", 80)
        xerrwd(msg, 30, 12, 0, 1, dls001_part_1[1], 0, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      51 => {
        msg = f2cl_string("DLSODE-  MXHNIL (=I1)  <  0  ", 80)
        xerrwd(msg, 30, 13, 0, 1, dls001_part_1[2], 0, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      52 => {
        msg = f2cl_string("DLSODE-  TOUT (=R1) behind T (=R2)      ", 80)
        xerrwd(msg, 40, 14, 0, 0, 0, 0, 2, tout, t_)
        msg = f2cl_string("      Integration direction is given by H0 (=R1)  ", 80)
        xerrwd(msg, 50, 14, 0, 0, 0, 0, 1, h0, 0.0)
        pc2 = 66
        continue tb1~
      }
      53 => {
        msg = f2cl_string("DLSODE-  HMAX (=R1)  <  0.0  ", 80)
        xerrwd(msg, 30, 15, 0, 0, 0, 0, 1, hmax, 0.0)
        pc2 = 66
        continue tb1~
      }
      54 => {
        msg = f2cl_string("DLSODE-  HMIN (=R1)  <  0.0  ", 80)
        xerrwd(msg, 30, 16, 0, 0, 0, 0, 1, dls001_part_0[212], 0.0)
        pc2 = 66
        continue tb1~
      }
      55 => {
        msg = f2cl_string("DLSODE-  RWORK length needed, LENRW (=I1), exceeds LRW (=I2)", 80)
        xerrwd(msg, 60, 17, 0, 2, lenrw, lrw, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      56 => {
        msg = f2cl_string("DLSODE-  IWORK length needed, LENIW (=I1), exceeds LIW (=I2)", 80)
        xerrwd(msg, 60, 18, 0, 2, leniw, liw, 0, 0.0, 0.0)
        pc2 = 66
        continue tb1~
      }
      57 => {
        msg = f2cl_string("DLSODE-  RTOL(I1) is R1  <  0.0        ", 80)
        xerrwd(msg, 40, 19, 0, 1, i, 0, 1, rtoli, 0.0)
        pc2 = 66
        continue tb1~
      }
      58 => {
        msg = f2cl_string("DLSODE-  ATOL(I1) is R1  <  0.0        ", 80)
        xerrwd(msg, 40, 20, 0, 1, i, 0, 1, atoli, 0.0)
        pc2 = 66
        continue tb1~
      }
      59 => {
        ewti = rwork[((dls001_part_1[20] + i) - 1) - 1]
        msg = f2cl_string("DLSODE-  EWT(I1) is R1  <=  0.0         ", 80)
        xerrwd(msg, 40, 21, 0, 1, i, 0, 1, ewti, 0.0)
        pc2 = 66
        continue tb1~
      }
      60 => {
        msg = f2cl_string("DLSODE-  TOUT (=R1) too close to T(=R2) to start integration", 80)
        xerrwd(msg, 60, 22, 0, 0, 0, 0, 2, tout, t_)
        pc2 = 66
        continue tb1~
      }
      61 => {
        msg = f2cl_string("DLSODE-  ITASK = I1 and TOUT (=R1) behind TCUR - HU (= R2)  ", 80)
        xerrwd(msg, 60, 23, 0, 1, itask, 0, 2, tout, tp)
        pc2 = 66
        continue tb1~
      }
      62 => {
        msg = f2cl_string("DLSODE-  ITASK = 4 OR 5 and TCRIT (=R1) behind TCUR (=R2)   ", 80)
        xerrwd(msg, 60, 24, 0, 0, 0, 0, 2, tcrit, dls001_part_0[216])
        pc2 = 66
        continue tb1~
      }
      63 => {
        msg = f2cl_string("DLSODE-  ITASK = 4 or 5 and TCRIT (=R1) behind TOUT (=R2)   ", 80)
        xerrwd(msg, 60, 25, 0, 0, 0, 0, 2, tcrit, tout)
        pc2 = 66
        continue tb1~
      }
      64 => {
        msg = f2cl_string("DLSODE-  At start of problem, too much accuracy   ", 80)
        xerrwd(msg, 50, 26, 0, 0, 0, 0, 0, 0.0, 0.0)
        msg = f2cl_string("      requested for precision of machine..  See TOLSF (=R1) ", 80)
        xerrwd(msg, 60, 26, 0, 0, 0, 0, 1, tolsf, 0.0)
        rwork[14 - 1] = tolsf
        pc2 = 66
        continue tb1~
      }
      65 => {
        msg = f2cl_string("DLSODE-  Trouble in DINTDY.  ITASK = I1, TOUT = R1", 80)
        xerrwd(msg, 50, 27, 0, 1, itask, 0, 1, tout, 0.0)
        pc2 = 66
        continue tb1~
      }
      66 => {
        istate = -3
        return (t_, istate)
      }
      67 => {
        msg = f2cl_string("DLSODE-  Run aborted.. apparent infinite loop     ", 80)
        xerrwd(msg, 50, 303, 2, 0, 0, 0, 0, 0.0, 0.0)
        return (t_, istate)
      }
      68 => {
        return (t_, istate)
      }
      _ => panic()
    }
  }
  panic()
}
